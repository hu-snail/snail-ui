{
  "name": "@snui/docs",
  "version": "0.1.0",
  "private": true,
  "description": "snail-aui documentation site (VitePress). Multi-end: web / uni-app + Style Switcher.",
  "type": "module",
  "scripts": {
    "dev": "vitepress dev . --port 4317",
    "build": "vitepress build .",
    "preview": "vitepress preview . --port 4318",
    "lint": "echo 'docs lint: noop (markdown)'",
    "typecheck": "echo 'docs typecheck: noop (markdown)'",
    "test": "echo 'docs test: noop'",
    "clean": "rm -rf .vitepress/cache .vitepress/dist docs"
  },
  "dependencies": {
    "@snui/ai": "workspace:",
    "@snui/style-packs": "workspace:",
    "@snui/tokens": "workspace:",
    "@snui/uni": "workspace:",
    "@snui/vue-web": "workspace:",
    "shiki": "2.5.0"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "vitepress": "^1.5.0",
    "vue": "^3.5.43"
  }
}