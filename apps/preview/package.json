{
  "name": "@snui/preview",
  "version": "0.1.0",
  "private": true,
  "description": "AUI Preview — local demo app that imports real @snui/vue-web components. Validates that the component library builds and renders end-to-end.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
