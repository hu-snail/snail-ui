<script setup lang="ts">
/**
 * Demo: sn-waterfall (uni-end) — 双列图片墙，最短列优先放置。
 * Per AUI-DOCS-016: imports the real @snui/uni components from their SFC
 * source. Photos are fixed-ratio seeds so the pack is reproducible.
 */
import SnWaterfall from '@snui/uni-x/components/sn-waterfall/sn-waterfall.uvue';
import SnImg from '@snui/uni-x/components/sn-img/sn-img.uvue';
interface Photo {
  id: string;
  title: string;
  /** Natural size — lets the wall reserve the aspect ratio before the bytes land. */
  width: number;
  height: number;
}

const photos: Photo[] = [
  { id: 'a', title: '山径', width: 400, height: 600 },
  { id: 'b', title: '海平线', width: 400, height: 300 },
  { id: 'c', title: '旧书店', width: 400, height: 520 },
  { id: 'd', title: '清晨市集', width: 400, height: 400 },
  { id: 'e', title: '雨后', width: 400, height: 640 },
  { id: 'f', title: '长街', width: 400, height: 260 },
];
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <SnWaterfall :columns="2" :column-gap="16" :row-gap="16">
      <view v-for="photo in photos" :key="photo.id" class="wall-card">
        <SnImg
          :src="`https://picsum.photos/seed/snui-waterfall-${photo.id}/${photo.width}/${photo.height}`"
          mode="widthFix"
          width="100%"
        />
        <text class="wall-card__title">{{ photo.title }}</text>
      </view>
    </SnWaterfall>
    <text class="sn-demo__caption">双列瀑布流 — 高项不再把邻居推下去，列内顺序与插槽顺序一致</text>
  </view>
</template>
