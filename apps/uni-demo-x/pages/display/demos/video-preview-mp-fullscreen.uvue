<script setup lang="ts">
/**
 * Demo: sn-video-preview (uni-end) — 全屏模式（fullScreen）。
 * Per AUI-DOCS-016: imports the real @snui/uni sn-video-preview from its SFC source.
 */
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
import SnVideoPreview from '@snui/uni-x/components/sn-video-preview/sn-video-preview.uvue';
const preview = ref<{
  open: (options: { src: string; title?: string; autoplay?: boolean }) => void;
} | null>(null);

const clip = {
  src: 'https://www.w3schools.com/html/mov_bbb.mp4',
  title: '全屏播放',
  autoplay: true,
};

const calls = ref(0);
</script>
<template>
  <view class="sn-demo sn-demo--column">
    <SnButton size="small" @click="preview?.open(clip)"><text>全屏播放</text></SnButton>
    <text class="sn-demo__meta">on-open 回调触发次数：{{ calls }}</text>

    <SnVideoPreview
      ref="preview"
      full-screen
      custom-class="sn-demo-contained"
      :on-open="() => (calls += 1)"
    />
  </view>
</template>
<style scoped>
.sn-demo--column {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100%;
  align-items: flex-start;
}
.sn-demo__meta {
  color: var(--sn-mp-color-text-tertiary);
  font-size: 24rpx;
}
/* Docs-preview only: the layer root is `position: fixed`, which would cover the
 * whole docs page instead of the phone screen. Not needed in a real app. */
.sn-video-preview.sn-demo-contained {
  position: absolute;
}
</style>