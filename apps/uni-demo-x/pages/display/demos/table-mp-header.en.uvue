  { name: 'Snail B', amount: 256, status: 'Pending' },
  { name: 'Snail C', amount: 64, status: 'Paid' },
];
</script>
<template>
  <view class="sn-demo sn-demo--column">
    <SnTable :data="rows" :show-header="false">
