<script setup lang="ts">
/**
 * Demo: sn-video-preview (uni-end) — 实例标识（selector）+ on-open / on-close 回调。
 * Per AUI-DOCS-016: imports the real @snui/uni sn-video-preview from its SFC source.
 */
const preview = ref<{
  open: (options: { src: string; poster?: string; title?: string }) => void;
  close: () => void;
} | null>(null);

const clip = {
  src: 'https://www.w3schools.com/html/mov_bbb.mp4',
  poster: 'https://picsum.photos/seed/snui-video-cfg/750/420',
  title: '实例标识 selector',
};

const opened = ref(0);
const closed = ref(0);
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <SnButton size="small" type="primary" @click="preview?.open(clip)"><text>打开</text></SnButton>
    <SnButton size="small" @click="preview?.close()"><text>关闭</text></SnButton>
    <text class="sn-demo__meta">on-open 触发 {{ opened }} 次；on-close 触发 {{ closed }} 次</text>

    <SnVideoPreview
      ref="preview"
      selector="sn-video-preview-demo"
      custom-class="sn-demo-contained"
      :on-open="() => (opened += 1)"
      :on-close="() => (closed += 1)"
    />

    <text class="sn-demo__meta">
      selector 会渲染成 data-selector（实例标识，对齐参考 API）；on-open / on-close 是 prop
      形式的回调，组件只调用一次，不会与同名事件重复触发。
    </text>
  </view>
</template>
<style scoped>
.sn-demo--stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100%;
  align-items: flex-start;
}
.sn-demo__meta {
  color: var(--sn-mp-color-text-tertiary);
  font-size: 24rpx;
  line-height: var(--sn-mp-font-line-height-normal);
}
/* Docs-preview only: the layer root is `position: fixed`, which would cover the
 * whole docs page instead of the phone screen. Not needed in a real app. */
.sn-video-preview.sn-demo-contained {
  position: absolute;
}
</style>