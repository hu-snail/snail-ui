<script setup lang="ts">
/**
 * Demo: sn-image-preview (uni-end) — page counter & footer slot (`showIndex` / `#default`).
 * Per AUI-DOCS-016: imports the real @snui/uni sn-image-preview from its SFC source.
 */
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
import SnImagePreview from '@snui/uni-x/components/sn-image-preview/sn-image-preview.uvue';
const preview = ref<{
  open: (options?: { images?: string[]; startPosition?: number }) => void;
  close: () => void;
  setActive: (index: number) => void;
} | null>(null);

const images = [
  'https://picsum.photos/seed/snui-cap-a/900/1200',
  'https://picsum.photos/seed/snui-cap-b/900/1200',
];
</script>
<template>
  <view class="sn-demo sn-demo--column">
    <SnButton size="small" @click="preview?.open()"
      ><text>Open (counter hidden / custom footer text)</text></SnButton
    >

    <SnImagePreview
      ref="preview"
      :images="images"
      :show-index="false"
      custom-class="sn-demo-contained"
    >
      <template #default="{ current }">
        <text class="sn-demo__caption">Image {{ current + 1 }} of {{ images.length }}</text>
      </template>
    </SnImagePreview>

    <text class="sn-demo__meta">
      showIndex=false hides the built-in counter; the #default slot receives `current` and renders
      custom copy at the bottom.
    </text>
  </view>
</template>
<style scoped>
.sn-demo--column {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100%;
  align-items: flex-start;
}
.sn-demo__caption {
  color: var(--sn-mp-color-text-on-primary);
  font-size: 24rpx;
}
.sn-demo__meta {
  color: var(--sn-mp-color-text-tertiary);
  font-size: 24rpx;
  line-height: var(--sn-mp-font-line-height-normal);
}
</style>