<script setup lang="ts">
/** Demo: sn-rich-text (uni-end) — 空状态插槽。 */
const emptyContent = ref('<p><strong>周末来信</strong></p>');

function clearContent(): void {
  emptyContent.value = '';
}
</script>
<template>
  <view class="sn-demo">
    <view class="sn-demo__actions">
      <view class="sn-demo__button" @click="clearContent">
