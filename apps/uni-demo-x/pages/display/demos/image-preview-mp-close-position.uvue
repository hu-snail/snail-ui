<script setup lang="ts">
/**
 * Demo: sn-image-preview (uni-end) — 关闭按钮位置（closeIconPosition）。
 * Per AUI-DOCS-016: imports the real @snui/uni sn-image-preview from its SFC source.
 */
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
import SnImagePreview from '@snui/uni-x/components/sn-image-preview/sn-image-preview.uvue';
const preview = ref<{
  open: (options?: { images?: string[]; startPosition?: number }) => void;
  close: () => void;
  setActive: (index: number) => void;
} | null>(null);

const images = ['/demo/snui-photo-2.jpg', '/demo/snui-photo-3.jpg'];
</script>
<template>
  <view class="sn-demo sn-demo--column">
    <SnButton size="small" @click="preview?.open()"><text>打开（关闭按钮在左上）</text></SnButton>

    <SnImagePreview
      ref="preview"
      :images="images"
      close-icon-position="top-left"
      custom-class="sn-demo-contained"
    />

    <text class="sn-demo__meta">closeIconPosition 默认 top-right，这里切到 top-left。</text>
  </view>
</template>
