<script setup lang="ts">
/**
 * Demo: sn-image-preview (uni-end) — 缩略图点击预览 + 指令式 API。
 * Per AUI-DOCS-016: imports the real @snui/uni sn-image-preview from its SFC source.
 */
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
import SnImagePreview from '@snui/uni-x/components/sn-image-preview/sn-image-preview.uvue';
import SnImg from '@snui/uni-x/components/sn-img/sn-img.uvue';
const preview = ref<{
  open: (options?: { images?: string[]; startPosition?: number }) => void;
  close: () => void;
  setActive: (index: number) => void;
} | null>(null);

const images = ['/demo/snui-photo-1.jpg', '/demo/snui-photo-2.jpg', '/demo/snui-photo-3.jpg'];

const lastEvent = ref('—');

function openAt(index: number) {
  preview.value?.open({ startPosition: index });
}
</script>
<template>
  <view class="sn-demo sn-demo--column">
    <view class="sn-demo__thumbs">
      <view
        v-for="(image, index) in images"
        :key="image"
        class="sn-demo__thumb"
        @click="openAt(index)"
      >
        <SnImg :src="image" :width="150" :height="150" mode="aspectFill" radius="8" />
      </view>
    </view>

    <SnButton size="small" @click="preview?.open()"><text>从第一张打开</text></SnButton>
    <text class="sn-demo__meta">最近事件：{{ lastEvent }}</text>

    <SnImagePreview
      ref="preview"
      :images="images"
      show-index
      custom-class="sn-demo-contained"
      @open="lastEvent = 'open'"
      @close="lastEvent = 'close'"
      @change="(payload: { index: number }) => (lastEvent = 'change → ' + payload.index)"
    />
  </view>
</template>
<style scoped>
.sn-demo--column {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100%;
  align-items: flex-start;
}
.sn-demo__thumbs {
  display: flex;
  gap: 12rpx;
  flex-direction: row;
}
.sn-demo__thumb {
  overflow: hidden;
  border-radius: 8rpx;
}
.sn-demo__meta {
  color: var(--sn-mp-color-text-tertiary);
  font-size: 24rpx;
}
/* Docs-preview only: the viewer root is `position: fixed`, which would cover the
 * whole docs page instead of the phone screen. Not needed in a real app. */
.sn-image-preview.sn-demo-contained {
  position: absolute;
}
</style>