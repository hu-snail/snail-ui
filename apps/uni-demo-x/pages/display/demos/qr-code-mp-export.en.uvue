<script setup lang="ts">
/**
 * Demo: sn-qr-code (uni-end) — size / margin / export.
 * Per AUI-DOCS-016: imports the real @snui/uni sn-qr-code from its SFC source.
 */
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
import SnQrCode from '@snui/uni-x/components/sn-qr-code/sn-qr-code.uvue';
const qrRef = ref<{ exportImage: () => Promise<string> } | null>(null);
const exported = ref('—');

async function onExport() {
  if (qrRef.value === null) return;
  try {
    const result = await qrRef.value.exportImage();
    // uni-app x resolves with a full PNG data URL — keep the demo label short.
    exported.value = result.startsWith('data:image/')
      ? `${result.slice(0, 22)}… (${result.length} chars, usable as <image :src>)`
      : result;
  } catch (error) {
    const code = (error as { code?: string }).code ?? 'EXPORT_FAILED';
    exported.value = `export unavailable (${code})`;
  }
}
</script>
<template>
  <view class="sn-demo sn-demo--column">
    <SnQrCode ref="qrRef" text="https://snui.dev/export" :size="200" :margin="12" />
    <SnButton size="small" @click="onExport"><text>Export image</text></SnButton>
    <text class="sn-demo__meta">exportImage resolves with a temp file path or data URL: {{ exported }}</text>
  </view>
</template>
<style scoped>
.sn-demo--column {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100%;
  align-items: flex-start;
}
.sn-demo__meta {
  color: var(--sn-mp-color-text-tertiary);
  font-size: 24rpx;
  word-break: break-all;
}
</style>