<script setup lang="ts">
/**
 * Demo: sn-swiper (uni-end) — data field mapping (`valueKey` / `textKey`) + controlled current + events.
 * Per AUI-DOCS-016: imports the real @snui/uni sn-swiper from its SFC source.
 */
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
import SnSwiper from '@snui/uni-x/components/sn-swiper/sn-swiper.uvue';
/** Custom field names: the URL lives in `url`, the caption in `title`. */
const list = [
  { url: 'https://picsum.photos/seed/snui-sw-d1/750/400', title: 'Custom fields 1' },
  { url: 'https://picsum.photos/seed/snui-sw-d2/750/400', title: 'Custom fields 2' },
  { url: 'https://picsum.photos/seed/snui-sw-d3/750/400', title: 'Custom fields 3' },
];

const current = ref(0);
const lastEvent = ref('—');

function onJump(index: number) {
  current.value = index;
}
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <SnSwiper
      :list="list"
      :height="260"
      value-key="url"
      text-key="title"
      v-model:current="current"
      :autoplay="false"
      @change="(payload: { current: number }) => (lastEvent = `change → ${payload.current}`)"
      @animationfinish="
        (payload: { current: number }) => (lastEvent = `animationfinish → ${payload.current}`)
      "
      @click="(payload: { index: number }) => (lastEvent = `click → ${payload.index}`)"
    />

    <view class="sn-demo__row">
      <SnButton size="small" @click="onJump(0)"><text>Slide 1</text></SnButton>
      <SnButton size="small" @click="onJump(1)"><text>Slide 2</text></SnButton>
      <SnButton size="small" @click="onJump(2)"><text>Slide 3</text></SnButton>
    </view>
    <text class="sn-demo__meta"
      >current (v-model:current) = {{ current }}; latest event: {{ lastEvent }}</text
    >
    <text class="sn-demo__meta">
      valueKey / textKey rename the fields (defaults are value / text); the jump buttons write
      current directly to verify the controlled binding.
    </text>
  </view>
</template>
<style scoped>
.sn-demo--stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.sn-demo__row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  flex-direction: row;
}
.sn-demo__meta {
  color: var(--sn-mp-color-text-tertiary);
  font-size: 24rpx;
  line-height: var(--sn-mp-font-line-height-normal);
}
</style>