<script setup lang="ts">
/**
 * Demo: sn-table (uni-end) — 单元格省略（ellipsis）。
 * Per AUI-DOCS-016: imports the real @snui/uni sn-table from its SFC source.
 */
import SnTableColumn from '@snui/uni-x/components/sn-table/sn-table-column.uvue';
interface Row {
  name: string;
  note: string;
  status: string;
}

const rows: Row[] = [
  { name: '蜗牛 A', note: '这是一段很长的备注，用来演示两行省略的效果。', status: '正常' },
  { name: '蜗牛 B', note: '短备注', status: '异常' },
];
</script>
<template>
  <view class="sn-demo sn-demo--column">
    <SnTable :data="rows" ellipsis>
      <SnTableColumn prop="name" label="名称" :width="140" />
      <SnTableColumn prop="note" label="备注" :width="260" />
      <SnTableColumn prop="status" label="状态" :width="120" align="center" />
    </SnTable>
    <text class="sn-demo__meta">`ellipsis` 让长文本两行内截断并显示省略号。</text>
  </view>
</template>
<style scoped>
.sn-demo--column {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100%;
}
.sn-demo__meta {
  color: var(--sn-mp-color-text-tertiary);
  font-size: 24rpx;
}
</style>