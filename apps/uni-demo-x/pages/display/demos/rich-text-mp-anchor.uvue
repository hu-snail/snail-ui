<script setup lang="ts">
/** Demo: sn-rich-text (uni-end) — 锚点目录（enableAnchor + getHeadings / scrollToAnchor）。 */
import SnRichText from '@snui/uni-x/components/sn-rich-text/sn-rich-text.uvue';
import type {
  RichTextHeading,
  RichTextInstance,
} from '@snui/uni-x/components/sn-rich-text/sn-rich-text-types';

const outline = `
  <h2 id="intro">出发之前</h2>
  <p>带上饮水和轻食。</p>
  <h2 id="walk">沿湖慢走</h2>
  <p>让脚步慢下来。</p>
`;

const richText = ref<RichTextInstance>();
const headings = ref<RichTextHeading[]>([]);

function onLoad(): void {
  headings.value = richText.value?.getHeadings() ?? [];
}

async function jump(id: string): Promise<void> {
  try {
    await richText.value?.scrollToAnchor(id, { offset: 16, duration: 300 });
  } catch {
    uni.showToast({ title: '章节暂时无法定位', icon: 'none' });
  }
}
</script>
<template>
  <view class="sn-demo">
    <view class="sn-demo__actions">
      <view v-for="item in headings" :key="item.id" class="sn-demo__button" @click="jump(item.id)">
        <text class="sn-demo__button-text">{{ item.text }}</text>
      </view>
    </view>
    <SnRichText ref="richText" :content="outline" enable-anchor @load="onLoad" />
  </view>
</template>
<style scoped>
.sn-demo {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.sn-demo__actions {
  display: flex;
  flex-direction: row;
  gap: 8px;
}

.sn-demo__button {
  padding: 8px 12px;
  border-radius: 6px;
  background-color: var(--sn-mp-color-action-primary);
}

.sn-demo__button-text {
  color: var(--sn-mp-color-text-on-primary);
  font-size: 12px;
}
</style>