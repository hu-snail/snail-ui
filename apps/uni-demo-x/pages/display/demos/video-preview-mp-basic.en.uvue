<script setup lang="ts">
/**
 * Demo: sn-video-preview (uni-end) — open the video preview layer.
 * Per AUI-DOCS-016: imports the real @snui/uni sn-video-preview from its SFC source.
 */
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
import SnVideoPreview from '@snui/uni-x/components/sn-video-preview/sn-video-preview.uvue';
const preview = ref<{
  open: (options: { src: string; poster?: string; title?: string }) => void;
} | null>(null);

const clip = {
  src: 'https://www.w3schools.com/html/mov_bbb.mp4',
  poster: 'https://picsum.photos/seed/snui-video/750/420',
  title: 'Product overview',
};

const lastEvent = ref('—');
</script>
<template>
  <view class="sn-demo sn-demo--column">
    <SnButton size="small" type="primary" @click="preview?.open(clip)"><text>Play video</text></SnButton>
    <text class="sn-demo__meta">Last event: {{ lastEvent }}</text>

    <SnVideoPreview
      ref="preview"
      custom-class="sn-demo-contained"
      @open="lastEvent = 'open'"
      @close="lastEvent = 'close'"
    />
  </view>
</template>
<style scoped>
.sn-demo--column {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100%;
  align-items: flex-start;
}
.sn-demo__meta {
  color: var(--sn-mp-color-text-tertiary);
  font-size: 24rpx;
}
/* Docs-preview only: the layer root is `position: fixed`, which would cover the
 * whole docs page instead of the phone screen. Not needed in a real app. */
.sn-video-preview.sn-demo-contained {
  position: absolute;
}
</style>