<script setup lang="ts">
/**
 * Demo: sn-count-down (uni-end) — 控制方法（start / pause / reset）。
 * Per AUI-DOCS-016: imports the real @snui/uni sn-count-down from its SFC source.
 */
const ref1 = ref<InstanceType<typeof SnCountDown> | null>(null);
const finished = ref(0);
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <SnCountDown ref="ref1" :time="600000" format="mm:ss" @finish="finished += 1" />

    <view class="sn-count-down-demo__row">
      <SnButton size="small" @click="ref1?.start()"><text>开始 / 继续</text></SnButton>
      <SnButton size="small" @click="ref1?.pause()"><text>暂停</text></SnButton>
      <SnButton size="small" @click="ref1?.reset()"><text>重置</text></SnButton>
    </view>

    <text class="sn-count-down-demo__meta">已完成 {{ finished }} 次</text>
  </view>
</template>
<style scoped>
.sn-demo--stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.sn-count-down-demo__row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.sn-count-down-demo__meta {
  font-size: 24rpx;
  color: var(--vp-c-text-2);
