<script setup lang="ts">
/**
 * Demo: sn-img (uni-end) — loading / error / custom slots.
 * Per AUI-DOCS-016: imports the real @snui/uni sn-img from its SFC source.
 */
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
import SnImg from '@snui/uni-x/components/sn-img/sn-img.uvue';
const okSrc = 'https://picsum.photos/seed/snui-img-b/400/300';
const brokenSrc = 'https://invalid.example/not-found.png';
const src = ref(okSrc);
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <SnImg :src="src" mode="aspectFill" width="100%" height="200rpx" />

    <view class="sn-img-demo__row">
      <SnButton size="small" @click="src = okSrc"><text>Valid URL</text></SnButton>
      <SnButton size="small" @click="src = brokenSrc"><text>Broken URL</text></SnButton>
    </view>

    <SnImg :src="brokenSrc" width="160rpx" height="160rpx">
      <template #error>
        <text class="sn-img-demo__error">Failed to load, please retry</text>
      </template>
    </SnImg>

    <SnImg :src="okSrc" width="160rpx" height="160rpx" :show-loading="false" :show-error="false" />
  </view>
</template>
<style scoped>
.sn-demo--stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.sn-img-demo__row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.sn-img-demo__error {
  font-size: 22rpx;
  color: var(--sn-mp-color-feedback-danger);
}
</style>