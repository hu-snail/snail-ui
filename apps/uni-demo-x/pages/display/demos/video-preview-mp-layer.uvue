<script setup lang="ts">
/**
 * Demo: sn-video-preview (uni-end) — 层级与样式（zIndex / customStyle）。
 * Per AUI-DOCS-016: imports the real @snui/uni sn-video-preview from its SFC source.
 */
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
import SnVideoPreview from '@snui/uni-x/components/sn-video-preview/sn-video-preview.uvue';
const preview = ref<{
  open: (options: { src: string; poster?: string; title?: string }) => void;
  close: () => void;
} | null>(null);

const clip = {
  src: 'https://www.w3schools.com/html/mov_bbb.mp4',
  poster: 'https://cdn.uviewui.com/uview/album/9.jpg',
  title: '自定义层级与样式',
};
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <SnButton size="small" type="primary" @click="preview?.open(clip)"><text>打开（z-index 1500）</text></SnButton>
    <SnButton size="small" @click="preview?.close()"><text>关闭</text></SnButton>

    <SnVideoPreview
      ref="preview"
      :z-index="1500"
      custom-class="sn-demo-contained"
      custom-style="border-radius: 16rpx"
    />

    <text class="sn-demo__meta">
      z-index 透传给内部 sn-popup；customStyle 追加到层根节点的 inline style（这里给层加了圆角）。
    </text>
  </view>
</template>
