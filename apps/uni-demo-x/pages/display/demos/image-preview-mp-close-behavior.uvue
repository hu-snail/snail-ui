<script setup lang="ts">
/**
 * Demo: sn-image-preview (uni-end) — 关闭与循环行为（loop / closeable / close-on-click）。
 * Per AUI-DOCS-016: imports the real @snui/uni sn-image-preview from its SFC source.
 */
const preview = ref<{
  open: (options?: { images?: string[]; startPosition?: number }) => void;
  close: () => void;
  setActive: (index: number) => void;
} | null>(null);

const images = ['/demo/snui-photo-2.jpg', '/demo/snui-photo-3.jpg'];
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <SnButton size="small" @click="preview?.open()"
      ><text>打开（不循环 / 无关闭按钮 / 点遮罩不关）</text></SnButton
    >

    <SnImagePreview
      ref="preview"
      :images="images"
      :loop="false"
      :closeable="false"
      :close-on-click="false"
      custom-class="sn-demo-contained"
    >
      <template #default>
        <view class="sn-demo__footer">
          <SnButton size="small" @click="preview?.close()"><text>关闭</text></SnButton>
        </view>
      </template>
    </SnImagePreview>

    <text class="sn-demo__meta">
      loop=false 到最后一张不再循环；closeable=false 不渲染关闭按钮；close-on-click=false
      点遮罩不关闭 —— 只能靠底部关闭按钮或下滑手势退出。
    </text>
  </view>
</template>
<style scoped>
.sn-demo--stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100%;
  align-items: flex-start;
}
