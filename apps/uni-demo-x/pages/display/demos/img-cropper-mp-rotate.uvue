<script setup lang="ts">
/**
 * Demo: sn-img-cropper (uni-end) — 禁止旋转与按钮文案（disabledRotate / cancelButtonText / confirmButtonText）。
 * Per AUI-DOCS-016: imports the real @snui/uni sn-img-cropper from its SFC source.
 */
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
import SnImgCropper from '@snui/uni-x/components/sn-img-cropper/sn-img-cropper.uvue';
const visible = ref(false);
const result = ref('—');

const imgSrc = '/demo/snui-crop-wide.jpg';
</script>
<template>
  <view class="sn-demo sn-demo--column">
    <SnButton size="small" @click="visible = true"><text>打开裁剪（禁旋转 + 自定义按钮）</text></SnButton>
    <text class="sn-demo__meta">结果：{{ result }}</text>

    <SnImgCropper
      v-model="visible"
      :img-src="imgSrc"
      disabled-rotate
      cancel-button-text="放弃"
      confirm-button-text="保存"
      custom-class="sn-demo-contained"
      @confirm="result = '已保存'"
      @cancel="result = '已放弃'"
    />

    <text class="sn-demo__meta">
      disabled-rotate 隐藏旋转能力；cancel-button-text / confirm-button-text
      自定义底栏按钮文案（「放弃」/「保存」）。
    </text>
  </view>
</template>
<style scoped>
.sn-demo--column {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100%;
  align-items: flex-start;
}
.sn-demo__meta {
  color: var(--sn-mp-color-text-tertiary);
  font-size: 24rpx;
}
/* Docs-preview only: the cropper root is `position: fixed`, which would cover the
 * whole docs page instead of the phone screen. Not needed in a real app. */
.sn-img-cropper.sn-demo-contained {
  position: absolute;
}
</style>