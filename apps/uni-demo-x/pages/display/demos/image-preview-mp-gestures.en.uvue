<script setup lang="ts">
/** Demo: sn-image-preview (uni-end) — WeChat-grade gestures: pinch / double-tap / drag-down dismiss. */
import SnImagePreview from '@snui/uni-x/components/sn-image-preview/sn-image-preview.uvue';
const images = [
  'https://cdn.uviewui.com/uview/album/5.jpg',
  'https://cdn.uviewui.com/uview/album/6.jpg',
  'https://cdn.uviewui.com/uview/album/7.jpg',
];

const preview = ref();

function open(index: number): void {
  preview.value?.open({ images, startPosition: index });
}
</script>
<template>
  <view class="sn-demo">
    <view class="sn-demo__thumbs">
      <image
        v-for="(src, index) in images"
        :key="src"
        class="sn-demo__thumb"
        :src="src"
        mode="aspectFill"
        @click="open(index)"
      />
    </view>
    <text class="sn-demo__hint"
      >Pinch to zoom · double-tap · pan when zoomed · drag down to close</text>
    <SnImagePreview ref="preview" :images="images" />
  </view>
</template>
<style scoped>
.sn-demo {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.sn-demo__thumbs {
  display: flex;
  flex-direction: row;
  gap: 8px;
}

.sn-demo__thumb {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
}

.sn-demo__hint {
  color: var(--sn-mp-color-text-tertiary);
  font-size: 12px;
}
</style>