  flex-direction: column;
  background-color: var(--sn-mp-color-background-elevated);
  border-radius: 16rpx;
  overflow: hidden;
}
.wall-card__title {
  padding: 12rpx 16rpx 16rpx;
  color: var(--sn-mp-color-text-secondary);
  font-size: var(--sn-mp-font-size-sm);
