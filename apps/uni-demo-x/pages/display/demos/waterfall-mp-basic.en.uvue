<script setup lang="ts">
/**
 * Demo: sn-waterfall (uni-end) — English shadow of waterfall-mp-basic.
 * Per AUI-DOCS-016: imports the real @snui/uni components from their SFC
 * source. Photos are fixed-ratio seeds so the pack is reproducible.
 */
interface Photo {
  id: string;
  title: string;
  /** Natural size — lets the wall reserve the aspect ratio before the bytes land. */
  width: number;
  height: number;
}

const photos: Photo[] = [
  { id: 'a', title: 'Trail', width: 400, height: 600 },
  { id: 'b', title: 'Sealine', width: 400, height: 300 },
  { id: 'c', title: 'Bookshop', width: 400, height: 520 },
  { id: 'd', title: 'Morning market', width: 400, height: 400 },
  { id: 'e', title: 'After rain', width: 400, height: 640 },
  { id: 'f', title: 'Long street', width: 400, height: 260 },
];
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <SnWaterfall :columns="2" :column-gap="16" :row-gap="16">
      <view v-for="photo in photos" :key="photo.id" class="wall-card">
        <SnImg
          :src="`https://picsum.photos/seed/snui-waterfall-${photo.id}/${photo.width}/${photo.height}`"
          mode="widthFix"
          width="100%"
        />
        <text class="wall-card__title">{{ photo.title }}</text>
      </view>
    </SnWaterfall>
    <text class="sn-demo__caption"
      >Two-column waterfall — a tall item no longer pushes its neighbour down; column order equals
      slot order</text
    >
  </view>
</template>
