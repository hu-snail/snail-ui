<script setup lang="ts">
/**
 * Demo: sn-count-to (uni-end) — controls (`auto-start` + start / pause / reset).
 * Per AUI-DOCS-016: imports the real @snui/uni sn-count-to from its SFC source.
 */
const controlled = ref<InstanceType<typeof SnCountTo> | null>(null);
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <SnCountTo
      ref="controlled"
      :start-val="0"
      :end-val="5000"
      :duration="6000"
      :auto-start="false"
    />
    <view class="sn-count-to-demo__row">
      <SnButton size="small" @click="controlled?.start()"><text>Start</text></SnButton>
      <SnButton size="small" @click="controlled?.pause()"><text>Pause</text></SnButton>
      <SnButton size="small" @click="controlled?.reset()"><text>Reset</text></SnButton>
    </view>
  </view>
</template>
