<script setup lang="ts">
/**
 * Demo: sn-count-to (uni-end) — 控制方法（auto-start + start / pause / reset）。
 * Per AUI-DOCS-016: imports the real @snui/uni sn-count-to from its SFC source.
 */
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
import SnCountTo from '@snui/uni-x/components/sn-count-to/sn-count-to.uvue';
const controlled = ref<InstanceType<typeof SnCountTo> | null>(null);
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <SnCountTo
      ref="controlled"
      :start-val="0"
      :end-val="5000"
      :duration="6000"
      :auto-start="false"
    />
    <view class="sn-count-to-demo__row">
      <SnButton size="small" @click="controlled?.start()"><text>开始</text></SnButton>
      <SnButton size="small" @click="controlled?.pause()"><text>暂停</text></SnButton>
      <SnButton size="small" @click="controlled?.reset()"><text>重置</text></SnButton>
    </view>
  </view>
</template>
