<script setup lang="ts">
/**
 * Demo: sn-img-cropper (uni-end) — preview frame size (`imgWidth` / `imgHeight`).
 * Per AUI-DOCS-016: imports the real @snui/uni sn-img-cropper from its SFC source.
 */
const visible = ref(false);
const result = ref('—');

const imgSrc = 'https://picsum.photos/seed/snui-crop-export/1200/900';

function onConfirm(payload: {
  scale: number;
  source: { x: number; y: number; width: number; height: number };
}) {
  result.value = `source rect ${payload.source.width}×${payload.source.height} (×${payload.scale})`;
}
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <SnButton size="small" @click="visible = true"><text>Open crop (200×160 frame)</text></SnButton>

    <text class="sn-demo__meta">Result: {{ result }}</text>

    <SnImgCropper
      v-model="visible"
      :img-src="imgSrc"
      :img-width="200"
      :img-height="160"
      aspect-ratio="4:3"
      custom-class="sn-demo-contained"
      @confirm="onConfirm"
      @cancel="result = 'Cancelled'"
    />

    <text class="sn-demo__meta">
      img-width / img-height are design px (multiplied by 2 into rpx internally) and size the
      preview box.
    </text>
  </view>
</template>
<style scoped>
.sn-demo--stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100%;
  align-items: flex-start;
}
.sn-demo__meta {
  color: var(--sn-mp-color-text-tertiary);
  font-size: 24rpx;
  line-height: var(--sn-mp-font-line-height-normal);
  word-break: break-all;
}
/* Docs-preview only: the cropper root is `position: fixed`, which would cover the
 * whole docs page instead of the phone screen. Not needed in a real app. */
.sn-img-cropper.sn-demo-contained {
  position: absolute;
}
</style>