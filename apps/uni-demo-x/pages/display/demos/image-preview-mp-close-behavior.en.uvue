<script setup lang="ts">
/**
 * Demo: sn-image-preview (uni-end) — close & loop behaviour (`loop` / `closeable` / `close-on-click`).
 * Per AUI-DOCS-016: imports the real @snui/uni sn-image-preview from its SFC source.
 */
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
import SnImagePreview from '@snui/uni-x/components/sn-image-preview/sn-image-preview.uvue';
const preview = ref<{
  open: (options?: { images?: string[]; startPosition?: number }) => void;
  close: () => void;
  setActive: (index: number) => void;
} | null>(null);

const images = [
  'https://picsum.photos/seed/snui-loop-a/900/1300',
  'https://picsum.photos/seed/snui-loop-b/900/1300',
];
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <SnButton size="small" @click="preview?.open()"
      ><text>Open (no loop / no close button / backdrop tap kept)</text></SnButton
    >

    <SnImagePreview
      ref="preview"
      :images="images"
      :loop="false"
      :closeable="false"
      :close-on-click="false"
      custom-class="sn-demo-contained"
    >
      <template #default>
        <view class="sn-demo__footer">
          <SnButton size="small" @click="preview?.close()"><text>Close</text></SnButton>
        </view>
      </template>
    </SnImagePreview>

    <text class="sn-demo__meta">
      loop=false stops at the last image instead of wrapping; closeable=false renders no close
      button; close-on-click=false keeps backdrop taps from closing — the footer button or the
      swipe-down gesture are the only ways out.
    </text>
  </view>
</template>
<style scoped>
.sn-demo--stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100%;
  align-items: flex-start;
}
.sn-demo__footer {
  display: flex;
  justify-content: center;
  flex-direction: row;
}
.sn-demo__meta {
  color: var(--sn-mp-color-text-tertiary);
  font-size: 24rpx;
  line-height: var(--sn-mp-font-line-height-normal);
}
/* Docs-preview only: the viewer root is `position: fixed`, which would cover the
 * whole docs page instead of the phone screen. Not needed in a real app. */
.sn-image-preview.sn-demo-contained {
  position: absolute;
}
</style>