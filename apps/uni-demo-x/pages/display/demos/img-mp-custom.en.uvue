<script setup lang="ts">
/**
 * Demo: sn-img (uni-end) — custom-class / custom-style / custom-image.
 * Per AUI-DOCS-016: imports the real @snui/uni sn-img from its SFC source.
 */
import SnImg from '@snui/uni-x/components/sn-img/sn-img.uvue';
const demo = 'https://cdn.uviewui.com/uview/album/5.jpg';
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <SnImg
      :src="demo"
      width="100%"
      height="240rpx"
      mode="aspectFill"
      custom-class="sn-img-demo__root"
      custom-style="box-shadow: var(--sn-mp-shadow-md)"
      custom-image="sn-img-demo__image"
    />
    <text class="sn-demo__meta">
      customClass lands on the root &lt;view&gt; (frame / shadow), customStyle is appended to the
      root inline style and customImage lands on the inner &lt;image&gt; (filters / zoom). All three
      are reached through :deep().
    </text>

    <view class="sn-demo__row">
      <SnImg
        :src="demo"
        :width="160"
        :height="160"
        mode="aspectFill"
        custom-image="sn-img-demo__zoom"
      />
      <SnImg
        :src="demo"
        :width="160"
        :height="160"
        mode="aspectFill"
        custom-image="sn-img-demo__fade"
      />
    </view>
    <text class="sn-demo__meta"
      >One image with two customImage classes: zoomed in and faded out.</text
    >
  </view>
</template>
