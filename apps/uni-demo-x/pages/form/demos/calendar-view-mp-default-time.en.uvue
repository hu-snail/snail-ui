<script setup lang="ts">
/**
 * Demo: sn-calendar-view — default clock time and immediate write-back
 * (defaultTime + immediateChange).
 *
 * - `default-time`: the timestamp written back by single selection carries this
 *   clock time (default `00:00:00`)
 * - `immediate-change`: change fires and the value is written as soon as a cell
 *   is tapped, no second confirmation
 */
import SnCalendarView from '@snui/uni-x/components/sn-calendar-view/sn-calendar-view.uvue';
import type { CalendarDayItem } from '@snui/uni-x/components/sn-calendar-view/sn-calendar-view-types';

const min = new Date(2024, 5, 1).getTime();
const max = new Date(2024, 5, 30).getTime();

/** Single selection writes back 09:30:00. */
const timed = ref<number | number[] | null>(null);
const timedText = computed(() => {
  const value = timed.value;
  if (typeof value !== 'number') return '(not selected)';
  const d = new Date(value);
  const pad = (n: number): string => (n < 10 ? `0${n}` : String(n));
  return `${d.getMonth() + 1}/${d.getDate()} ${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
});

const changes = ref(0);

function onChange(): void {
  changes.value += 1;
}

/** Keeps the panel title; tags the 15th with a "PAY" caption. */
function markPayday(day: CalendarDayItem): Partial<CalendarDayItem> | undefined {
  return new Date(day.date).getDate() === 15 ? { topInfo: 'PAY' } : undefined;
}
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <SnCalendarView
      v-model="timed"
      :min-date="min"
      :max-date="max"
      default-time="09:30:00"
      immediate-change
      :panel-height="220"
      :formatter="markPayday"
      @change="onChange"
    />
    <text class="sn-demo__meta"
      >defaultTime="09:30:00" + immediateChange: a tap writes the clock time back immediately —
      {{ timedText }}</text
    >
    <text class="sn-demo__meta">change fired {{ changes }} times</text>
  </view>
</template>
<style scoped>
.sn-demo--stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  align-items: stretch;
  width: 100%;
}
.sn-demo__meta {
  color: var(--sn-mp-color-text-tertiary);
  font-size: var(--sn-mp-font-size-xs);
  line-height: var(--sn-mp-font-line-height-normal);
}
</style>