    <SnCalendarView
      v-model="bare"
      :min-date="min"
      :max-date="max"
      :show-panel-title="false"
      :panel-height="240"
    />
    <text class="sn-demo__meta">showPanelTitle=false: grid only, no "2024 / 6" caption</text>
