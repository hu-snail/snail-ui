    </SnCheckboxGroup>
    <SnCheckboxGroup v-model="readOnly" readonly>
      <SnCheckbox name="a"><text>Whole group read-only</text></SnCheckbox>
    </SnCheckboxGroup>

    <text class="sn-demo__title">indeterminate (half-checked)</text>
