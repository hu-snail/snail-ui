<script setup lang="ts">
/**
 * Demo: sn-calendar — 区间约束（maxRange / allowSameDay / defaultTime）。
 *
 * 一张 cell 卡片承载入口：daterange 类型叠加 max-range=7、allow-same-day 与
 * default-time=08:00:00，超跨度的选择会被 rangePrompt 提示拦下。
 */
import { Clock } from '@snui/uni-x/components/sn-icon/sn-icon-set';
import SnCellGroup from '@snui/uni-x/components/sn-cell/sn-cell-group.uvue';
const min = new Date(2024, 0, 1).getTime();
const max = new Date(2024, 11, 31).getTime();

const limitedRange = ref<number | number[] | null>(null);
const open = ref(false);

function fmtDate(value: number | number[] | null): string {
  if (typeof value !== 'number') return '';
  const d = new Date(value);
  return `${d.getFullYear()}-${d.getMonth() + 1}-${d.getDate()}`;
}

const rangeText = computed(() => {
  const value = limitedRange.value;
  if (!Array.isArray(value) || value.length !== 2) return '';
  const [start, end] = value;
  if (start === undefined || end === undefined) return '';
  return `${fmtDate(start).slice(5)} - ${fmtDate(end).slice(5)}`;
});
</script>
<template>
  <view class="sn-demo sn-demo--column">
    <SnCellGroup card title="区间约束">
      <SnCell
        title="区间跨度"
        label="max-range = 7 · allow-same-day · default-time = 08:00:00"
        :value="rangeText"
        placeholder="未选择"
        :prefix-icon-data="Clock"
        is-link
        @click="open = true"
      />
    </SnCellGroup>

    <text class="sn-demo__meta">区间：{{ rangeText || '未选择' }}</text>

    <SnCalendar
      v-model="limitedRange"
      v-model:visible="open"
      type="daterange"
      title="最多 7 天"
      :min-date="min"
      :max-date="max"
      :max-range="7"
      range-prompt="最多只能选 7 天"
      allow-same-day
      default-time="08:00:00"
    />
  </view>
</template>
<style scoped>
.sn-demo--column {
  display: flex;
  flex-direction: column;
  gap: var(--sn-mp-spacing-3);
  width: 100%;
}

.sn-demo__meta {
  color: var(--sn-mp-color-text-tertiary);
  font-size: var(--sn-mp-font-size-xs);
}
</style>