<script setup lang="ts">
/** Demo: sn-keyboard — delete key toggle (showDeleteKey): showDeleteKey=false renders no delete key. */
import SnKeyboard from '@snui/uni-x/components/sn-keyboard/sn-keyboard.uvue';
const noDelete = ref('');
const openNoDelete = ref(false);
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <text class="sn-demo__title">showDeleteKey=false (no delete key)</text>
    <view class="sn-demo__button" @click="openNoDelete = true"><text>No delete key</text></view>
    <SnKeyboard
      v-model="noDelete"
      v-model:visible="openNoDelete"
      :maxlength="6"
      title="No delete key"
      :show-delete-key="false"
    />
  </view>
</template>
