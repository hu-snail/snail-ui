<script setup lang="ts">
/** Demo: sn-datetime-picker — time type (`type="time"`): writes back an `HH:mm` string. */
import SnDatetimePicker from '@snui/uni-x/components/sn-datetime-picker/sn-datetime-picker.uvue';
import SnCell from '@snui/uni-x/components/sn-cell/sn-cell.uvue';
import SnCellGroup from '@snui/uni-x/components/sn-cell/sn-cell-group.uvue';
import { Clock } from '@snui/uni-x/components/sn-icon/sn-icon-set';

const time = ref<string | number | undefined>('10:30');
const open = ref(false);
</script>
<template>
  <view class="sn-demo sn-demo--column">
    <SnCellGroup insert>
      <SnCell
        title="Time"
        label="type=time writes back an HH:mm string"
        :prefix-icon-data="Clock"
        placeholder="Select"
        :value="time ? String(time) : ''"
        is-link
        @click="open = true"
      />
    </SnCellGroup>

    <SnDatetimePicker v-model="time" v-model:visible="open" type="time" title="Pick a time" />
  </view>
</template>