<script setup lang="ts">
/**
 * Demo: sn-datetime-picker-view — field mapping (valueKey / labelKey).
 *
 * Columns are generated internally, so valueKey / labelKey are parity-only
 * props: a config written against the reference surface type-checks unchanged
 * and carries no visual effect.
 */
const min = new Date(2024, 0, 1).getTime();
const max = new Date(2024, 11, 31).getTime();

const value = ref<string | number>(new Date(2024, 5, 15).getTime());
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <SnDatetimePickerView
      v-model="value"
      type="date"
      :min-date="min"
      :max-date="max"
      value-key="value"
      label-key="label"
    />
    <text class="sn-demo__meta">
      valueKey / labelKey are parity props (columns are generated); declared with no visual effect
    </text>
  </view>
</template>
