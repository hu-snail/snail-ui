<script setup lang="ts">
/**
 * Demo: sn-calendar — week start day (firstDayOfWeek).
 *
 * One cell card carries the entry: first-day-of-week = 1 makes Monday the
 * first column; the row shows the picked date and tapping opens the sheet.
 */
import { Calendar } from '@snui/uni-x/components/sn-icon/sn-icon-set';
import SnCalendar from '@snui/uni-x/components/sn-calendar/sn-calendar.uvue';
import SnCell from '@snui/uni-x/components/sn-cell/sn-cell.uvue';
import SnCellGroup from '@snui/uni-x/components/sn-cell/sn-cell-group.uvue';
const min = new Date(2024, 0, 1).getTime();
const max = new Date(2024, 11, 31).getTime();

const mondayFirst = ref<number | number[] | null>(new Date(2024, 5, 15).getTime());
const open = ref(false);

function fmtDate(value: number | number[] | null): string {
  if (typeof value !== 'number') return '';
  const d = new Date(value);
  return `${d.getFullYear()}-${d.getMonth() + 1}-${d.getDate()}`;
}

const mondayText = computed(() => fmtDate(mondayFirst.value));
</script>
<template>
  <view class="sn-demo sn-demo--column">
    <SnCellGroup card title="Week start day">
      <SnCell
        title="Monday first"
        label="first-day-of-week = 1 (Monday)"
        :value="mondayText"
        placeholder="Not selected"
        :prefix-icon-data="Calendar"
        is-link
        @click="open = true"
      />
    </SnCellGroup>

    <SnCalendar
      v-model="mondayFirst"
      v-model:visible="open"
      type="date"
      title="Monday first"
      :first-day-of-week="1"
      :min-date="min"
      :max-date="max"
    />
  </view>
</template>
<style scoped>
.sn-demo--column {
  display: flex;
  flex-direction: column;
  gap: var(--sn-mp-spacing-3);
  width: 100%;
}
</style>