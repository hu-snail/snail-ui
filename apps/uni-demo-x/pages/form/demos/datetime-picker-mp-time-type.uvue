<script setup lang="ts">
/** Demo: sn-datetime-picker — 时间类型（type="time"）：写回 "HH:mm" 字符串。 */
import SnCellGroup from '@snui/uni-x/components/sn-cell/sn-cell-group.uvue';
import { Clock } from '@snui/uni-x/components/sn-icon/sn-icon-set';

const time = ref<string | number | undefined>('10:30');
const open = ref(false);
</script>
<template>
  <view class="sn-demo sn-demo--column">
    <SnCellGroup insert>
      <SnCell
        title="选择时间"
        label="type=time 写回 HH:mm 字符串"
        :prefix-icon-data="Clock"
        placeholder="请选择"
        :value="time ? String(time) : ''"
        is-link
        @click="open = true"
      />
    </SnCellGroup>

    <SnDatetimePicker v-model="time" v-model:visible="open" type="time" title="选择时间" />
  </view>
</template>