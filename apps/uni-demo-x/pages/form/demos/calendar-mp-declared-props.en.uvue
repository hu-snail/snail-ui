<script setup lang="ts">
/**
 * Demo: sn-calendar — parity placeholder props (timeFilter / hideSecond etc.).
 *
 * One cell card carries the entry: innerDisplayFormat / ellipsis /
 * showTypeSwitch / hideSecond / timeFilter are parity props — this build has
 * no time roller and no range tabs, so they carry no visual effect and exist
 * only so a config written against the reference surface type-checks unchanged.
 */
import { Settings } from '@snui/uni-x/components/sn-icon/sn-icon-set';
import SnCellGroup from '@snui/uni-x/components/sn-cell/sn-cell-group.uvue';
const min = new Date(2024, 0, 1).getTime();
const max = new Date(2024, 11, 31).getTime();

const value = ref<number | number[] | null>(null);
const open = ref(false);

/** timeFilter: keep even hours only (declared but unimplemented — never runs). */
const evenHours = (type: string, values: number[]) =>
  type === 'hour' ? values.filter((v) => v % 2 === 0) : values;

const innerFormat = 'Custom range echo';
</script>
<template>
  <view class="sn-demo sn-demo--column">
    <SnCellGroup card title="Parity placeholder props">
      <SnCell
        title="Parity props"
        label="inner-display-format / ellipsis / show-type-switch / hide-second / time-filter"
        :value="Array.isArray(value) ? `${value.length} dates` : ''"
        placeholder="Not selected"
        :prefix-icon-data="Settings"
        is-link
        @click="open = true"
      />
    </SnCellGroup>

    <text class="sn-demo__meta">
      innerDisplayFormat / ellipsis / showTypeSwitch / hideSecond / timeFilter are parity props:
      this build has no time roller and no range tabs, so they carry no visual effect
      (innerDisplayFormat also accepts a formatter function).
    </text>

    <SnCalendar
      v-model="value"
      v-model:visible="open"
      type="daterange"
      title="Parity props"
      :min-date="min"
      :max-date="max"
      :inner-display-format="innerFormat"
      :ellipsis="true"
      :show-type-switch="false"
      :hide-second="true"
      :time-filter="evenHours"
    />
  </view>
</template>
<style scoped>
.sn-demo--column {
  display: flex;
  flex-direction: column;
  gap: var(--sn-mp-spacing-3);
  width: 100%;
}

.sn-demo__meta {
  color: var(--sn-mp-color-text-tertiary);
  font-size: var(--sn-mp-font-size-xs);
}
</style>