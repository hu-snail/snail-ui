<script setup lang="ts">
/** Demo: sn-datetime-picker — 列文案与过滤（formatter / filter）：给列文案加单位；月份只留偶数月。 */
import SnDatetimePicker from '@snui/uni-x/components/sn-datetime-picker/sn-datetime-picker.uvue';
import SnCell from '@snui/uni-x/components/sn-cell/sn-cell.uvue';
import SnCellGroup from '@snui/uni-x/components/sn-cell/sn-cell-group.uvue';
import { Filter } from '@snui/uni-x/components/sn-icon/sn-icon-set';

const min = new Date(2024, 0, 1).getTime();
const max = new Date(2024, 11, 31).getTime();

const formatted = ref<string | number | undefined>(new Date(2024, 5, 15).getTime());
const openFormatted = ref(false);

/** formatter：给列文案加单位。 */
const withUnit = (type: string, value: number) => {
  const unit = type === 'year' ? ' 年' : type === 'month' ? ' 月' : type === 'date' ? ' 日' : '';
  return `${value}${unit}`;
};
/** filter：月份只留偶数月。 */
const evenMonths = (type: string, values: number[]) =>
  type === 'month' ? values.filter((v) => v % 2 === 0) : values;

const pad = (n: number) => String(n).padStart(2, '0');
const formattedText = computed(() => {
  if (formatted.value === undefined) return '';
  const d = new Date(Number(formatted.value));
  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
});
</script>
<template>
  <view class="sn-demo sn-demo--column">
    <SnCellGroup insert>
      <SnCell
        title="格式化与过滤"
        label="列文案加单位；月份只留偶数月"
        :prefix-icon-data="Filter"
        :value="formattedText"
        is-link
        @click="openFormatted = true"
      />
    </SnCellGroup>

    <SnDatetimePicker
      v-model="formatted"
      v-model:visible="openFormatted"
      type="date"
      title="格式化与过滤"
      :min-date="min"
      :max-date="max"
      :formatter="withUnit"
      :filter="evenMonths"
    />
  </view>
</template>