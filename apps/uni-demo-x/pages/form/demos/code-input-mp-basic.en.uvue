<script setup lang="ts">
/** Demo: sn-code-input — Boxed PIN field: `length` sets the box count, `mask` toggles the dots and `focused` drives the caret (pair it with the keyboard visibility). */
import SnCodeInput from '@snui/uni-x/components/sn-code-input/sn-code-input.uvue';
const pin = ref('123');
const focused = ref(true);
const mask = ref(true);
</script>
<template>
  <view class="sn-demo sn-demo--column">
    <SnCodeInput
      v-model="pin"
      :length="6"
      :mask="mask"
      :focused="focused"
      info="Enter the 6-digit PIN"
    />
    <view class="sn-demo__row">
      <view class="sn-demo__button" @click="focused = !focused"><text>{{
        focused ? 'Blur' : 'Focus'
      }}</text></view>
      <view class="sn-demo__button sn-demo__button--ghost" @click="mask = !mask"><text>{{
        mask ? 'Plain' : 'Dots'
      }}</text></view>
    </view>
    <text class="sn-demo__meta">Value: {{ pin || '(empty)' }}</text>
  </view>
</template>
