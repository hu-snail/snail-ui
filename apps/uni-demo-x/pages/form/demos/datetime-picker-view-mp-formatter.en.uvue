<script setup lang="ts">
/** Demo: sn-datetime-picker-view — column label formatting (formatter): rewrites the column labels. */
const min = new Date(2020, 0, 1).getTime();
const max = new Date(2030, 11, 31).getTime();
const year = ref<string | number>(new Date(2024, 5, 15).getTime());
const yearLabel = (_type: string, value: number) => `${value}`;
</script>
<template>
  <view class="sn-demo sn-demo--column">
    <SnDatetimePickerView
      v-model="year"
      type="year"
      :min-date="min"
      :max-date="max"
      :formatter="yearLabel"
    />
    <text class="sn-demo__meta">formatter rewrites the year column labels</text>
  </view>
</template>
<style scoped>
.sn-demo--column {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  align-items: stretch;
  width: 100%;
}

.sn-demo__meta {
  font-size: 24rpx;
  color: var(--sn-mp-color-text-tertiary);
}
</style>