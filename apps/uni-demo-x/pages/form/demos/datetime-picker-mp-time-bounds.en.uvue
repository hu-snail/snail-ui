<script setup lang="ts">
/** Demo: sn-datetime-picker — h-m-s bounds: minHour / maxHour / minMinute / maxMinute + useSecond / maxSecond. */
import SnDatetimePicker from '@snui/uni-x/components/sn-datetime-picker/sn-datetime-picker.uvue';
import SnCell from '@snui/uni-x/components/sn-cell/sn-cell.uvue';
import SnCellGroup from '@snui/uni-x/components/sn-cell/sn-cell-group.uvue';
import { Clock } from '@snui/uni-x/components/sn-icon/sn-icon-set';

const min = new Date(2024, 0, 1).getTime();
const max = new Date(2024, 11, 31).getTime();

const hours = ref<string | number | undefined>(new Date(2024, 5, 15, 12).getTime());
const openHours = ref(false);

const withSeconds = ref<string | number | undefined>('10:30:00');
const openSeconds = ref(false);

const pad = (n: number) => String(n).padStart(2, '0');
const hoursText = computed(() => {
  if (hours.value === undefined) return '';
  const d = new Date(Number(hours.value));
  return `${pad(d.getHours())}:${pad(d.getMinutes())}`;
});
</script>
<template>
  <view class="sn-demo sn-demo--column">
    <SnCellGroup insert>
      <SnCell
        title="Restricted hours"
        label="minHour 08 / maxHour 18, minMinute 15 / maxMinute 45"
        :prefix-icon-data="Clock"
        :value="hoursText"
        is-link
        @click="openHours = true"
      />
      <SnCell
        title="With seconds"
        label="useSecond + maxSecond 30"
        :prefix-icon-data="Clock"
        :value="String(withSeconds)"
        is-link
        @click="openSeconds = true"
      />
    </SnCellGroup>

    <SnDatetimePicker
      v-model="hours"
      v-model:visible="openHours"
      type="datetime"
      title="Restricted hours"
      :min-date="min"
      :max-date="max"
      :min-hour="8"
      :max-hour="18"
      :min-minute="15"
      :max-minute="45"
    />
    <SnDatetimePicker
      v-model="withSeconds"
      v-model:visible="openSeconds"
      type="time"
      title="With seconds"
      use-second
      :min-second="0"
      :max-second="30"
    />
  </view>
</template>