<script setup lang="ts">
/** Demo: sn-form-item — 可点击行（clickable / isLink）：整行可点并显示箭头。 */
import SnFormItem from '@snui/uni-x/components/sn-form/sn-form-item.uvue';
const data = reactive({ city: '', summary: '' });
const clickTimes = ref(0);

function onCityClick(): void {
  clickTimes.value += 1;
}
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <SnForm :model="data" label-position="left" label-width="240">
      <SnFormItem
        prop="city"
        label="常住城市"
        placeholder="未填写"
        clickable
        is-link
        @click="onCityClick"
      />

      <SnFormItem prop="summary" label="个人简介" is-link>
        <SnInput v-model="data.summary" readonly placeholder="未填写" />
      </SnFormItem>
    </SnForm>

    <text class="sn-demo__meta">点击「常住城市」行 {{ clickTimes }} 次</text>
  </view>
</template>
<style scoped>
.sn-demo--stack {
  display: flex;
  flex-direction: column;
  gap: var(--sn-mp-spacing-4);
  width: 100%;
}

