<script setup lang="ts">
/** Demo: sn-code-input — sn-code-input 方框密码框：length 控制格子数，mask 控制是否显示圆点，focused 与键盘显隐联动。 */
import SnCodeInput from '@snui/uni-x/components/sn-code-input/sn-code-input.uvue';
const pin = ref('123');
const focused = ref(true);
const mask = ref(true);
</script>
<template>
  <view class="sn-demo sn-demo--column">
    <SnCodeInput v-model="pin" :length="6" :mask="mask" :focused="focused" info="请输入 6 位密码" />
    <view class="sn-demo__row">
      <view class="sn-demo__button" @click="focused = !focused"><text>{{ focused ? '失焦' : '聚焦' }}</text></view>
      <view class="sn-demo__button sn-demo__button--ghost" @click="mask = !mask"><text>{{
        mask ? '明文' : '圆点'
      }}</text></view>
    </view>
    <text class="sn-demo__meta">当前值：{{ pin || '（空）' }}</text>
  </view>
</template>
