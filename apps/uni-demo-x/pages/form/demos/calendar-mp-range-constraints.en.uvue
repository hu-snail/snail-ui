<script setup lang="ts">
/**
 * Demo: sn-calendar — range constraints (maxRange / allowSameDay / defaultTime).
 *
 * One sn-cell row carries the entry (no group card; the module title is carried by the page): a daterange sheet with max-range = 7,
 * allow-same-day and default-time = 08:00:00; picks beyond the span are
 * rejected with the rangePrompt message.
 */
import { Clock } from '@snui/uni-x/components/sn-icon/sn-icon-set';
import SnCalendar from '@snui/uni-x/components/sn-calendar/sn-calendar.uvue';
import SnCell from '@snui/uni-x/components/sn-cell/sn-cell.uvue';
const min = new Date(2024, 0, 1).getTime();
const max = new Date(2024, 11, 31).getTime();

const limitedRange = ref<number | number[] | null>(null);
const open = ref(false);

function fmtDate(value: number | number[] | null): string {
  if (typeof value !== 'number') return '';
  const d = new Date(value);
  return `${d.getFullYear()}-${d.getMonth() + 1}-${d.getDate()}`;
}

const rangeText = computed(() => {
  const value = limitedRange.value;
  if (!Array.isArray(value) || value.length !== 2) return '';
  const [start, end] = value;
  if (start === undefined || end === undefined) return '';
  return `${fmtDate(start).slice(5)} - ${fmtDate(end).slice(5)}`;
});
</script>
<template>
  <view class="sn-demo sn-demo--column">
    <SnCell
      title="Range span"
      :value="rangeText"
      placeholder="Not selected"
      :prefix-icon-data="Clock"
      is-link
      @click="open = true"
    />

    <text class="sn-demo__meta">Range: {{ rangeText || 'Not selected' }}</text>

    <SnCalendar
      v-model="limitedRange"
      v-model:visible="open"
      type="daterange"
      title="At most 7 days"
      :min-date="min"
      :max-date="max"
      :max-range="7"
      range-prompt="You can only pick 7 days"
      allow-same-day
      default-time="08:00:00"
      :show-footer="false"
      confirm-on-select
    />
  </view>
</template>
<style scoped>
.sn-demo--column {
  display: flex;
  flex-direction: column;
  gap: var(--sn-mp-spacing-3);
  width: 100%;
}

.sn-demo__meta {
  color: var(--sn-mp-color-text-tertiary);
  font-size: var(--sn-mp-font-size-xs);
}
</style>