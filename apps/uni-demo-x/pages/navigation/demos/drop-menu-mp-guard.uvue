<!-- gen-x: source apps/uni-demo/src/pages/navigation/demos/drop-menu-mp-guard.vue sha256:ed819f92536c253f —— 生成产物勿手改；源码改动后重跑 pnpm -F @snui/uni-demo-x gen -->
<script setup lang="ts">
/**
 * Demo: sn-drop-menu (uni-end) — up direction and the before-toggle guard.
 * Per AUI-DOCS-016: imports the real @snui/uni sn-drop-menu from its SFC source.
 */
import SnDropMenu from '@snui/uni-x/components/sn-drop-menu/sn-drop-menu.uvue';
const value = ref('');

const options = [
  { label: '不限', value: 'all' },
  { label: '50 元以下', value: 'lt50' },
  { label: '50 - 200 元', value: 'mid' },
];

const blocked = ref(0);

/** Block opening twice to show the guard working, then allow. */
function beforeToggle(): boolean {
  blocked.value += 1;
  return blocked.value > 2;
}
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <view class="sn-drop-menu-demo__spacer" />

    <SnDropMenu
      v-model="value"
      :options="options"
      direction="up"
      title="价格区间"
      :before-toggle="beforeToggle"
      custom-class="sn-demo-contained"
    />

    <text class="sn-drop-menu-demo__meta">
      前 2 次点击被 before-toggle 拦下（已拦截 {{ Math.min(blocked, 2) }} 次）
    </text>
  </view>
</template>
<style scoped>
.sn-demo--stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.sn-drop-menu-demo__spacer {
  height: 320rpx;
}
.sn-drop-menu-demo__meta {
  font-size: 24rpx;
  color: var(--vp-c-text-2);
}

/* uni-app x 的 view 默认 overflow: hidden——本 demo 的包装类全链放开，
   锚定弹层（tooltip / popover / drop-menu）伸出包装盒时不被裁
   （App.vue 全局规则只命中页面级元素与 demo 根节点，AGENTS.md §103）。 */
.sn-drop-menu-demo__spacer {
  overflow: visible;
}
.sn-drop-menu-demo__meta {
  overflow: visible;
}
</style>