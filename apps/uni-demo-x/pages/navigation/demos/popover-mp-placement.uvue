<script setup lang="ts">
/**
 * Demo: sn-popover (uni-end) — top / left / right / bottom placement grid.
 * Triggers sit at the corners so each anchored bubble has room to open; the
 * start / end alignment variants are covered by the alignment demo.
 */
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
import SnPopover from '@snui/uni-x/components/sn-popover/sn-popover.uvue';
import { MapPin } from '@snui/uni-x/components/sn-icon/sn-icon-set';

type Direction = 'top' | 'left' | 'right' | 'bottom';

/** Corner layout: 上/左 in row 1, 右/下 in row 2 (flex, MP / App safe). */
const firstRow: { key: Direction; label: string }[] = [
  { key: 'top', label: '上' },
  { key: 'left', label: '左' },
];
const secondRow: { key: Direction; label: string }[] = [
  { key: 'right', label: '右' },
  { key: 'bottom', label: '下' },
];

const openDirection = ref<Direction | null>(null);

function setOpen(direction: Direction, value: boolean): void {
  openDirection.value = value
    ? direction
    : openDirection.value === direction
      ? null
      : openDirection.value;
}
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <view class="sn-popover-demo__grid">
      <view class="sn-popover-demo__row">
        <view v-for="cell in firstRow" :key="cell.key" class="sn-popover-demo__cell">
          <SnPopover
            :model-value="openDirection === cell.key"
            :placement="cell.key"
            title="快速提示"
            :content="`气泡出现在触发器的${cell.label}侧。`"
            :icon-data="MapPin"
            custom-class="sn-demo-contained"
            @update:model-value="setOpen(cell.key, $event)"
          >
            <SnButton size="small"><text>{{ cell.label }}</text></SnButton>
          </SnPopover>
        </view>
        <view class="sn-popover-demo__gap" />
      </view>
      <view class="sn-popover-demo__row">
        <view v-for="cell in secondRow" :key="cell.key" class="sn-popover-demo__cell">
          <SnPopover
            :model-value="openDirection === cell.key"
            :placement="cell.key"
            title="快速提示"
            :content="`气泡出现在触发器的${cell.label}侧。`"
            :icon-data="MapPin"
            custom-class="sn-demo-contained"
            @update:model-value="setOpen(cell.key, $event)"
          >
            <SnButton size="small"><text>{{ cell.label }}</text></SnButton>
          </SnPopover>
        </view>
        <view class="sn-popover-demo__gap" />
      </view>
    </view>

    <view class="sn-popover-demo__space" />

    <text class="sn-demo__hint">四个方向都带指向触发器的箭头；点击气泡外部任意位置关闭。</text>
  </view>
</template>
<style scoped>
.sn-demo--stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.sn-demo__hint {
  font-size: 22rpx;
  color: var(--sn-mp-color-text-secondary);
}
.sn-popover-demo__grid {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 24rpx 0;
}
.sn-popover-demo__row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}
.sn-popover-demo__cell {
  display: flex;
  flex-direction: row;
}
/* Row 1 pairs [上 … 左]: the spacer keeps 左 on the right edge. */
.sn-popover-demo__gap {
  flex: 1;
}
.sn-popover-demo__space {
  height: 300rpx;
}
/* Docs-preview only — keep the bubble inside the demo flow. */
</style>