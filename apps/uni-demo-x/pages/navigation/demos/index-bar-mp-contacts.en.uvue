/* ── 全屏覆盖层 ───────────────────────────────────────────────────────── */
/* fixed 锚定视口（docs 预览 iframe 内即为手机屏）；壳层无 transform/backdrop
 * 祖先（App.vue 约定），不会被卡片坐标系困住。 */
.icx {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  background-color: var(--sn-mp-color-background-surface);
  animation: icx-in 0.24s ease both;
}

@keyframes icx-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* v-show 叠层的页面画布 */
.icx__page {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
