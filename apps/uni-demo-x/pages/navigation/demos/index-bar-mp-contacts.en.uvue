<script setup lang="ts">
/**
 * Demo: sn-index-bar — full-page contacts (compact preview + fullscreen page
 * + contact profile).
 *
 * Compact preview: keyword filter + sn-index-bar contact list (show-indicator
 * centre bubble, anchor-id stable group ids, sn-avatar text avatars); tap
 * "整页演示" or any contact to enter the fullscreen whole-page scenario.
 * Fullscreen page: a position: fixed overlay = the whole-page app demo —
 *          SnNavbar + search filter + index-bar contacts + a bottom count bar;
 *          tapping a contact opens the profile page (v-show layering keeps
 *          the list scroll position when going back).
 */
import SnIndexBar from '@snui/uni-x/components/sn-index-bar/sn-index-bar.uvue';
import SnIndexAnchor from '@snui/uni-x/components/sn-index-bar/sn-index-anchor.uvue';
import SnAvatar from '@snui/uni-x/components/sn-avatar/sn-avatar.uvue';
import SnIcon from '@snui/uni-x/components/sn-icon/sn-icon.uvue';
import SnNavbar from '@snui/uni-x/components/sn-navbar/sn-navbar.uvue';
import {
  ChevronRight,
  Mail,
  MapPin,
  Phone,
  Search,
  User,
} from '@snui/uni-x/components/sn-icon/sn-icon-set';

interface Contact {
  name: string;
  note: string;
  role: string;
  dept: string;
  location: string;
  phone: string;
  mail: string;
}

interface ContactGroup {
  index: string;
  contacts: Contact[];
}

const groups: ContactGroup[] = [
  {
    index: 'A',
    contacts: [
      {
        name: 'Alice',
        note: '产品',
        role: '高级产品经理',
        dept: '产品部',
        location: '上海',
        phone: '138-0000-1001',
        mail: 'alice@snui.dev',
      },
      {
        name: 'Amy',
        note: '设计',
        role: '视觉设计师',
        dept: '设计中心',
        location: '杭州',
        phone: '138-0000-1002',
        mail: 'amy@snui.dev',
      },
      {
        name: 'Aaron',
        note: '测试',
        role: '测试工程师',
        dept: '质量部',
        location: '成都',
        phone: '138-0000-1003',
        mail: 'aaron@snui.dev',
      },
    ],
  },
  {
    index: 'B',
    contacts: [
      {
        name: 'Bob',
        note: '研发',
        role: '前端工程师',
        dept: '客户端部',
        location: '北京',
        phone: '138-0000-2001',
        mail: 'bob@snui.dev',
      },
      {
        name: 'Bella',
        note: '运营',
        role: '用户运营',
        dept: '运营部',
        location: '广州',
        phone: '138-0000-2002',
        mail: 'bella@snui.dev',
      },
      {
        name: 'Ben',
        note: '研发',
        role: '后端工程师',
        dept: '服务端部',
        location: '深圳',
        phone: '138-0000-2003',
        mail: 'ben@snui.dev',
      },
    ],
  },
  {
    index: 'C',
    contacts: [
      {
        name: 'Carl',
        note: '市场',
        role: '品牌营销',
        dept: '市场部',
        location: '上海',
        phone: '138-0000-3001',
        mail: 'carl@snui.dev',
      },
      {
        name: 'Cindy',
        note: '财务',
        role: '财务专员',
        dept: '财务部',
        location: '北京',
        phone: '138-0000-3002',
        mail: 'cindy@snui.dev',
      },
    ],
  },
  {
    index: 'D',
    contacts: [
      {
        name: 'Dora',
        note: '法务',
        role: '法务顾问',
        dept: '法务部',
        location: '北京',
        phone: '138-0000-4001',
        mail: 'dora@snui.dev',
      },
    ],
  },
  {
    index: 'L',
    contacts: [
      {
        name: 'Leo',
        note: '研发',
        role: '架构师',
        dept: '架构组',
        location: '杭州',
        phone: '138-0000-5001',
        mail: 'leo@snui.dev',
      },
      {
        name: 'Lily',
        note: '设计',
        role: '交互设计师',
        dept: '设计中心',
        location: '上海',
        phone: '138-0000-5002',
        mail: 'lily@snui.dev',
      },
    ],
  },
  {
    index: 'W',
    contacts: [
      {
        name: '王伟',
        note: '研发',
        role: '小程序负责人',
        dept: '客户端部',
        location: '北京',
        phone: '138-0000-6001',
        mail: 'wangwei@snui.dev',
      },
      {
        name: '吴敏',
        note: '客服',
        role: '客服主管',
        dept: '客户成功部',
        location: '合肥',
        phone: '138-0000-6002',
        mail: 'wumin@snui.dev',
      },
    ],
  },
  {
    index: 'Z',
    contacts: [
      {
        name: '张涛',
        note: '产品',
        role: '产品总监',
        dept: '产品部',
        location: '深圳',
        phone: '138-0000-7001',
        mail: 'zhangtao@snui.dev',
      },
      {
        name: '赵敏',
        note: '运营',
        role: '内容运营',
        dept: '运营部',
        location: '上海',
        phone: '138-0000-7002',
        mail: 'zhaomin@snui.dev',
      },
    ],
  },
];

/** 头像底色轮转池：全部取自 token，暗色下自动适配。 */
const AVATAR_COLORS = [
  'var(--sn-mp-color-action-primary)',
  'var(--sn-mp-color-feedback-success)',
  'var(--sn-mp-color-feedback-warning)',
  'var(--sn-mp-color-purple)',
  'var(--sn-mp-color-cyan)',
  'var(--sn-mp-color-pink)',
  'var(--sn-mp-color-volcano)',
  'var(--sn-mp-color-lightblue)',
];

/** 姓名 → 稳定颜色（同一联系人每次渲染同色）。 */
function colorOf(seed: string): string {
  let sum = 0;
  for (let i = 0; i < seed.length; i += 1) sum += seed.charCodeAt(i);
  return AVATAR_COLORS[sum % AVATAR_COLORS.length]!;
}

const query = ref('');

/** 按关键字过滤；空组直接丢弃，索引栏随分组联动。 */
const filtered = computed<ContactGroup[]>(() => {
  const keyword = query.value.trim().toLowerCase();
  return groups
    .map((group) => ({
      index: group.index,
      contacts: group.contacts.filter((c) => c.name.toLowerCase().includes(keyword)),
    }))
    .filter((group) => group.contacts.length > 0);
});

/** 过滤后的联系人总数（全屏页底栏展示）。 */
const totalCount = computed(() =>
  filtered.value.reduce((sum, group) => sum + group.contacts.length, 0),
);

const FULLSCREEN_Z = '1200';
const screen = ref<'compact' | 'page' | 'detail'>('compact');
const current = ref<Contact>(groups[0]!.contacts[0]!);

function enterFull(): void {
  screen.value = 'page';
}

function openDetail(contact: Contact): void {
  current.value = contact;
  screen.value = 'detail';
}

function backToPage(): void {
  screen.value = 'page';
}

function exitFull(): void {
  screen.value = 'compact';
  query.value = '';
}
</script>
<template>
  <view class="sn-demo sn-demo--contacts">
    <!-- ── 紧凑预览：搜索 + 索引栏通讯录 ─────────────────────────────────── -->
    <view class="sn-demo__topbar">
      <view class="sn-demo__title-row">
        <text class="sn-demo__title">Contacts</text>
        <view
          class="sn-demo__expand"
          role="button"
          aria-label="Open full-page demo"
          @click="enterFull"
        >
          <text class="sn-demo__expand-text">Full page</text>
          <SnIcon :icon="ChevronRight" :size="12" />
        </view>
      </view>
      <view class="sn-demo__search">
        <SnIcon :icon="Search" size="36rpx" class="sn-demo__search-icon" />
        <input
          v-model="query"
          class="sn-demo__search-input"
          placeholder="Search contacts"
          placeholder-style="color: var(--sn-mp-color-input-placeholder);"
        />
      </view>
    </view>

    <view class="sn-demo__list">
      <SnIndexBar custom-class="sn-demo__bar" sticky show-indicator>
        <SnIndexAnchor
          v-for="group in filtered"
          :key="group.index"
          :index="group.index"
          :anchor-id="`contact-group-${group.index}`"
        >
          <view
            v-for="contact in group.contacts"
            :key="contact.name"
            class="sn-demo__contact"
            @click="openDetail(contact)"
          >
            <SnAvatar :text="contact.name.slice(0, 2)" :bg-color="colorOf(contact.name)" />
            <view class="sn-demo__contact-main">
              <text class="sn-demo__contact-name">{{ contact.name }}</text>
              <text class="sn-demo__contact-note">{{ contact.note }}</text>
            </view>
          </view>
        </SnIndexAnchor>
      </SnIndexBar>

      <view v-if="filtered.length === 0" class="sn-demo__empty">
        <text class="sn-demo__empty-text">No contacts found</text>
      </view>
    </view>

    <!-- ── 全屏覆盖层：整个页面的通讯录应用场景 ─────────────────────────── -->
    <view v-if="screen !== 'compact'" class="icx" :style="{ zIndex: FULLSCREEN_Z }">
      <!-- 一级页：整页通讯录。v-show 保实例，返回不丢滚动位置。 -->
      <view v-show="screen === 'page'" class="icx__page">
        <SnNavbar
          title="Contacts"
          left-arrow
          left-text="Demo"
          safe-area-inset-top
          bordered
          @back="exitFull"
        />
        <view class="icx__searchbar">
          <SnIcon :icon="Search" size="36rpx" class="icx__search-icon" />
          <input
            v-model="query"
            class="icx__search-input"
            placeholder="Search"
            placeholder-style="color: var(--sn-mp-color-input-placeholder);"
          />
        </view>
        <view class="icx__body">
          <SnIndexBar custom-class="icx__bar" sticky show-indicator>
            <SnIndexAnchor
              v-for="group in filtered"
              :key="group.index"
              :index="group.index"
              :anchor-id="`page-group-${group.index}`"
            >
              <view
                v-for="contact in group.contacts"
                :key="contact.name"
                class="icx__row"
                @click="openDetail(contact)"
              >
                <SnAvatar :text="contact.name.slice(0, 2)" :bg-color="colorOf(contact.name)" />
                <view class="icx__row-main">
                  <text class="icx__row-name">{{ contact.name }}</text>
                  <text class="icx__row-note">{{ contact.role }} · {{ contact.dept }}</text>
                </view>
                <SnIcon :icon="ChevronRight" :size="14" class="icx__row-arrow" />
              </view>
            </SnIndexAnchor>
          </SnIndexBar>
        </view>
        <view class="icx__foot">
          <text class="icx__foot-text">{{ totalCount }} contacts · index bar follows groups</text>
        </view>
      </view>

      <!-- 二级页：联系人资料页 -->
      <view v-show="screen === 'detail'" class="icx__page">
        <SnNavbar
          title="Profile"
          left-arrow
          left-text="Back"
          safe-area-inset-top
          bordered
          @back="backToPage"
        />
        <view class="icd">
          <view class="icd__hero">
            <SnAvatar
              :text="current.name.slice(0, 2)"
              :bg-color="colorOf(current.name)"
              size="large"
            />
            <text class="icd__name">{{ current.name }}</text>
            <text class="icd__role">{{ current.role }}</text>
          </view>
          <view class="icd__card">
            <view class="icd__row">
              <SnIcon :icon="Phone" :size="14" class="icd__row-icon" />
              <text class="icd__row-label">Phone</text>
              <text class="icd__row-value">{{ current.phone }}</text>
            </view>
            <view class="icd__row">
              <SnIcon :icon="Mail" :size="14" class="icd__row-icon" />
              <text class="icd__row-label">Email</text>
              <text class="icd__row-value">{{ current.mail }}</text>
            </view>
            <view class="icd__row">
              <SnIcon :icon="MapPin" :size="14" class="icd__row-icon" />
              <text class="icd__row-label">City</text>
              <text class="icd__row-value">{{ current.location }}</text>
            </view>
            <view class="icd__row">
              <SnIcon :icon="User" :size="14" class="icd__row-icon" />
              <text class="icd__row-label">Dept</text>
              <text class="icd__row-value">{{ current.dept }}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>
