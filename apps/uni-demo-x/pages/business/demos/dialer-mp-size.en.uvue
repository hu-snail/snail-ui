<script setup lang="ts">
/**
 * Demo: sn-dialer (uni-end) — Size presets.
 */
import type { SnDialerPrize } from '@snui/uni-x/components/sn-dialer/sn-dialer-types';
const prizes: SnDialerPrize[] = [
  { id: 'a', name: 'Prize A' },
  { id: 'b', name: 'Prize B' },
  { id: 'c', name: 'Prize C' },
  { id: 'd', name: 'Prize D' },
];

const smallRef = ref<InstanceType<typeof SnDialer> | null>(null);
const bigRef = ref<InstanceType<typeof SnDialer> | null>(null);

function spinToRandom(dialer: InstanceType<typeof SnDialer> | null, count: number): void {
  dialer?.run(Math.floor(Math.random() * count));
}
</script>
<template>
  <view class="sn-demo sn-demo--column">
    <text class="sn-demo__title">size="420rpx" (small)</text>
    <view class="dialer-stage">
      <SnDialer
        ref="smallRef"
        :prize-list="prizes"
        size="420rpx"
        @click="spinToRandom(smallRef, prizes.length)"
      />
    </view>

    <text class="sn-demo__title">size="560rpx" (large)</text>
    <view class="dialer-stage">
      <SnDialer
        ref="bigRef"
        :prize-list="prizes"
        size="560rpx"
        @click="spinToRandom(bigRef, prizes.length)"
      />
    </view>
    <text class="sn-demo__meta">Tap a pointer to spin each wheel</text>
  </view>
</template>
<style scoped>
.dialer-stage {
  display: flex;
  flex-direction: row;
  justify-content: center;
}

