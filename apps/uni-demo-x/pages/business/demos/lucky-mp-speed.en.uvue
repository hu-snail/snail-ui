<script setup lang="ts">
/**
 * Demo: sn-lucky (uni-end) — Speed & highlight: `speed` / prize color override.
 */
import SnLucky from '@snui/uni-x/components/sn-lucky/sn-lucky.uvue';
import type { SnLuckyPrize } from '@snui/uni-x/components/sn-lucky/sn-lucky-types';
const coloredPrizes: SnLuckyPrize[] = [
  { name: 'Jackpot', color: 'var(--sn-mp-color-feedback-warning-soft)' },
  { name: 'Coupon' },
  { name: 'Points' },
  { name: 'Thanks' },
  { name: 'Red packet' },
  { name: 'Physical prize' },
  { name: 'One more go' },
  { name: 'Free-order coupon' },
];

const slowRef = ref<InstanceType<typeof SnLucky> | null>(null);

const settleTimers: ReturnType<typeof setTimeout>[] = [];

function scheduleStop(lucky: InstanceType<typeof SnLucky> | null, count: number): void {
  settleTimers.push(
    setTimeout(() => {
      lucky?.stop(Math.floor(Math.random() * count));
    }, 1000),
  );
}
</script>
<template>
  <view class="sn-demo sn-demo--column">
    <text class="sn-demo__title">speed=120 (slow highlight) + prize color override</text>
    <SnLucky
      ref="slowRef"
      :prizes="coloredPrizes"
      :speed="120"
      @start="scheduleStop(slowRef, coloredPrizes.length)"
    />
    <text class="sn-demo__meta"
      >speed is the highlight step interval (ms); color only affects the highlight background</text
    >
  </view>
</template>
<style scoped>
.sn-demo__title {
  font-size: var(--sn-mp-font-size-sm);
  font-weight: var(--sn-mp-font-weight-semibold);
  color: var(--sn-mp-color-text-secondary);
}

.sn-demo__meta {
  font-size: var(--sn-mp-font-size-sm);
  color: var(--sn-mp-color-text-tertiary);
}
</style>