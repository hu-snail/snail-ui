<script setup lang="ts">
/**
 * Demo: sn-lucky (uni-end) — Custom button: the #button slot.
 */
import SnLucky from '@snui/uni-x/components/sn-lucky/sn-lucky.uvue';
import type { SnLuckyPrize } from '@snui/uni-x/components/sn-lucky/sn-lucky-types';
const prizes: SnLuckyPrize[] = [
  { name: 'Grand prize' },
  { name: 'Coupon' },
  { name: 'Points' },
  { name: 'Thanks' },
  { name: 'Red packet' },
  { name: 'Physical prize' },
  { name: 'One more go' },
  { name: 'Free-order coupon' },
];

const slotRef = ref<InstanceType<typeof SnLucky> | null>(null);

const settleTimers: ReturnType<typeof setTimeout>[] = [];

function scheduleStop(lucky: InstanceType<typeof SnLucky> | null, count: number): void {
  settleTimers.push(
    setTimeout(() => {
      lucky?.stop(Math.floor(Math.random() * count));
    }, 1000),
  );
}
</script>
<template>
  <view class="sn-demo sn-demo--column">
    <text class="sn-demo__title">#button custom draw button</text>
    <SnLucky
      ref="slotRef"
      :prizes="prizes"
      :speed="60"
      @start="scheduleStop(slotRef, prizes.length)"
    >
      <template #button="{ isPlaying }">
        <view class="lucky-button">
          <text class="lucky-button__text">{{ isPlaying ? 'Spinning' : 'Draw now' }}</text>
        </view>
      </template>
    </SnLucky>
    <text class="sn-demo__meta">The slot scope provides isPlaying</text>
  </view>
</template>
