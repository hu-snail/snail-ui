<script setup lang="ts">
/**
 * Demo: sn-lucky (uni-end) — 网格规模：rows / cols。
 */
import SnLucky from '@snui/uni-x/components/sn-lucky/sn-lucky.uvue';
import type { SnLuckyPrize } from '@snui/uni-x/components/sn-lucky/sn-lucky-types';
const grid3Prizes: SnLuckyPrize[] = [
  { name: '一等奖' },
  { name: '优惠券' },
  { name: '积分' },
  { name: '谢谢参与' },
  { name: '红包' },
  { name: '实物奖' },
  { name: '再来一次' },
  { name: '免单券' },
];

const grid4Prizes: SnLuckyPrize[] = [
  { name: '一等奖' },
  { name: '优惠券' },
  { name: '积分' },
  { name: '谢谢参与' },
  { name: '红包' },
  { name: '实物奖' },
  { name: '再来一次' },
  { name: '免单券' },
  { name: '加购券' },
  { name: '满减券' },
  { name: '新人礼' },
  { name: '周边盲盒' },
];

const grid3Ref = ref<InstanceType<typeof SnLucky> | null>(null);
const grid4Ref = ref<InstanceType<typeof SnLucky> | null>(null);

const settleTimers: ReturnType<typeof setTimeout>[] = [];

/** start 后宿主异步决定结果：统一延迟 1s 随机 stop。 */
function scheduleStop(lucky: InstanceType<typeof SnLucky> | null, count: number): void {
  settleTimers.push(
    setTimeout(() => {
      lucky?.stop(Math.floor(Math.random() * count));
    }, 1000),
  );
}
</script>
<template>
  <view class="sn-demo sn-demo--column">
    <text class="sn-demo__title">rows=3 cols=3（8 个周长奖品格）</text>
    <SnLucky
      ref="grid3Ref"
      :prizes="grid3Prizes"
      :rows="3"
      :cols="3"
      :speed="50"
      @start="scheduleStop(grid3Ref, grid3Prizes.length)"
    />

    <text class="sn-demo__title">rows=4 cols=4（12 个周长奖品格）</text>
    <SnLucky
      ref="grid4Ref"
      :prizes="grid4Prizes"
      :rows="4"
      :cols="4"
      :speed="50"
      @start="scheduleStop(grid4Ref, grid4Prizes.length)"
    />
    <text class="sn-demo__meta">周长格子数 = 2(rows+cols) - 4</text>
  </view>
</template>
<style scoped>
.sn-demo__title {
  font-size: var(--sn-mp-font-size-sm);
  font-weight: var(--sn-mp-font-weight-semibold);
  color: var(--sn-mp-color-text-secondary);
}

.sn-demo__meta {
  font-size: var(--sn-mp-font-size-sm);
  color: var(--sn-mp-color-text-tertiary);
}
</style>