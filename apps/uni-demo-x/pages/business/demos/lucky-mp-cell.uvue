<script setup lang="ts">
/**
 * Demo: sn-lucky (uni-end) — 格子间距与高度：gutter / cellHeight。
 */
import type { SnLuckyPrize } from '@snui/uni-x/components/sn-lucky/sn-lucky-types';
const prizes: SnLuckyPrize[] = [
  { name: '一等奖' },
  { name: '优惠券' },
  { name: '积分' },
  { name: '谢谢参与' },
  { name: '红包' },
  { name: '实物奖' },
  { name: '再来一次' },
  { name: '免单券' },
];

const bigCellRef = ref<InstanceType<typeof SnLucky> | null>(null);

const settleTimers: ReturnType<typeof setTimeout>[] = [];

function scheduleStop(lucky: InstanceType<typeof SnLucky> | null, count: number): void {
  settleTimers.push(
    setTimeout(() => {
      lucky?.stop(Math.floor(Math.random() * count));
    }, 1000),
  );
}
</script>
<template>
  <view class="sn-demo sn-demo--column">
    <text class="sn-demo__title">gutter="16rpx" + cell-height="150rpx"</text>
    <SnLucky
      ref="bigCellRef"
      :prizes="prizes"
      gutter="16rpx"
      cell-height="150rpx"
      :speed="60"
      @start="scheduleStop(bigCellRef, prizes.length)"
    />
    <text class="sn-demo__meta">点击中间按钮起转，1s 后随机落定</text>
  </view>
</template>
<style scoped>
.sn-demo__title {
  font-size: var(--sn-mp-font-size-sm);
  font-weight: var(--sn-mp-font-weight-semibold);
  color: var(--sn-mp-color-text-secondary);
}

.sn-demo__meta {
  font-size: var(--sn-mp-font-size-sm);
  color: var(--sn-mp-color-text-tertiary);
}
</style>