<script setup lang="ts">
/** Demo: sn-select-picker — scroll into view: `scrollIntoView` scrolls the selected row into view on open; `customContentClass` restyles the content area. */
const options = [
  { value: 'apple', label: 'Apple' },
  { value: 'banana', label: 'Banana' },
  { value: 'cherry', label: 'Cherry' },
];

const scrolled = ref<Array<string | number | boolean>>(['cherry']);
const open = ref(false);
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <text class="sn-demo__title">scrollIntoView + customContentClass</text>
    <view class="sn-demo__button" @click="open = true"><text>Scroll into view</text></view>
    <SnSelectPicker
      v-model="scrolled"
      v-model:visible="open"
      :columns="options"
      :scroll-into-view="true"
      custom-content-class="sn-demo__content"
      title="Scroll into view"
    />
  </view>
</template>
