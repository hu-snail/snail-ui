<script setup lang="ts">
/** Demo: sn-picker-view — `#option` 插槽画每行虚线时间槽盒：选中行实线主题框，远行按 distance 淡出。 */
import SnPickerView from '@snui/uni-x/components/sn-picker-view/sn-picker-view.uvue';
const slots = ['12:30pm', '1:00pm', '1:30pm', '2:00pm', '2:30pm'];
const value = ref<Array<string | number>>(['1:30pm']);
</script>
<template>
  <view class="sn-demo sn-demo--column">
    <SnPickerView v-model="value" :columns="[slots]" :visible-item-count="5" :item-height="56">
      <template #option="{ option, active, distance }">
        <view
          class="slot-box"
          :class="[`slot-box--d${Math.min(distance, 2)}`, { 'slot-box--active': active }]"
        >
          <text class="slot-box__label">{{ option.label }}</text>
        </view>
      </template>
    </SnPickerView>
    <text class="sn-demo__meta">已选：{{ value[0] }}（虚线盒 + 实线选中框，远行按距离淡出）</text>
  </view>
</template>
