<script setup lang="ts">
/** Demo: sn-picker — 滚动即写回：immediateChange 让滚动过程持续写回 v-model，不等确认。 */
import SnPicker from '@snui/uni-x/components/sn-picker/sn-picker.uvue';
const fruits = ['苹果', '香蕉', '樱桃', '西瓜', '葡萄'];

const instant = ref<Array<string | number>>(['香蕉']);
const open = ref(false);
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <text class="sn-demo__title">immediateChange</text>
    <view class="sn-demo__button" @click="open = true"><text>滚动即写回</text></view>
    <text class="sn-demo__meta">已选：{{ instant.join(' / ') }}</text>
    <SnPicker
      v-model="instant"
      v-model:visible="open"
      :columns="[fruits]"
      title="滚动即写回"
      immediate-change
    />
  </view>
</template>
