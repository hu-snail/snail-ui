<script setup lang="ts">
/**
 * Demo: sn-select-picker — sheet behavior & styling: closeOnClickModal scrim tap /
 * zIndex stacking / safeAreaInsetBottom / rootPortal teleport / customClass, customStyle chrome.
 */
import SnSelectPicker from '@snui/uni-x/components/sn-select-picker/sn-select-picker.uvue';
const options = [
  { value: 'apple', label: 'Apple' },
  { value: 'banana', label: 'Banana' },
  { value: 'cherry', label: 'Cherry' },
];

const sheet = ref<Array<string | number | boolean>>(['banana']);
const open = ref(false);
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <text class="sn-demo__title"
      >closeOnClickModal=false + zIndex + safeAreaInsetBottom + rootPortal + custom*</text
    >
    <view class="sn-demo__button" @click="open = true"><text>Sheet behavior</text></view>
    <SnSelectPicker
      v-model="sheet"
      v-model:visible="open"
      :columns="options"
      title="Sheet behavior"
      :close-on-click-modal="false"
      :safe-area-inset-bottom="false"
      :z-index="1150"
      root-portal
      custom-class="sn-demo__sheet"
      custom-style="border-radius: var(--sn-mp-radius-xl);"
    />
  </view>
</template>
