<script setup lang="ts">
/** Demo: sn-slider — 区间与刻度：range 双滑块返回 [start, end]；marks 支持对象形式。 */
import SnSlider from '@snui/uni-x/components/sn-slider/sn-slider.uvue';
const pair = ref<number[]>([20, 60]);
</script>
<template>
  <view class="sn-demo sn-demo--column">
    <SnSlider
      v-model="pair"
      range
      :min="0"
      :max="100"
      :step="10"
      :marks="{ 0: '0', 50: '50', 100: '100' }"
    />
    <text class="sn-demo__meta">区间：{{ pair[0] }} - {{ pair[1] }}</text>
  </view>
</template>
