<script setup lang="ts">
/** Demo: sn-slide-verify — 根节点样式：customClass / customStyle 落在根节点上。 */
import SnSlideVerify from '@snui/uni-x/components/sn-slide-verify/sn-slide-verify.uvue';
const state = ref('待验证');
const onSuccess = (): void => {
  state.value = '已通过';
};
const onFail = (): void => {
  state.value = '未通过';
};
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <SnSlideVerify
      custom-class="sn-demo__verify"
      custom-style="padding: 8rpx; border-radius: var(--sn-mp-radius-md); background-color: var(--sn-mp-color-background-soft);"
      @success="onSuccess"
      @fail="onFail"
    />
    <text class="sn-demo__meta">customClass / customStyle 落在根节点上</text>
    <text class="sn-demo__meta">状态：{{ state }}</text>
  </view>
</template>
<style scoped>
.sn-demo--stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  align-items: stretch;
  width: 100%;
}
.sn-demo__meta {
  color: var(--sn-mp-color-text-tertiary);
  font-size: var(--sn-mp-font-size-xs);
  line-height: var(--sn-mp-font-line-height-normal);
}
/* custom-class 落在 sn-slide-verify 根节点上，需要 :deep 穿透组件边界。 */
</style>