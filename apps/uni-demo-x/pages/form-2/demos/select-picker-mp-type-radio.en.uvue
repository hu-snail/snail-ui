<script setup lang="ts">
/** Demo: sn-select-picker — radio mode: `type="radio"` writes a scalar instead of an array. */
import SnSelectPicker from '@snui/uni-x/components/sn-select-picker/sn-select-picker.uvue';
const options = [
  { value: 'apple', label: 'Apple' },
  { value: 'banana', label: 'Banana' },
  { value: 'cherry', label: 'Cherry' },
];
const single = ref<string | number | boolean>('apple');
const open = ref(false);
</script>
<template>
  <view class="sn-demo sn-demo--column">
    <view class="sn-demo__button" @click="open = true"><text>Radio</text></view>
    <text class="sn-demo__meta">Selected: {{ single || '(none)' }}</text>
    <SnSelectPicker
      v-model="single"
      v-model:visible="open"
      :columns="options"
      type="radio"
      title="Radio"
    />
  </view>
</template>
