<script setup lang="ts">
/** Demo: sn-select-picker — checked color: `checkedColor` overrides the accent of the checked row. */
const options = [
  { value: 'apple', label: 'Apple' },
  { value: 'banana', label: 'Banana' },
  { value: 'cherry', label: 'Cherry' },
];

const colored = ref<Array<string | number | boolean>>(['apple']);
const open = ref(false);
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <text class="sn-demo__title">checkedColor</text>
    <view class="sn-demo__button" @click="open = true"><text>Custom accent</text></view>
    <text class="sn-demo__meta">Selected: {{ colored.join(' / ') || '(not selected)' }}</text>
    <SnSelectPicker
      v-model="colored"
      v-model:visible="open"
      :columns="options"
      checked-color="var(--sn-mp-color-feedback-success)"
      title="Checked color"
    />
  </view>
</template>
