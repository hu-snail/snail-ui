<script setup lang="ts">
/**
 * Demo: sn-select-picker — chip size & confirm: `selectSize` picks the chip size,
 * `showConfirm=false` hides the confirm button and `confirmButtonText` overrides its label.
 */
const cities = [
  { id: 'sh', name: 'Shanghai' },
  { id: 'bj', name: 'Beijing' },
  { id: 'gz', name: 'Guangzhou' },
];

const mini = ref<Array<string | number | boolean>>(['sh']);
const openMini = ref(false);

const large = ref<Array<string | number | boolean>>([]);
const openLarge = ref(false);
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <text class="sn-demo__title">selectSize="mini" + confirmButtonText</text>
    <view class="sn-demo__button" @click="openMini = true"><text>mini chips</text></view>
    <SnSelectPicker
      v-model="mini"
      v-model:visible="openMini"
      :columns="cities"
      value-key="id"
      label-key="name"
      select-size="mini"
      confirm-button-text="Use these"
      title="mini chips"
    />

    <text class="sn-demo__title">selectSize="large" + showConfirm=false</text>
    <view class="sn-demo__button" @click="openLarge = true"><text>large chips / no confirm</text></view>
    <SnSelectPicker
      v-model="large"
      v-model:visible="openLarge"
      :columns="cities"
      value-key="id"
      label-key="name"
      select-size="large"
      :show-confirm="false"
      :max="2"
      title="large chips / no confirm"
    />
  </view>
</template>
