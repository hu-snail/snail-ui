<script setup lang="ts">
/** Demo: sn-select-picker — 单选模式：type="radio" 写回标量（不是数组）。 */
import SnSelectPicker from '@snui/uni-x/components/sn-select-picker/sn-select-picker.uvue';
const options = [
  { value: 'apple', label: '苹果' },
  { value: 'banana', label: '香蕉' },
  { value: 'cherry', label: '樱桃' },
];
const single = ref<string | number | boolean>('apple');
const open = ref(false);
</script>
<template>
  <view class="sn-demo sn-demo--column">
    <view class="sn-demo__button" @click="open = true"><text>单选</text></view>
    <text class="sn-demo__meta">已选：{{ single || '（未选择）' }}</text>
    <SnSelectPicker
      v-model="single"
      v-model:visible="open"
      :columns="options"
      type="radio"
      title="单选"
    />
  </view>
</template>
