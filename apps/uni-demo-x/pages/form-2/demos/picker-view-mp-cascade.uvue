<script setup lang="ts">
/** Demo: sn-picker-view — cascade 模式下 columns 传树形结构，组件按已选路径推导后续列。 */
import SnPickerView from '@snui/uni-x/components/sn-picker-view/sn-picker-view.uvue';
const tree = [
  {
    value: 'zj',
    label: '浙江',
    children: [
      { value: 'hz', label: '杭州' },
      { value: 'nb', label: '宁波' },
    ],
  },
  { value: 'js', label: '江苏', children: [{ value: 'nj', label: '南京' }] },
];
const region = ref<Array<string | number>>(['zj', 'hz']);
</script>
<template>
  <view class="sn-demo sn-demo--column">
    <SnPickerView v-model="region" :columns="tree" cascade />
    <text class="sn-demo__meta">已选：{{ region.join(' / ') }}</text>
  </view>
</template>
<style scoped>
.sn-demo__meta {
  font-size: 24rpx;
  color: var(--sn-mp-color-text-tertiary);
}
</style>