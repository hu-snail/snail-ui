<script setup lang="ts">
/**
 * Demo: sn-select-picker — chip 尺寸与确认：selectSize 控制 chip 尺寸档位，
 * showConfirm=false 隐藏确认按钮，confirmButtonText 覆盖确认文案。
 */
import SnSelectPicker from '@snui/uni-x/components/sn-select-picker/sn-select-picker.uvue';
const cities = [
  { id: 'sh', name: '上海' },
  { id: 'bj', name: '北京' },
  { id: 'gz', name: '广州' },
];

const mini = ref<Array<string | number | boolean>>(['sh']);
const openMini = ref(false);

const large = ref<Array<string | number | boolean>>([]);
const openLarge = ref(false);
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <text class="sn-demo__title">selectSize="mini" + confirmButtonText</text>
    <view class="sn-demo__button" @click="openMini = true"><text>mini chip</text></view>
    <SnSelectPicker
      v-model="mini"
      v-model:visible="openMini"
      :columns="cities"
      value-key="id"
      label-key="name"
      select-size="mini"
      confirm-button-text="就这些"
      title="mini chip"
    />

    <text class="sn-demo__title">selectSize="large" + showConfirm=false</text>
    <view class="sn-demo__button" @click="openLarge = true"><text>large chip / 无确认</text></view>
    <SnSelectPicker
      v-model="large"
      v-model:visible="openLarge"
      :columns="cities"
      value-key="id"
      label-key="name"
      select-size="large"
      :show-confirm="false"
      :max="2"
      title="large chip / 无确认"
    />
  </view>
</template>
