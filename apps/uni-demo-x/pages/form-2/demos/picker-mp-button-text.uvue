<script setup lang="ts">
/** Demo: sn-picker — 按钮文案：cancelButtonText / confirmButtonText 覆盖取消与确认按钮。 */
const fruits = ['苹果', '香蕉', '樱桃', '西瓜', '葡萄'];

const fruit = ref<Array<string | number>>(['苹果']);
const open = ref(false);
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <text class="sn-demo__title">cancelButtonText="先不选" + confirmButtonText="就它"</text>
    <view class="sn-demo__button" @click="open = true"><text>自定义按钮文案</text></view>
    <text class="sn-demo__meta">已选：{{ fruit.join(' / ') || '（未选择）' }}</text>
    <SnPicker
      v-model="fruit"
      v-model:visible="open"
      :columns="[fruits]"
      title="选个水果"
      cancel-button-text="先不选"
      confirm-button-text="就它"
    />
  </view>
</template>
