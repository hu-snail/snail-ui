<script setup lang="ts">
/** Demo: sn-select-picker — 可搜索：filterable 打开搜索框按 label 过滤，filterPlaceholder 自定占位文案。 */
import SnSelectPicker from '@snui/uni-x/components/sn-select-picker/sn-select-picker.uvue';
const options = [
  { value: 'apple', label: '苹果' },
  { value: 'banana', label: '香蕉' },
  { value: 'cherry', label: '樱桃' },
];
const filtered = ref<Array<string | number | boolean>>([]);
const open = ref(false);
</script>
<template>
  <view class="sn-demo sn-demo--column">
    <view class="sn-demo__button" @click="open = true"><text>可搜索</text></view>
    <text class="sn-demo__meta">已选：{{ filtered.join(' / ') || '（未选择）' }}</text>
    <SnSelectPicker
      v-model="filtered"
      v-model:visible="open"
      :columns="options"
      filterable
      filter-placeholder="搜索水果"
      title="可搜索"
    />
  </view>
</template>
