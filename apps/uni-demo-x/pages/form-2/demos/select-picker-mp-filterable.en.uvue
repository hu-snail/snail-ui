<script setup lang="ts">
/** Demo: sn-select-picker — filterable: a search box filters the options on the label; `filterPlaceholder` customizes its hint. */
import SnSelectPicker from '@snui/uni-x/components/sn-select-picker/sn-select-picker.uvue';
const options = [
  { value: 'apple', label: 'Apple' },
  { value: 'banana', label: 'Banana' },
  { value: 'cherry', label: 'Cherry' },
];
const filtered = ref<Array<string | number | boolean>>([]);
const open = ref(false);
</script>
<template>
  <view class="sn-demo sn-demo--column">
    <view class="sn-demo__button" @click="open = true"><text>Filterable</text></view>
    <text class="sn-demo__meta">Selected: {{ filtered.join(' / ') || '(not selected)' }}</text>
    <SnSelectPicker
      v-model="filtered"
      v-model:visible="open"
      :columns="options"
      filterable
      filter-placeholder="Search fruits"
      title="Filterable"
    />
  </view>
</template>
