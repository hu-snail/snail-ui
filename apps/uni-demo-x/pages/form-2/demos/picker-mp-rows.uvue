<script setup lang="ts">
/** Demo: sn-picker — 滚筒几何：itemHeight 行高 / visibleItemCount 可见行数，customViewClass 微调滚筒。 */
const fruits = ['苹果', '香蕉', '樱桃', '西瓜', '葡萄'];

const tall = ref<Array<string | number>>(['苹果']);
const open = ref(false);
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <text class="sn-demo__title">itemHeight=52 + visibleItemCount=5 + customViewClass</text>
    <view class="sn-demo__button" @click="open = true"><text>大行高</text></view>
    <text class="sn-demo__meta">已选：{{ tall.join(' / ') }}</text>
    <SnPicker
      v-model="tall"
      v-model:visible="open"
      :columns="[fruits]"
      title="大行高"
      :item-height="52"
      :visible-item-count="5"
      custom-view-class="sn-demo__roller"
    />
  </view>
</template>
