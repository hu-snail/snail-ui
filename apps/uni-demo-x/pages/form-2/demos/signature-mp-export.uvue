<script setup lang="ts">
/**
 * Demo: sn-signature — 导出参数。
 * fileType / quality / exportScale 为与 wd-signature 对齐而声明；本构建不做栅格化，
 * 导出由宿主在 confirm 回调里完成，因此这些参数不会改变画板行为。
 */
const strokes = ref(0);
const onConfirm = (result: { paths: unknown[] }) => {
  strokes.value = result.paths.length;
};
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <text class="sn-demo__title">fileType / quality / exportScale（宿主导出时使用）</text>
    <SnSignature
      file-type="png"
      :quality="0.92"
      :export-scale="2"
      confirm-text="导出 PNG"
      @confirm="onConfirm"
    />
    <text class="sn-demo__meta">笔画数：{{ strokes }}</text>
  </view>
</template>
<style scoped>
.sn-demo__title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--sn-mp-color-text-secondary);
}

.sn-demo__meta {
  font-size: 24rpx;
  color: var(--sn-mp-color-text-tertiary);
}
</style>