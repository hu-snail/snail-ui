<script setup lang="ts">
/** Demo: sn-wheel-picker — 块自定义：多列共享带 vs 分列带（`wheelBand`）+ 渐变带漆。 */
import SnWheelPicker from '@snui/uni-x/components/sn-wheel-picker/sn-wheel-picker.uvue';
const hours = [0, 1, 2, 3, 4];
const minutes = [20, 21, 22, 23, 24];
const value = ref<Array<string | number>>([2, 22]);
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <text class="sn-demo__title">shared（默认）—— 一整条横跨全部列 + 渐变带漆</text>
    <SnWheelPicker
      v-model="value"
      :columns="[hours, minutes]"
      :visible-item-count="5"
      custom-style="--sn-picker-view-wheel-band: linear-gradient(90deg, var(--sn-mp-color-lightblue-soft), var(--sn-mp-color-action-primary-soft))"
    />
    <text class="sn-demo__title">perColumn —— 每列一条独立带</text>
    <SnWheelPicker
      v-model="value"
      :columns="[hours, minutes]"
      wheel-band="perColumn"
      :visible-item-count="5"
      custom-style="--sn-picker-view-wheel-inset: 24rpx; --sn-picker-view-wheel-radius: 24rpx"
    />
    <text class="sn-demo__meta">已选：{{ value.join(' : ') }}（带形态 / 漆色 / 圆角 / 内边距均可自定义）</text>
  </view>
</template>
