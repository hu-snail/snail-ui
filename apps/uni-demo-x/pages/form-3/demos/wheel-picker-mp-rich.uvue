          <text class="rich-row__title" :class="{ 'rich-row__title--active': active }">
            {{ option.label }}
          </text>
          <text class="rich-row__code" :class="{ 'rich-row__code--active': active }">
            {{ String(option.raw.code) }}
          </text>
