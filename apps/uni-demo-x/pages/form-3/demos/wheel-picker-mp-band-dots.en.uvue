<script setup lang="ts">
/** Demo: sn-wheel-picker — band customization: the `#band` slot paints a dotted texture pill (soft blue + dot grid + border). */
import SnWheelPicker from '@snui/uni-x/components/sn-wheel-picker/sn-wheel-picker.uvue';
import SnPickerView from '@snui/uni-x/components/sn-picker-view/sn-picker-view.uvue';
const minutes = [15, 20, 25, 30, 45];
const value = ref<Array<string | number>>([25]);
</script>
<template>
  <view class="sn-demo sn-demo--column">
    <!-- #ifndef MP-WEIXIN -->
    <SnWheelPicker
      v-model="value"
      :columns="[minutes]"
      :visible-item-count="5"
      :item-height="56"
      custom-style="--sn-picker-view-wheel-inset: 185rpx; --sn-picker-view-wheel-radius: 56rpx; --sn-picker-view-wheel-band: var(--sn-mp-color-lightblue-soft)"
    >
      <template #band>
        <view class="dotted-band">
          <view v-for="dot in 150" :key="dot" class="dotted-band__dot" />
        </view>
      </template>
    </SnWheelPicker>
    <!-- #endif -->
    <!-- #ifdef MP-WEIXIN -->
    <SnPickerView
      v-model="value"
      :columns="[minutes]"
      :visible-item-count="5"
      :item-height="56"
      custom-style="--sn-picker-view-wheel-inset: 185rpx; --sn-picker-view-wheel-radius: 28rpx; --sn-picker-view-wheel-band: var(--sn-mp-color-lightblue-soft)"
    
      wheel
      vibrate-short>
      <template #band>
        <view class="dotted-band">
          <view v-for="dot in 96" :key="dot" class="dotted-band__dot" />
        </view>
      </template>
    </SnPickerView>
    <!-- #endif -->
    <text class="sn-demo__meta">Selected: {{ value[0] }} min (#band slot: dotted texture pill)</text>
  </view>
</template>
