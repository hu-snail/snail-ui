<script setup lang="ts">
/**
 * Demo: sn-tour — 层级与时长（duration / z-index / custom-class）。
 *
 * - `duration` 参与 `--snui-tour-duration`（非 300 时才写入根节点）
 * - `z-index` / `custom-class` / `custom-style` 落在根节点
 *
 * 预览专用：真实运行时的根节点是 `position: fixed`，会盖住整页；
 * `custom-class` 落到根节点，把预览里的引导层固定到这块 stage 内。
 */
import SnTour from '@snui/uni-x/components/sn-tour/sn-tour.uvue';
const visible = ref(false);
const current = ref(0);
const steps = [{ content: 'duration=150 + z-index=60。' }, { content: '第二步。' }];
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <view class="sn-demo__stage">
      <text class="sn-demo__button" @click="visible = true">打开引导</text>

      <SnTour
        v-model="visible"
        v-model:current="current"
        :steps="steps"
        :duration="150"
        :z-index="60"
        custom-class="sn-demo-contained"
      />
    </view>

    <text class="sn-demo__meta">duration=150 覆盖动画时长；z-index=60 抬升层级。</text>
  </view>
</template>
