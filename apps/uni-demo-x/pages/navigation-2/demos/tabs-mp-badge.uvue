<script setup lang="ts">
/**
 * Demo: sn-tabs — 角标（badge-props）。
 *
 * `badge-props` 透传给 `sn-badge`，对齐 wd-tab 的同名 prop：
 *   - `value` 数字 / 字符串；数字超过 `max` 显示 `{max}+`
 *   - `isDot` 只画一个点，不显示数字
 *   - `type` 语义色 primary / success / warning / danger / info（默认危险红）
 *   - `showZero` 让 `0` 也渲染出来（默认 0 不显示角标）
 *   - `hidden` 隐藏角标但保留内容
 */
import SnTabs from '@snui/uni-x/components/sn-tabs/sn-tabs.uvue';
import SnTab from '@snui/uni-x/components/sn-tabs/sn-tab.uvue';
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
const active = ref(0);
const unread = ref(12);
const showZero = ref(false);
const hidden = ref(false);
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <text class="sn-demo__label">数字角标与语义色</text>
    <SnTabs v-model="active">
      <SnTab title="消息" :name="0" :badge-props="{ value: unread }"><text>消息列表</text></SnTab>
      <SnTab title="待办" :name="1" :badge-props="{ value: 128, max: 99, type: 'primary' }"><text>
        待办事项
      </text></SnTab>
      <SnTab title="提醒" :name="2" :badge-props="{ value: 5, type: 'warning' }"><text>提醒列表</text></SnTab>
      <SnTab title="异常" :name="3" :badge-props="{ value: 2, type: 'danger' }"><text>异常记录</text></SnTab>
    </SnTabs>

    <text class="sn-demo__label">点状角标 / 零值 / 隐藏</text>
    <SnTabs v-model="active" type="tag" active-theme="fill">
      <SnTab title="动态" :name="0" :badge-props="{ isDot: true, type: 'success' }"><text>动态流</text></SnTab>
      <SnTab title="草稿" :name="1" :badge-props="{ value: 0, showZero: showZero, type: 'info' }"><text>
        草稿箱
      </text></SnTab>
      <SnTab title="归档" :name="2" :badge-props="{ value: 9, hidden: hidden }"><text>归档记录</text></SnTab>
    </SnTabs>

    <view class="sn-demo__row">
      <SnButton size="small" @click="unread = unread === 12 ? 120 : 12"><text>
        未读数：{{ unread }}
      </text></SnButton>
      <SnButton size="small" @click="showZero = !showZero"><text>
        showZero：{{ showZero ? '开' : '关' }}
      </text></SnButton>
      <SnButton size="small" @click="hidden = !hidden"><text>
        hidden：{{ hidden ? '开' : '关' }}
      </text></SnButton>
    </view>

    <text class="sn-demo__meta">当前页签：{{ active }}</text>
  </view>
</template>
<style scoped>
.sn-demo--stack {
  display: flex;
  flex-direction: column;
  gap: var(--sn-mp-spacing-4);
  align-items: stretch;
}
.sn-demo__label {
  font-size: 24rpx;
  color: var(--sn-mp-color-text-secondary);
}
.sn-demo__row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sn-mp-spacing-3);
  align-items: center;
  flex-direction: row;
}
.sn-demo__meta {
  font-size: 24rpx;
  color: var(--sn-mp-color-text-tertiary);
}
</style>