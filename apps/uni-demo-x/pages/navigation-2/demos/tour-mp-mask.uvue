<script setup lang="ts">
/**
 * Demo: sn-tour — 蒙版（mask / mask-color）。
 *
 * - `mask` 关掉后只剩引导面板，没有蒙层
 * - `mask-color` 内联覆盖蒙版背景色（空串 = 令牌默认 `--sn-mp-color-background-overlay`）
 *
 * 预览专用：真实运行时的根节点是 `position: fixed`，会盖住整页；
 * `custom-class` 落到根节点，把预览里的引导层固定到这块 stage 内。
 */
const plainVisible = ref(false);
const plainCurrent = ref(0);
const plainSteps = [{ content: 'mask=false：没有蒙层，只有引导面板。' }, { content: '第二步。' }];

const tintedVisible = ref(false);
const tintedCurrent = ref(0);
const tintedSteps = [{ content: 'mask-color 覆盖蒙版底色。' }, { content: '第二步。' }];
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <view class="sn-demo__stage">
      <text class="sn-demo__button" @click="plainVisible = true">打开无蒙层引导</text>
      <text class="sn-demo__button" @click="tintedVisible = true">打开自定义蒙版色引导</text>

      <SnTour
        v-model="plainVisible"
        v-model:current="plainCurrent"
        :steps="plainSteps"
        :mask="false"
        custom-class="sn-demo-contained"
      />

      <SnTour
        v-model="tintedVisible"
        v-model:current="tintedCurrent"
        :steps="tintedSteps"
        mask-color="var(--sn-mp-color-background-overlay)"
        custom-class="sn-demo-contained"
      />
    </view>

    <text class="sn-demo__meta">步骤：{{ plainCurrent + 1 }} / {{ tintedCurrent + 1 }}</text>
  </view>
</template>
