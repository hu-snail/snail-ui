      <SnStep title="发货" description="待处理" />
    </SnSteps>

    <text class="sn-demo__label">connector="dashed"（虚线）</text>
    <SnSteps :active="1" connector="dashed" align-center>
      <SnStep title="下单" description="09:00" />
      <SnStep title="支付" description="09:05" />
      <SnStep title="发货" description="待处理" />
