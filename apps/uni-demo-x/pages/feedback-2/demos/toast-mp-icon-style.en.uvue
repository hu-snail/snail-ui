<script setup lang="ts">
/**
 * Demo: sn-toast (uni-end) — English shadow of toast-mp-icon-style.
 */
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
import SnToast from '@snui/uni-x/components/sn-toast/sn-toast.uvue';
const iconSized = ref(false);
const loadingSized = ref(false);
</script>
<template>
  <!-- stack 由内层 view 承载：MP-WEIXIN 页面级 `.demo-host[class] { display: block }`
       编译后特异性高于 demo 根的 scoped 规则，根上声明的 flex + gap 会被拍平
       成块流（按钮间距全失）。内层 view 带不上 demo-host，页面规则碰不到它。 -->
  <view class="sn-demo">
    <view class="sn-demo--stack">
      <SnButton type="success" block @click="iconSized = true"><text> icon-size / icon-color </text></SnButton>
      <SnButton block @click="loadingSized = true"><text> loading-size / loading-color </text></SnButton>

      <SnToast
        v-model="iconSized"
        msg="Larger, recolored status glyph"
        icon-name="success"
        :icon-size="72"
        icon-color="var(--sn-mp-color-feedback-success)"
        custom-class="sn-demo-contained"
      />

      <SnToast
        v-model="loadingSized"
        msg="Larger, recolored spinner"
        icon-name="loading"
        :loading-size="64"
        loading-color="var(--sn-mp-color-feedback-warning)"
        direction="vertical"
        :duration="2000"
        custom-class="sn-demo-contained"
      />
    </view>
  </view>
</template>
<style scoped>
.sn-demo--stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
</style>