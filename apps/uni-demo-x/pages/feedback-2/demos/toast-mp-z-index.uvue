  <view class="sn-demo">
    <view class="sn-demo--stack">
      <SnButton block @click="styled = true"><text> z-index=300 + custom-style </text></SnButton>

      <SnToast
        v-model="styled"
        msg="z-index 与 custom-style"
        icon-name="info"
        :z-index="300"
        custom-style="padding: var(--sn-mp-spacing-5); border-radius: var(--sn-mp-radius-xl);"
        custom-class="sn-demo-contained"
      />
    </view>
  </view>
</template>
<style scoped>
.sn-demo--stack {
  display: flex;
