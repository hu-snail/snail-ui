<script setup lang="ts">
/**
 * Demo: sn-swipe-action (uni-end) — the before-close guard.
 * Per AUI-DOCS-016: imports the real @snui/uni sn-swipe-action from its SFC source.
 */
import SnSwipeAction from '@snui/uni-x/components/sn-swipe-action/sn-swipe-action.uvue';
import SnIcon from '@snui/uni-x/components/sn-icon/sn-icon.uvue';
import { Trash } from '@snui/uni-x/components/sn-icon/sn-icon-set';

const guarded = ref<'left' | 'close' | 'right'>('close');
const guardHits = ref(0);

/** Refuse the first close so the blocking behaviour is visible. */
function beforeClose(): boolean {
  guardHits.value += 1;
  return guardHits.value > 1;
}
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <SnSwipeAction v-model="guarded" :before-close="beforeClose">
      <view class="sw-card">
        <view class="sw-card__body">
          <text class="sw-card__title">before-close 拦截第一次关闭</text>
          <text class="sw-card__snippet">已调用 {{ guardHits }} 次</text>
        </view>
      </view>

      <template #right>
        <view class="sw-pillbar">
          <view class="sw-pill sw-pill--danger">
            <SnIcon :icon="Trash" :size="20" />
            <text class="sw-pill__label">删除</text>
          </view>
        </view>
      </template>
    </SnSwipeAction>
  </view>
</template>
