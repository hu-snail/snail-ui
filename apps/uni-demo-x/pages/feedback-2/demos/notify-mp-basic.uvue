<script setup lang="ts">
/**
 * Demo: sn-notify (uni-end) — component-form banner notification.
 * Per AUI-DOCS-016: imports the real @snui/uni sn-notify from its SFC source.
 * NOTE: only the component form ships this round — `useNotify()` is not implemented.
 */
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
import SnNotify from '@snui/uni-x/components/sn-notify/sn-notify.uvue';
const primaryOpen = ref(false);
const successOpen = ref(false);
const warningOpen = ref(false);
const dangerOpen = ref(false);
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <SnButton type="primary" block @click="primaryOpen = true"><text>primary</text></SnButton>
    <SnButton type="success" block @click="successOpen = true"><text>success</text></SnButton>
    <SnButton type="warning" block @click="warningOpen = true"><text>warning</text></SnButton>
    <SnButton type="danger" block @click="dangerOpen = true"><text>danger</text></SnButton>

    <SnNotify
      v-model:visible="primaryOpen"
      type="primary"
      message="这是一条普通通知"
      custom-class="sn-demo-contained"
    />
    <SnNotify
      v-model:visible="successOpen"
      type="success"
      message="保存成功"
      custom-class="sn-demo-contained"
    />
    <SnNotify
      v-model:visible="warningOpen"
      type="warning"
      message="额度即将用尽，请及时充值"
      custom-class="sn-demo-contained"
    />
    <SnNotify
      v-model:visible="dangerOpen"
      type="danger"
      message="网络异常，请稍后重试"
      custom-class="sn-demo-contained"
    />
  </view>
</template>
