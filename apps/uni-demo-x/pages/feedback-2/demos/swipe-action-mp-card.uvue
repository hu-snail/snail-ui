<script setup lang="ts">
/**
 * Demo: sn-swipe-action (uni-end) — floating card rows (iOS-mail style).
 * Per AUI-DOCS-016: imports the real @snui/uni sn-swipe-action from its SFC source.
 *
 * The row cards and the pill actions paint their own surfaces — the component
 * itself is background-free, so the page canvas shows through between the card
 * and the revealed button (reference: iOS Mail swipe interactions).
 */
import SnSwipeAction from '@snui/uni-x/components/sn-swipe-action/sn-swipe-action.uvue';
import SnIcon from '@snui/uni-x/components/sn-icon/sn-icon.uvue';
import { Mail } from '@snui/uni-x/components/sn-icon/sn-icon-set';

const openA = ref<'left' | 'close' | 'right'>('close');
const openB = ref<'left' | 'close' | 'right'>('close');
const openC = ref<'left' | 'close' | 'right'>('close');

/** 归档反馈：点按钮收起该行并计数。 */
const archived = ref({ a: false, b: false, c: false });

const archivedCount = computed(
  () => Object.values(archived.value).filter((hit) => hit).length,
);

function archive(key: 'a' | 'b' | 'c'): void {
  archived.value[key] = true;
  if (key === 'a') openA.value = 'close';
  if (key === 'b') openB.value = 'close';
  if (key === 'c') openC.value = 'close';
}
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <SnSwipeAction v-model="openA">
      <view class="sw-card">
        <view class="sw-card__avatar sw-card__avatar--a" />
        <view class="sw-card__body">
          <view class="sw-card__line">
            <text class="sw-card__title">设计组</text>
            <text class="sw-card__time">9:41</text>
          </view>
          <view class="sw-card__line">
            <text class="sw-card__snippet">Maya：新原型已推送</text>
            <view class="sw-card__badge"><text class="sw-card__badge-text">3</text></view>
          </view>
        </view>
      </view>

      <template #right>
        <view class="sw-pillbar">
          <view class="sw-pill sw-pill--primary" @click="archive('a')">
            <view class="sw-pill__content">
              <SnIcon :icon="Mail" :size="20" />
              <text class="sw-pill__label">归档</text>
            </view>
</view>
        </view>
      </template>
    </SnSwipeAction>

    <SnSwipeAction v-model="openB">
      <view class="sw-card">
        <view class="sw-card__avatar sw-card__avatar--b" />
        <view class="sw-card__body">
          <view class="sw-card__line">
            <text class="sw-card__title">Ava Thompson</text>
            <text class="sw-card__time">8:15</text>
          </view>
          <view class="sw-card__line">
            <text class="sw-card__snippet">季度规划议程已附上</text>
            <view class="sw-card__badge"><text class="sw-card__badge-text">1</text></view>
          </view>
        </view>
      </view>

      <template #right>
        <view class="sw-pillbar">
          <view class="sw-pill sw-pill--primary" @click="archive('b')">
            <view class="sw-pill__content">
              <SnIcon :icon="Mail" :size="20" />
              <text class="sw-pill__label">归档</text>
            </view>
</view>
        </view>
      </template>
    </SnSwipeAction>

    <SnSwipeAction v-model="openC">
      <view class="sw-card">
        <view class="sw-card__avatar sw-card__avatar--c" />
        <view class="sw-card__body">
          <view class="sw-card__line">
            <text class="sw-card__title">周末行程</text>
            <text class="sw-card__time">昨天</text>
          </view>
          <view class="sw-card__line">
            <text class="sw-card__snippet">Liam：周六的小屋订好了</text>
          </view>
        </view>
      </view>

      <template #right>
        <view class="sw-pillbar">
          <view class="sw-pill sw-pill--primary" @click="archive('c')">
            <view class="sw-pill__content">
              <SnIcon :icon="Mail" :size="20" />
              <text class="sw-pill__label">归档</text>
            </view>
</view>
        </view>
      </template>
    </SnSwipeAction>

    <text class="sw-meta">
      {{ archivedCount > 0 ? `已归档 ${archivedCount} 条` : '向左滑动卡片试试' }}
    </text>
  </view>
</template>
<style scoped>
.sn-demo--stack {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

/* 浮卡：表面由 demo 自绘，组件不画背景——滑开的钮缝露出页面画布。 */
.sw-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  margin: 20rpx 24rpx;
  padding: 28rpx 32rpx;
  border-radius: 32rpx;
  background-color: var(--sn-mp-color-background-elevated);
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.08);
}

.sw-card__avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
}

.sw-card__avatar--a {
  background-image: linear-gradient(135deg, #93c5fd, #6366f1);
}

.sw-card__avatar--b {
  background-image: linear-gradient(135deg, #fdba74, #f43f5e);
}

.sw-card__avatar--c {
  background-image: linear-gradient(135deg, #6ee7b7, #0ea5e9);
}

.sw-card__body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.sw-card__line {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.sw-card__title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--sn-mp-color-text-primary);
}

.sw-card__time {
  font-size: 24rpx;
  color: var(--sn-mp-color-text-tertiary);
}

.sw-card__snippet {
  font-size: 24rpx;
  color: var(--sn-mp-color-text-tertiary);
}

.sw-card__badge {
  padding: 2rpx 16rpx;
  border-radius: 999rpx;
  background-color: var(--sn-mp-color-action-primary);
}

.sw-card__badge-text {
  font-size: 22rpx;
  color: var(--sn-mp-color-text-on-primary);
}

/* 操作钮：圆角胶囊浮在行卡片后面，右缘留 24rpx 缝隙露画布。 */
.sw-pillbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding-right: 24rpx;
}

.sw-pill {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 136rpx;
  height: 132rpx;
  border-radius: 40rpx;
  color: var(--sn-mp-color-text-on-primary);
}

/* 图标 + 名称随遮挡距离渐显 / 渐隐（组件经 CSS var 发布进度，200ms 缓动跟手）。 */
.sw-pill__content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  opacity: var(--sn-swipe-action-reveal-right, 1);
  transition: opacity 200ms ease-out;
}

.sw-pill--primary {
  background-color: var(--sn-mp-color-action-primary);
}

.sw-pill__label {
  font-size: 22rpx;
}

.sw-meta {
  margin: 8rpx 24rpx 0;
  font-size: 24rpx;
  color: var(--sn-mp-color-text-tertiary);
}
</style>