<!-- gen-x: source apps/uni-demo/src/pages/feedback-2/demos/notify-mp-variant.vue sha256:6a0980a7626a9c26 —— 生成产物勿手改；源码改动后重跑 pnpm -F @snui/uni-demo-x gen -->
<script setup lang="ts">
/**
 * Demo: sn-notify (uni-end) — 多消息堆叠（deck 逐条露边）与底部锚点。
 * Per AUI-DOCS-016: imports the real @snui/uni sn-notify from its SFC source.
 */
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
import SnNotify from '@snui/uni-x/components/sn-notify/sn-notify.uvue';
import type { SnNotifyInstance } from '@snui/uni-x/components/sn-notify/sn-notify-types';

const top = ref<SnNotifyInstance | null>(null);
const bottom = ref<SnNotifyInstance | null>(null);

/** 连发三条：最新一条在前，旧卡片依次向下露出一条边。 */
function showStack(): void {
  top.value?.show({
    title: '第三条通知',
    description: '堆叠最深，只露出底部边缘',
    type: 'default',
  });
  top.value?.show({
    title: '第二条通知',
    description: '插队到中间，向下顺滑让位',
    type: 'warning',
  });
  top.value?.show({
    title: '最新一条通知',
    description: '从顶部丝滑滑入，盖在旧卡片上面',
    type: 'success',
  });
}

function showBottom(): void {
  bottom.value?.show({
    title: '已从底部滑入',
    description: '底部锚点向上堆叠，同样支持拖拽关闭',
    type: 'primary',
  });
}
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <SnButton type="primary" variant="soft" block @click="showStack"><text>连发三条（堆叠）</text></SnButton>
    <SnButton block variant="soft" @click="top?.hideAll()"><text>清空顶部通知</text></SnButton>
    <SnButton type="primary" variant="soft" block @click="showBottom"><text>底部弹出（position="bottom"）</text></SnButton>
    <SnButton block variant="soft" @click="bottom?.hideAll()"><text>清空底部通知</text></SnButton>

    <text class="sn-demo__meta">
      队列上限 maxVisible 默认 3：第 4 条进入时最旧的一条按 overflow 关闭；前端卡片
      支持左右滑动关闭。
    </text>

    <SnNotify ref="top" custom-class="sn-demo-contained" />
    <SnNotify ref="bottom" position="bottom" custom-class="sn-demo-contained" />
  </view>
</template>
<style scoped>
.sn-demo--stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.sn-demo__meta {
  color: var(--sn-mp-color-text-tertiary);
  font-size: var(--sn-mp-font-size-xs);
  line-height: var(--sn-mp-font-line-height-normal);
}
</style>