<script setup lang="ts">
/**
 * Demo: sn-notify (uni-end) — floating variant, closable, bottom anchor.
 * Per AUI-DOCS-016: imports the real @snui/uni sn-notify from its SFC source.
 */
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
import SnNotify from '@snui/uni-x/components/sn-notify/sn-notify.uvue';
const floatingOpen = ref(false);
const closableOpen = ref(false);
const bottomOpen = ref(false);
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <SnButton type="primary" block @click="floatingOpen = true"><text>floating 形态</text></SnButton>
    <SnButton block @click="closableOpen = true"><text>可关闭（closable）</text></SnButton>
    <SnButton block @click="bottomOpen = true"><text>底部弹出（position=&quot;bottom&quot;）</text></SnButton>

    <SnNotify
      v-model:visible="floatingOpen"
      type="success"
      variant="floating"
      message="悬浮卡片形态，自带圆角与阴影"
      custom-class="sn-demo-contained"
    />

    <SnNotify
      v-model:visible="closableOpen"
      type="warning"
      closable
      :duration="0"
      message="这条不会自动消失，点右侧关闭"
      custom-class="sn-demo-contained"
    />

    <SnNotify
      v-model:visible="bottomOpen"
      type="danger"
      position="bottom"
      message="从底部滑入的通知"
      custom-class="sn-demo-contained"
    />
  </view>
</template>
<style scoped>
.sn-demo--stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
</style>