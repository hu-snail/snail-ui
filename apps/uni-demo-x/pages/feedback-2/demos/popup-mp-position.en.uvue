<script setup lang="ts">
/**
 * Demo: sn-popup (uni-end) — the five anchors.
 * Per AUI-DOCS-016: imports the real @snui/uni sn-popup from its SFC source.
 */
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
import SnPopup from '@snui/uni-x/components/sn-popup/sn-popup.uvue';
type Anchor = 'center' | 'top' | 'right' | 'bottom' | 'left';

const open = ref(false);
const anchor = ref<Anchor>('bottom');

const anchors: Anchor[] = ['center', 'top', 'right', 'bottom', 'left'];

function show(position: Anchor): void {
  anchor.value = position;
  open.value = true;
}
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <view class="sn-popup-demo__row">
      <SnButton v-for="item in anchors" :key="item" size="small" @click="show(item)"><text>{{
        item
      }}</text></SnButton>
    </view>

    <SnPopup v-model="open" :position="anchor" round custom-class="sn-demo-contained">
      <view class="sn-popup-demo__body">
        <text class="sn-popup-demo__title">position = {{ anchor }}</text>
        <text class="sn-popup-demo__text"
          >The default animation follows the anchor: bottom → slide-up, left → slide-right.</text
        >
      </view>
    </SnPopup>
  </view>
</template>
<style scoped>
.sn-popup-demo__row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  flex-direction: row;
}
.sn-popup-demo__body {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.sn-popup-demo__title {
  font-size: 32rpx;
  font-weight: 600;
}
.sn-popup-demo__text {
  font-size: 28rpx;
  color: var(--vp-c-text-2);
}
/* H5 / WEB only — docs preview pins the fixed layer to the phone frame.
 * uni-app x App compiles this OUT: App-side `position: absolute` lays out in
 * the direct parent's content box (css/position) and the page class still
 * reaches the component root (style-isolation) — the rule would pin the
 * fullscreen fixed layer into the demo card and clip it (App overflow
 * defaults to hidden). */
/* #ifdef H5 || WEB */
.sn-popup.sn-demo-contained {
  position: absolute;
}
/* #endif */
</style>