<!-- gen-x: source apps/uni-demo/src/pages/feedback-2/demos/notify-mp-basic.en.vue sha256:14a56724aed1e1fc —— 生成产物勿手改；源码改动后重跑 pnpm -F @snui/uni-demo-x gen -->
<script setup lang="ts">
/**
 * Demo: sn-notify (uni-end) — semantic card notifications (default / primary /
 * success / warning / danger) + hide-all.
 * Per AUI-DOCS-016: imports the real @snui/uni sn-notify from its SFC source.
 */
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
import SnNotify from '@snui/uni-x/components/sn-notify/sn-notify.uvue';
import type { SnNotifyInstance, SnNotifyOptions } from '@snui/uni-x/components/sn-notify/sn-notify-types';

const notify = ref<SnNotifyInstance | null>(null);

const CASES: Array<SnNotifyOptions & { label: string }> = [
  {
    label: 'Default toast',
    title: 'Join a team',
    description: 'Junior Garcia sent you an invitation to join HeroUI team!',
  },
  {
    label: 'Accent toast',
    type: 'primary',
    title: 'You have 2 credits left',
    description: 'Get a paid plan for more credits',
  },
  {
    label: 'Success toast',
    type: 'success',
    title: 'Plan upgraded',
    description: 'You can continue using HeroUI Chat and more',
  },
  {
    label: 'Warning toast',
    type: 'warning',
    title: 'No credits left',
    description: 'Upgrade to a paid plan to continue using HeroUI Chat',
  },
  {
    label: 'Danger toast',
    type: 'danger',
    title: 'Network error',
    description: 'Request failed, check your connection and retry',
  },
];
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <SnButton
      v-for="item in CASES"
      :key="item.label"
      :type="item.type ?? 'default'"
      variant="soft"
      block
      @click="notify?.show(item)"
    ><text>
      {{ item.label }}
    </text></SnButton>
    <SnButton type="danger" variant="soft" block @click="notify?.hideAll()"><text>
      Hide all toasts
    </text></SnButton>

    <SnNotify ref="notify" custom-class="sn-demo-contained" />
  </view>
</template>
<style scoped>
.sn-demo--stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
</style>