<script setup lang="ts">
/**
 * Demo: sn-popup (uni-end) — modal-style / custom-style.
 * Per AUI-DOCS-016: imports the real @snui/uni sn-popup from its SFC source.
 */
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
import SnPopup from '@snui/uni-x/components/sn-popup/sn-popup.uvue';
const scrimStyle = ref(false);
const panelStyle = ref(false);
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <SnButton type="primary" block @click="scrimStyle = true"><text>modal-style（遮罩内联样式）</text></SnButton>
    <SnButton block @click="panelStyle = true"><text>custom-style（面板内联样式）</text></SnButton>

    <SnPopup
      v-model="scrimStyle"
      position="center"
      round
      modal-style="background-color: var(--sn-mp-color-background-subtle); opacity: 0.8;"
      custom-class="sn-demo-contained"
    >
      <view class="sn-demo__body">
        <text class="sn-demo__title">modalStyle</text>
        <text class="sn-demo__text">内联样式写在遮罩节点上，可叠加透明度或额外内边距。</text>
        <SnButton type="primary" block @click="scrimStyle = false"><text>关闭</text></SnButton>
      </view>
    </SnPopup>

    <SnPopup
      v-model="panelStyle"
      position="bottom"
      round
      custom-style="padding-bottom: var(--sn-mp-spacing-8);"
      custom-class="sn-demo-contained"
    >
      <view class="sn-demo__body">
        <text class="sn-demo__title">customStyle</text>
        <text class="sn-demo__text">custom-style 落在面板上。</text>
        <SnButton type="primary" block @click="panelStyle = false"><text>关闭</text></SnButton>
      </view>
    </SnPopup>
  </view>
</template>
