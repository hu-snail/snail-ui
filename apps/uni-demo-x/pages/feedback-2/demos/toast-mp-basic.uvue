<script setup lang="ts">
/**
 * Demo: sn-toast (uni-end) — component-form toast.
 * Per AUI-DOCS-016: imports the real @snui/uni sn-toast from its SFC source.
 * NOTE: only the component form ships this round — `useToast()` is not implemented.
 */
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
import SnToast from '@snui/uni-x/components/sn-toast/sn-toast.uvue';
const plainOpen = ref(false);
const successOpen = ref(false);
const verticalOpen = ref(false);
</script>
<template>
  <!-- stack 由内层 view 承载：MP-WEIXIN 页面级 `.demo-host[class] { display: block }`
       编译后特异性高于 demo 根的 scoped 规则，根上声明的 flex + gap 会被拍平
       成块流（按钮间距全失）。内层 view 带不上 demo-host，页面规则碰不到它。 -->
  <view class="sn-demo">
    <view class="sn-demo--stack">
      <SnButton type="primary" block @click="plainOpen = true"><text>纯文案（中间）</text></SnButton>
      <SnButton type="success" block @click="successOpen = true"><text>成功图标（顶部）</text></SnButton>
      <SnButton block @click="verticalOpen = true"><text>纵向排版（底部）</text></SnButton>

      <SnToast
        v-model="plainOpen"
        msg="已复制到剪贴板"
        :duration="1500"
        custom-class="sn-demo-contained"
      />

      <SnToast
        v-model="successOpen"
        msg="保存成功"
        icon-name="success"
        position="top"
        custom-class="sn-demo-contained"
      />

      <SnToast
        v-model="verticalOpen"
        msg="正在提交，请稍候"
        icon-name="loading"
        direction="vertical"
        position="bottom"
        :duration="2500"
        custom-class="sn-demo-contained"
        @click="verticalOpen = false"
      />
    </view>
  </view>
</template>
<style scoped>
.sn-demo--stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
</style>