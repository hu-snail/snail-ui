<script setup lang="ts">
/**
 * Demo: sn-popup (uni-end) — lock-scroll / z-index / hide-when-close.
 * Per AUI-DOCS-016: imports the real @snui/uni sn-popup from its SFC source.
 */
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
import SnPopup from '@snui/uni-x/components/sn-popup/sn-popup.uvue';
const scrollThrough = ref(false);
const keepNode = ref(false);
const leaving = ref(false);

const events = ref<string[]>([]);

function record(name: string): void {
  events.value = [...events.value.slice(-3), name];
}
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <SnButton type="primary" block @click="scrollThrough = true"><text>
      lock-scroll=false (page behind still scrolls)
    </text></SnButton>
    <SnButton block @click="keepNode = true"><text>
      hide-when-close=false (node kept after close)
    </text></SnButton>
    <SnButton block @click="leaving = true"><text>z-index=200 (high layer)</text></SnButton>

    <text v-if="events.length > 0" class="sn-demo__meta">
      Animation events: {{ events.join(' → ') }}
    </text>

    <SnPopup
      v-model="scrollThrough"
      position="bottom"
      round
      :lock-scroll="false"
      custom-class="sn-demo-contained"
    >
      <view class="sn-demo__body">
        <text class="sn-demo__title">lockScroll = false</text>
        <text class="sn-demo__text">
          The scrim no longer intercepts touchmove, so the page behind the panel keeps scrolling.
        </text>
        <SnButton type="primary" block @click="scrollThrough = false"><text>Close</text></SnButton>
      </view>
    </SnPopup>

    <SnPopup
      v-model="keepNode"
      position="center"
      round
      :hide-when-close="false"
      custom-class="sn-demo-contained"
      @after-leave="record('after-leave')"
    >
      <view class="sn-demo__body">
        <text class="sn-demo__title">hideWhenClose = false</text>
        <text class="sn-demo__text">
          The node stays in the tree after closing and only gains sn-popup--hidden (visibility:
          hidden).
        </text>
        <SnButton type="primary" block @click="keepNode = false"><text>Close</text></SnButton>
      </view>
    </SnPopup>

    <SnPopup
      v-model="leaving"
      position="right"
      round
      :z-index="200"
      custom-class="sn-demo-contained"
      @before-leave="record('before-leave')"
      @after-leave="record('after-leave')"
    >
      <view class="sn-demo__body">
        <text class="sn-demo__title">zIndex = 200</text>
        <text class="sn-demo__text">
          The stacking level comes from zIndex, so it can sit above other layers on the page.
        </text>
        <SnButton type="primary" block @click="leaving = false"><text>Close</text></SnButton>
      </view>
    </SnPopup>
  </view>
</template>
<style scoped>
.sn-demo--stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.sn-demo__body {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.sn-demo__title {
  color: var(--sn-mp-color-text-primary);
  font-size: var(--sn-mp-font-size-lg);
  font-weight: var(--sn-mp-font-weight-semibold);
}
.sn-demo__text, .sn-demo__meta {
  color: var(--sn-mp-color-text-secondary);
  font-size: var(--sn-mp-font-size-sm);
  line-height: var(--sn-mp-font-line-height-normal);
}
/* H5 / WEB only — docs preview pins the fixed layer to the phone frame.
 * uni-app x App compiles this OUT: App-side `position: absolute` lays out in
 * the direct parent's content box (css/position) and the page class still
 * reaches the component root (style-isolation) — the rule would pin the
 * fullscreen fixed layer into the demo card and clip it (App overflow
 * defaults to hidden). */
/* #ifdef H5 || WEB */
.sn-popup.sn-demo-contained {
  position: absolute;
}
/* #endif */
</style>