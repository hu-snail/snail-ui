<script setup lang="ts">
/**
 * Demo: sn-popup (uni-end) — lazy-render / safe-area-inset-bottom / root-portal.
 * Per AUI-DOCS-016: imports the real @snui/uni sn-popup from its SFC source.
 */
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
import SnPopup from '@snui/uni-x/components/sn-popup/sn-popup.uvue';
const eager = ref(false);
const noSafeArea = ref(false);
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <SnButton type="primary" block @click="eager = true"><text>lazy-render=false（提前渲染）</text></SnButton>
    <SnButton block @click="noSafeArea = true"><text>safe-area-inset-bottom（底部安全区）</text></SnButton>

    <text class="sn-demo__meta">
      lazy-render 默认 true，首次打开前不渲染面板内容；safe-area-inset-bottom 在面板底部叠加安全区
      留白；root-portal 仅为 wot-ui 对齐而声明，小程序没有 portal 宿主，传 true 不改变层级。
    </text>

    <SnPopup
      v-model="eager"
      position="center"
      round
      :lazy-render="false"
      custom-class="sn-demo-contained"
    >
      <view class="sn-demo__body">
        <text class="sn-demo__title">lazyRender = false</text>
        <text class="sn-demo__text">
          lazy-render 默认 true，首次打开前不渲染面板内容；置 false 后组件挂载即渲染。
        </text>
        <SnButton type="primary" block @click="eager = false"><text>关闭</text></SnButton>
      </view>
    </SnPopup>

    <SnPopup
      v-model="noSafeArea"
      position="bottom"
      round
      safe-area-inset-bottom
      :root-portal="true"
      custom-class="sn-demo-contained"
    >
      <view class="sn-demo__body">
        <text class="sn-demo__title">safeAreaInsetBottom</text>
        <text class="sn-demo__text">安全区留白叠加在面板底部。</text>
        <SnButton type="primary" block @click="noSafeArea = false"><text>关闭</text></SnButton>
      </view>
    </SnPopup>
  </view>
</template>
