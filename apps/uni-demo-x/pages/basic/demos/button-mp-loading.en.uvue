<!-- gen-x: source apps/uni-demo/src/pages/basic/demos/button-mp-loading.en.vue sha256:5f81638b7f6f6ed3 —— 生成产物勿手改；源码改动后重跑 pnpm -F @snui/uni-demo-x gen -->
<script setup lang="ts">
/**
 * Demo: sn-button (uni-end) — loading states in one module.
 * Spacing note: uni-app x has no flex `gap` support — inline `custom-style`
 * margins + explicit `flex-direction: row`.
 */
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
const loading = ref(false);
function trigger(): void {
  loading.value = true;
  setTimeout(() => {
    loading.value = false;
  }, 1000);
}

/** loading-props with both color + size (size in rpx). */
const spinnerFromProps = { color: 'var(--sn-mp-color-action-primary)', size: 48 };

/** In-row spacing fallback (uni-app x lacks gap). */
const rowGap = { margin: '0 16rpx 16rpx 0' };
</script>
<template>
  <view class="sn-mp-btn-stack">
    <text class="sn-mp-btn-label">Loading (loading × semantic hues)</text>
    <view class="sn-mp-btn-row">
      <SnButton :custom-style="rowGap" loading type="primary"><text>Saving</text></SnButton>
      <SnButton :custom-style="rowGap" loading type="success"><text>Submitting</text></SnButton>
      <SnButton :custom-style="rowGap" loading type="danger"><text>Deleting</text></SnButton>
      <SnButton :custom-style="rowGap" :loading="loading" type="primary" @click="trigger"><text>
        Click to trigger loading
      </text></SnButton>
    </view>

    <text class="sn-mp-btn-meta">loading-props with color only: the spinner takes the brand color</text>
    <view class="sn-mp-btn-row">
      <SnButton
        :custom-style="rowGap"
        type="primary"
        loading
        :loading-props="{ color: 'var(--sn-mp-color-feedback-success)' }"
      ><text>
        Brand spinner
      </text></SnButton>
      <SnButton :custom-style="rowGap" type="primary" loading><text>Default spinner</text></SnButton>
    </view>

    <text class="sn-mp-btn-meta">loading-props with color + size (size in rpx)</text>
    <view class="sn-mp-btn-row">
      <SnButton :custom-style="rowGap" type="success" loading :loading-props="spinnerFromProps"><text>
        Large spinner
      </text></SnButton>
      <SnButton :custom-style="rowGap" type="success" loading><text>Default-size spinner</text></SnButton>
    </view>

    <text class="sn-mp-btn-meta">Flat props win: loading-color / loading-size override loading-props</text>
    <view class="sn-mp-btn-row">
      <SnButton
        :custom-style="rowGap"
        type="warning"
        loading
        loading-color="var(--sn-mp-color-feedback-danger)"
        :loading-props="{ color: 'var(--sn-mp-color-action-primary)', size: 64 }"
      ><text>
        Flat props win
      </text></SnButton>
    </view>

    <text class="sn-mp-btn-meta">Direct loading-color / loading-size customization</text>
    <view class="sn-mp-btn-row">
      <SnButton
        :custom-style="rowGap"
        loading
        loading-color="var(--sn-mp-color-feedback-success)"
        type="primary"
      ><text>
        Custom color
      </text></SnButton>
      <SnButton :custom-style="rowGap" loading loading-size="48" type="success"><text>Custom size</text></SnButton>
    </view>
  </view>
</template>
<style scoped>
.sn-mp-btn-stack {
  display: flex;
  flex-direction: column;
}
.sn-mp-btn-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
}
.sn-mp-btn-label {
  margin-bottom: 12rpx;
  color: var(--sn-mp-color-text-secondary);
  font-size: var(--sn-mp-font-size-xs);
}
.sn-mp-btn-meta {
  margin-bottom: 12rpx;
  color: var(--sn-mp-color-text-tertiary);
  font-size: var(--sn-mp-font-size-xs);
  line-height: var(--sn-mp-font-line-height-normal);
}
</style>