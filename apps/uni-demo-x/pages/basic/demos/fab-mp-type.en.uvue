<script setup lang="ts">
/**
 * Demo: sn-fab (uni-end) — theme colour (`type`).
 *
 * The swatch row switches the FAB's `type` (5 themes, applied live); action
 * items are icon bubbles, tapping one records the feedback and collapses.
 *
 * Copy is kept in parity with fab-mp-type.vue.
 */
import { Coffee, Music, Zap } from '@snui/uni-x/components/sn-icon/sn-icon-set';

/** Mirrors the sn-fab `type` union; the component does not export the alias. */
type DemoFabType = 'primary' | 'success' | 'info' | 'warning' | 'danger';

const active = ref(false);
const fabType = ref<DemoFabType>('success');
const lastAction = ref('');

const typeOptions: Array<{ value: DemoFabType; label: string; color: string }> = [
  { value: 'primary', label: 'Primary', color: 'var(--sn-mp-color-action-primary)' },
  { value: 'success', label: 'Success', color: 'var(--sn-mp-color-feedback-success)' },
  { value: 'info', label: 'Info', color: 'var(--sn-mp-color-feedback-info)' },
  { value: 'warning', label: 'Warning', color: 'var(--sn-mp-color-feedback-warning)' },
  { value: 'danger', label: 'Danger', color: 'var(--sn-mp-color-feedback-danger)' },
];

function pick(label: string): void {
  lastAction.value = label;
  active.value = false;
}
</script>
<template>
  <view class="sn-demo sn-fab-demo__stage">
    <view class="sn-fab-demo__hint">
      <text class="sn-fab-demo__hint-title">Theme colour</text>
      <text class="sn-fab-demo__hint-text">
        Swatches switch the FAB's `type` live (5 themes). Last picked:
        {{ lastAction === '' ? 'none yet' : lastAction }}
      </text>
      <view class="sn-fab-demo__swatches" aria-label="Theme swatches">
        <view
          v-for="option in typeOptions"
          :key="option.value"
          class="sn-fab-demo__swatch"
          :class="{ 'sn-fab-demo__swatch--picked': option.value === fabType }"
          :style="{ backgroundColor: option.color }"
          role="button"
          :aria-label="`Theme ${option.label}`"
          @click="fabType = option.value"
        />
      </view>
    </view>

    <SnFab
      v-model:active="active"
      :type="fabType"
      position="right-bottom"
      direction="up"
      :gap="{ bottom: 16, right: 16 }"
      custom-class="sn-demo-contained"
    >
      <view class="sn-fab-demo__bubble" role="button" aria-label="Music" @click="pick('Music')">
        <SnIcon :icon="Music" size="var(--sn-mp-icon-size-large)" />
      </view>
      <view class="sn-fab-demo__bubble" role="button" aria-label="Coffee" @click="pick('Coffee')">
        <SnIcon :icon="Coffee" size="var(--sn-mp-icon-size-large)" />
      </view>
      <view
        class="sn-fab-demo__bubble"
        role="button"
        aria-label="Quick launch"
        @click="pick('Quick launch')"
      >
        <SnIcon :icon="Zap" size="var(--sn-mp-icon-size-large)" />
      </view>
    </SnFab>
  </view>
</template>
<style scoped>
.sn-fab-demo__stage {
  position: relative;
  width: 100%;
  height: 560rpx;
  overflow: hidden;
  border-radius: var(--sn-mp-radius-lg);
  background-color: var(--sn-mp-color-background-subtle);
}

.sn-fab-demo__hint {
  display: flex;
  flex-direction: column;
  gap: var(--sn-mp-spacing-1);
  padding: var(--sn-mp-spacing-4) var(--sn-mp-spacing-5) 0;
}

.sn-fab-demo__hint-title {
  font-size: var(--sn-mp-font-size-md);
  font-weight: 600;
  color: var(--sn-mp-color-text-primary);
}

.sn-fab-demo__hint-text {
  font-size: var(--sn-mp-font-size-sm);
  color: var(--sn-mp-color-text-secondary);
}

.sn-fab-demo__swatches {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--sn-mp-spacing-3);
  margin-top: var(--sn-mp-spacing-3);
}

.sn-fab-demo__swatch {
  width: 40rpx;
  height: 40rpx;
  border-radius: var(--sn-mp-radius-full);
  opacity: 0.45;
}

.sn-fab-demo__swatch--picked {
  opacity: 1;
  box-shadow: var(--sn-mp-shadow-sm);
}

.sn-fab-demo__bubble {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--sn-mp-radius-full);
  background-color: var(--sn-mp-color-background-elevated);
  box-shadow: var(--sn-mp-shadow-sm);
  color: var(--sn-mp-color-text-secondary);
}

/* Docs-preview only — pin the fixed layer to the phone screen. */
.sn-fab.sn-demo-contained {
  position: absolute;
}
</style>