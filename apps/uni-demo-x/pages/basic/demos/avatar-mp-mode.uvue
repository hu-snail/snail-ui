<script setup lang="ts">
/**
 * Demo: sn-avatar (uni-end) — 图片裁切（mode）+ 根节点样式（customClass / customStyle）。
 * Per AUI-DOCS-016: imports the real @snui/uni sn-avatar from its SFC source.
 * 素材用本地 600×400 横图（斜条纹 + 圆点标记方向）：aspectFill 居中裁切出
 * 中段，aspectFit 完整留白——弱网 / 离线也能稳定演示两种裁切。
 */
import SnAvatar from '@snui/uni-x/components/sn-avatar/sn-avatar.uvue';
const demo = '/static/avatar-mode.png';
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <text class="sn-demo__meta"
      >mode 透传给内部 &lt;image&gt;（aspectFill 裁切 / aspectFit 留白），素材
      600×400 横图。</text
    >
    <view class="sn-demo__row">
      <view class="sn-demo__cell">
        <SnAvatar :src="demo" mode="aspectFill" size="large" />
        <text class="sn-demo__label">aspectFill 裁切</text>
      </view>
      <view class="sn-demo__cell">
        <SnAvatar :src="demo" mode="aspectFit" size="large" />
        <text class="sn-demo__label">aspectFit 留白</text>
      </view>
    </view>

    <text class="sn-demo__meta"
      >customClass 挂在根节点（描边），customStyle 追加到根节点 inline style。</text
    >
    <view class="sn-demo__row">
      <SnAvatar
        text="CC"
        size="large"
        bg-color="var(--sn-mp-color-action-primary)"
        color="var(--sn-mp-color-text-on-primary)"
        custom-class="sn-avatar-demo__root"
        custom-style="box-shadow: var(--sn-mp-shadow-sm)"
      />
    </view>
  </view>
</template>
