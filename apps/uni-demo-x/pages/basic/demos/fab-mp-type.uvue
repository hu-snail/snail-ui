<script setup lang="ts">
/**
 * Demo: sn-fab (uni-end) — 主题色（`type`）。
 *
 * 色板切换 FAB 的 `type`（5 档主题色实时生效）；动作项为图标气泡，
 * 点气泡记录反馈并收起。
 *
 * 文案与 fab-mp-type.en.vue 对等。
 */
import SnFab from '@snui/uni-x/components/sn-fab/sn-fab.uvue';
import SnIcon from '@snui/uni-x/components/sn-icon/sn-icon.uvue';
import { Coffee, Music, Zap } from '@snui/uni-x/components/sn-icon/sn-icon-set';

/** Mirrors the sn-fab `type` union; the component does not export the alias. */
type DemoFabType = 'primary' | 'success' | 'info' | 'warning' | 'danger';

const active = ref(false);
const fabType = ref<DemoFabType>('success');
const lastAction = ref('');

const typeOptions: Array<{ value: DemoFabType; label: string; color: string }> = [
  { value: 'primary', label: '主色', color: 'var(--sn-mp-color-action-primary)' },
  { value: 'success', label: '成功', color: 'var(--sn-mp-color-feedback-success)' },
  { value: 'info', label: '信息', color: 'var(--sn-mp-color-feedback-info)' },
  { value: 'warning', label: '警告', color: 'var(--sn-mp-color-feedback-warning)' },
  { value: 'danger', label: '危险', color: 'var(--sn-mp-color-feedback-danger)' },
];

function pick(label: string): void {
  lastAction.value = label;
  active.value = false;
}
</script>
<template>
  <view class="sn-demo sn-fab-demo__stage">
    <view class="sn-fab-demo__hint">
      <text class="sn-fab-demo__hint-title">主题色</text>
      <text class="sn-fab-demo__hint-text">
        色板实时切换 FAB 的 `type`（5 档主题色）。最近选择：{{
          lastAction === '' ? '尚未选择' : lastAction
        }}
      </text>
      <view class="sn-fab-demo__swatches" aria-label="主题色板">
        <view
          v-for="option in typeOptions"
          :key="option.value"
          class="sn-fab-demo__swatch"
          :class="{ 'sn-fab-demo__swatch--picked': option.value === fabType }"
          :style="{ backgroundColor: option.color }"
          role="button"
          :aria-label="`主题 ${option.label}`"
          @click="fabType = option.value"
        />
      </view>
    </view>

    <SnFab
      v-model:active="active"
      :type="fabType"
      position="right-bottom"
      direction="up"
      :gap="{ bottom: 16, right: 16 }"
      custom-class="sn-demo-contained"
    >
      <view class="sn-fab-demo__bubble" role="button" aria-label="音乐" @click="pick('音乐')">
        <SnIcon :icon="Music" size="var(--sn-mp-icon-size-large)" />
      </view>
      <view class="sn-fab-demo__bubble" role="button" aria-label="咖啡" @click="pick('咖啡')">
        <SnIcon :icon="Coffee" size="var(--sn-mp-icon-size-large)" />
      </view>
      <view class="sn-fab-demo__bubble" role="button" aria-label="快捷启动" @click="pick('快捷启动')">
        <SnIcon :icon="Zap" size="var(--sn-mp-icon-size-large)" />
      </view>
    </SnFab>
  </view>
</template>
<style scoped>
.sn-fab-demo__stage {
  position: relative;
  width: 100%;
  height: 560rpx;
  overflow: hidden;
  border-radius: var(--sn-mp-radius-lg);
  background-color: var(--sn-mp-color-background-subtle);
}

.sn-fab-demo__hint {
  display: flex;
  flex-direction: column;
  gap: var(--sn-mp-spacing-1);
  padding: var(--sn-mp-spacing-4) var(--sn-mp-spacing-5) 0;
}

.sn-fab-demo__hint-title {
  font-size: var(--sn-mp-font-size-md);
  font-weight: 600;
  color: var(--sn-mp-color-text-primary);
}

.sn-fab-demo__hint-text {
  font-size: var(--sn-mp-font-size-sm);
  color: var(--sn-mp-color-text-secondary);
}

.sn-fab-demo__swatches {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--sn-mp-spacing-3);
  margin-top: var(--sn-mp-spacing-3);
}

.sn-fab-demo__swatch {
  width: 40rpx;
  height: 40rpx;
  border-radius: var(--sn-mp-radius-full);
  opacity: 0.45;
}

.sn-fab-demo__swatch--picked {
  opacity: 1;
  box-shadow: var(--sn-mp-shadow-sm);
}

.sn-fab-demo__bubble {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--sn-mp-radius-full);
  background-color: var(--sn-mp-color-background-elevated);
  box-shadow: var(--sn-mp-shadow-sm);
  color: var(--sn-mp-color-text-secondary);
  flex-direction: row;
}
</style>