<script setup lang="ts">
/**
 * Demo: sn-button (uni-end) — hairline border toggle (every semantic hue).
 *
 * hairline defaults to true: the default type paints a neutral hairline and
 * semantic types render as outlines in their own hue; `false` strips borders
 * on every type. Loading states live in the dedicated loading module.
 */
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <text class="sn-demo__meta">Hairline on (default): semantic types stroke in their own hue</text>
    <view class="sn-demo__row">
      <SnButton><text>Default button</text></SnButton>
      <SnButton variant="plain" type="primary"><text>Primary button</text></SnButton>
      <SnButton variant="plain" type="success"><text>Success button</text></SnButton>
      <SnButton variant="plain" type="info"><text>Info button</text></SnButton>
      <SnButton variant="plain" type="warning"><text>Warning button</text></SnButton>
      <SnButton variant="plain" type="danger"><text>Danger button</text></SnButton>
    </view>

    <text class="sn-demo__meta">Hairline off (hairline=false): borders stripped on every type</text>
    <view class="sn-demo__row">
      <SnButton :hairline="false"><text>Default button</text></SnButton>
      <SnButton :hairline="false" variant="plain" type="primary"><text>Primary button</text></SnButton>
      <SnButton :hairline="false" variant="plain" type="success"><text>Success button</text></SnButton>
      <SnButton :hairline="false" variant="plain" type="info"><text>Info button</text></SnButton>
      <SnButton :hairline="false" variant="plain" type="warning"><text>Warning button</text></SnButton>
      <SnButton :hairline="false" variant="plain" type="danger"><text>Danger button</text></SnButton>
    </view>
  </view>
</template>
