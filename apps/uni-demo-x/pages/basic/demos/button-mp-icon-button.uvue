<script setup lang="ts">
/**
 * Demo: sn-button (uni-end) — 图标按钮，集成 sn-icon 内置图标。
 *
 * `icon-name` 字符串由内嵌 sn-icon 解析（registry → 内置目录 lucide 图形 →
 * Provider），SVG 直接渲染，无需字体文件。图标大小默认随按钮尺寸自动适配
 * （small 28 / medium 32 / large 40），`icon-size` 可显式覆盖。
 *
 * 布局说明：uni-app x 不支持 flex `gap`，间距用内联 `custom-style` margin
 * 兜底，显式 `flex-direction: row` 抵消 uni-app x 的 column 默认值。
 */
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
/** 行内按钮间距（uni-app x 无 gap 兜底）。 */
const rowGap = { margin: '0 16rpx 16rpx 0' };
</script>
<template>
  <view class="sn-mp-btn-stack">
    <text class="sn-mp-btn-label">常用操作（图标大小自动适配按钮尺寸）</text>
    <view class="sn-mp-btn-row">
      <SnButton :custom-style="rowGap" type="primary" icon-name="check"><text>确认</text></SnButton>
      <SnButton :custom-style="rowGap" type="danger" icon-name="trash-2"><text>删除</text></SnButton>
      <SnButton :custom-style="rowGap" type="info" icon-name="arrow-right"><text>前进</text></SnButton>
    </view>

    <text class="sn-mp-btn-label">纯图标（无文字）</text>
    <view class="sn-mp-btn-row">
      <SnButton :custom-style="rowGap" icon-name="settings" />
      <SnButton :custom-style="rowGap" type="primary" icon-name="search" />
      <SnButton :custom-style="rowGap" type="success" icon-name="plus" />
      <SnButton :custom-style="rowGap" type="warning" icon-name="heart" />
    </view>

    <text class="sn-mp-btn-label">圆形图标按钮（circle）</text>
    <view class="sn-mp-btn-row">
      <SnButton :custom-style="rowGap" circle icon-name="settings" />
      <SnButton :custom-style="rowGap" circle type="primary" icon-name="search" />
      <SnButton :custom-style="rowGap" circle type="success" icon-name="plus" />
      <SnButton :custom-style="rowGap" circle type="danger" icon-name="trash-2" />
      <SnButton :custom-style="rowGap" circle size="small" type="info" icon-name="arrow-right" />
      <SnButton :custom-style="rowGap" circle size="large" type="warning" icon-name="heart" />
    </view>

    <text class="sn-mp-btn-label">图标 × 变体（朴素 / 柔和 / 虚线 / 细边框）</text>
    <view class="sn-mp-btn-row">
      <SnButton :custom-style="rowGap" variant="plain" type="primary" icon-name="settings" />
      <SnButton :custom-style="rowGap" variant="soft" type="primary" icon-name="settings" />
      <SnButton :custom-style="rowGap" variant="dashed" type="primary" icon-name="settings" />
      <SnButton :custom-style="rowGap" icon-name="settings" />
    </view>

    <text class="sn-mp-btn-label">图标 + 加载态</text>
    <view class="sn-mp-btn-row">
      <SnButton :custom-style="rowGap" type="primary" icon-name="download"><text>下载</text></SnButton>
      <SnButton :custom-style="rowGap" type="primary" loading><text>下载中</text></SnButton>
    </view>
  </view>
</template>
<style scoped>
.sn-mp-btn-stack {
  display: flex;
  flex-direction: column;
}
.sn-mp-btn-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
}
.sn-mp-btn-label {
  margin-bottom: 12rpx;
