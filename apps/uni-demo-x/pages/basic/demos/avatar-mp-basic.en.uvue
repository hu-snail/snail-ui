<script setup lang="ts">
/**
 * Demo: sn-avatar (uni-end) — image / text / icon content layers.
 * Text avatars use white ink on semantic color backgrounds; the row is an
 * explicit horizontal flex (uni-app x App defaults flex to column).
 */
import SnAvatar from '@snui/uni-x/components/sn-avatar/sn-avatar.uvue';
import { registerSnIcons, clearSnIcons } from '@snui/uni-x/components/sn-icon/sn-icon-registry';
import { User } from '@snui/uni-x/components/sn-icon/sn-icon-set';

registerSnIcons({ User });

onBeforeUnmount(() => clearSnIcons());
</script>
<template>
  <view class="sn-demo">
    <SnAvatar
      text="AU"
