<script setup lang="ts">
/**
 * Demo: sn-button (uni-end) — disabled 状态（语义色 + 变体形态）。
 * 加载状态统一收敛到「加载」模块。
 *
 * 布局说明：uni-app x 不支持 flex `gap`，间距用内联 `custom-style` margin
 * 兜底，显式 `flex-direction: row` 抵消 uni-app x 的 column 默认值。
 * Per AUI-DOCS-016: imports the real @snui/uni sn-button via easycom.
 */
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
/** 行内按钮间距（uni-app x 无 gap 兜底）。 */
const rowGap = { margin: '0 16rpx 16rpx 0' };
</script>
<template>
  <view class="sn-mp-btn-stack">
    <text class="sn-mp-btn-label">禁用（disabled × 语义色）</text>
    <view class="sn-mp-btn-row">
      <SnButton :custom-style="rowGap" disabled><text>默认按钮</text></SnButton>
      <SnButton :custom-style="rowGap" disabled type="primary"><text>主要按钮</text></SnButton>
      <SnButton :custom-style="rowGap" disabled type="success"><text>成功按钮</text></SnButton>
      <SnButton :custom-style="rowGap" disabled type="info"><text>信息按钮</text></SnButton>
      <SnButton :custom-style="rowGap" disabled type="warning"><text>警告按钮</text></SnButton>
      <SnButton :custom-style="rowGap" disabled type="danger"><text>危险按钮</text></SnButton>
    </view>

    <text class="sn-mp-btn-label">禁用（disabled × 变体：朴素 / 柔和 / 虚线 / 细边框）</text>
    <view class="sn-mp-btn-row">
      <SnButton :custom-style="rowGap" disabled variant="plain" type="primary"><text>朴素禁用</text></SnButton>
      <SnButton :custom-style="rowGap" disabled variant="soft" type="primary"><text>柔和禁用</text></SnButton>
      <SnButton :custom-style="rowGap" disabled variant="dashed" type="primary"><text>虚线禁用</text></SnButton>
      <SnButton :custom-style="rowGap" disabled><text>细边框禁用</text></SnButton>
    </view>
  </view>
</template>
