<script setup lang="ts">
/**
 * Demo: sn-button (uni-end) — disabled & loading.
 * Per AUI-DOCS-016: imports the real @snui/uni sn-button via easycom.
 */
const loading = ref(false);
function trigger(): void {
  loading.value = true;
  setTimeout(() => {
    loading.value = false;
  }, 1000);
}
</script>
<template>
  <view class="sn-demo">
    <SnButton disabled><text>禁用</text></SnButton>
    <SnButton loading><text>加载中</text></SnButton>
    <SnButton :loading="loading" type="primary" @click="trigger"><text>点击触发加载</text></SnButton>
  </view>
</template>
<style scoped>
.sn-demo {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  align-items: center;
}
</style>