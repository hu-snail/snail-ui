        <SnButton type="primary" size="small"><text>Inherits too</text></SnButton>
      </view>
    </SnConfigProvider>

    <view class="sn-cfg-demo__inner sn-cfg-demo__inner--plain">
      <SnTag type="primary"><text>Outside the provider</text></SnTag>
