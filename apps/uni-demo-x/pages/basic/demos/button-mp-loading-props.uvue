<script setup lang="ts">
/**
 * Demo: sn-button (uni-end) — `loading-props` 对象写法。
 *
 * `loading-props` 是 wot-ui `wd-button` 的写法（`{ color, size, text }`），本组件
 * 读 `color` / `size` 两项，其余字段忽略 —— 这样为 wd-button 写的配置能原样通过。
 *
 * 优先级：扁平的 `loading-color` / `loading-size` 先赢；没设时才回落到
 * `loading-props.color` / `loading-props.size`。
 */
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
const spinnerFromProps = { color: 'var(--sn-mp-color-action-primary)', size: 48 };
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <text class="sn-demo__meta">loading-props 只给 color：spinner 换成品牌色</text>
    <view class="sn-demo__row">
      <SnButton
        type="primary"
        loading
        :loading-props="{ color: 'var(--sn-mp-color-feedback-success)' }"
      ><text>
        品牌色 spinner
      </text></SnButton>
      <SnButton type="primary" loading><text>默认 spinner</text></SnButton>
    </view>

    <text class="sn-demo__meta">loading-props 同时给 color + size（size 走 rpx）</text>
    <view class="sn-demo__row">
      <SnButton type="success" loading :loading-props="spinnerFromProps"><text>48rpx spinner</text></SnButton>
      <SnButton type="success" loading><text>32rpx spinner</text></SnButton>
    </view>

    <text class="sn-demo__meta">
      扁平 prop 优先：loading-color / loading-size 会覆盖 loading-props 里的同名项
    </text>
    <view class="sn-demo__row">
      <SnButton
        type="warning"
        loading
        loading-color="var(--sn-mp-color-feedback-danger)"
        :loading-props="{ color: 'var(--sn-mp-color-action-primary)', size: 64 }"
      ><text>
        loading-color 赢
      </text></SnButton>
    </view>
  </view>
</template>
<style scoped>
.sn-demo--stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  align-items: stretch;
  width: 100%;
}
.sn-demo__row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  align-items: center;
  flex-direction: row;
}
.sn-demo__meta {
  color: var(--sn-mp-color-text-tertiary);
  font-size: var(--sn-mp-font-size-xs);
  line-height: var(--sn-mp-font-line-height-normal);
}
</style>