      <SnButton variant="plain" type="success"><text>成功按钮</text></SnButton>
      <SnButton variant="plain" type="info"><text>信息按钮</text></SnButton>
      <SnButton variant="plain" type="warning"><text>警告按钮</text></SnButton>
      <SnButton variant="plain" type="danger"><text>危险按钮</text></SnButton>
