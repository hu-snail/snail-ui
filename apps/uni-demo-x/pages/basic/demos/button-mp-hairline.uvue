<script setup lang="ts">
/**
 * Demo: sn-button (uni-end) — 细边框（`hairline`，描边开关）。
 *
 * 细边框的本体是 default 类型的灰细描边（朴素/虚线等语义色描边归「变体」
 * 模块演示）。`hairline=false` 是总开关：default 去描边，plain / dashed
 * 等变体也只剩文字色。
 *
 * 布局说明：uni-app x 不支持 flex `gap`，间距用内联 `custom-style` margin
 * 兜底，显式 `flex-direction: row` 抵消 uni-app x 的 column 默认值。
 */
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
/** 行内按钮间距（uni-app x 无 gap 兜底）。 */
const rowGap = { margin: '0 16rpx 16rpx 0' };
</script>
<template>
  <view class="sn-mp-btn-stack">
    <text class="sn-mp-btn-meta">细边框（默认开启）：default 类型的灰细描边</text>
    <view class="sn-mp-btn-row">
      <SnButton :custom-style="rowGap"><text>默认按钮</text></SnButton>
      <SnButton :custom-style="rowGap" size="large"><text>默认按钮</text></SnButton>
    </view>

    <text class="sn-mp-btn-meta">hairline=false：default 去描边；plain / 虚线变体也只剩文字色</text>
    <view class="sn-mp-btn-row">
      <SnButton :custom-style="rowGap" :hairline="false"><text>默认按钮</text></SnButton>
      <SnButton :custom-style="rowGap" :hairline="false" variant="plain" type="primary"><text>
        描边移除
      </text></SnButton>
      <SnButton :custom-style="rowGap" :hairline="false" variant="dashed" type="success"><text>
        描边移除
      </text></SnButton>
    </view>
  </view>
</template>
<style scoped>
.sn-mp-btn-stack {
  display: flex;
  flex-direction: column;
}
.sn-mp-btn-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
}
.sn-mp-btn-meta {
  margin-bottom: 12rpx;
  color: var(--sn-mp-color-text-tertiary);
  font-size: var(--sn-mp-font-size-xs);
  line-height: var(--sn-mp-font-line-height-normal);
}
</style>