 */
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
/** Vertical spacing fallback (uni-app x lacks gap). */
const stackGap = { 'margin-bottom': '16rpx' };
</script>
<template>
  <view class="sn-mp-btn-stack">
    <text class="sn-mp-btn-label">Filled (block × semantic hues)</text>
    <SnButton :custom-style="stackGap" block type="primary"><text>Primary button</text></SnButton>
    <SnButton :custom-style="stackGap" block type="success"><text>Success button</text></SnButton>
    <SnButton :custom-style="stackGap" block type="danger"><text>Danger button</text></SnButton>

    <text class="sn-mp-btn-label">Round (block × round)</text>
    <SnButton :custom-style="stackGap" block round type="primary"><text>Round primary button</text></SnButton>
    <SnButton :custom-style="stackGap" block round type="success"><text>Round success button</text></SnButton>

    <text class="sn-mp-btn-label">Plain (block × plain)</text>
    <SnButton :custom-style="stackGap" block variant="plain" type="primary"><text>Plain primary button</text></SnButton>
    <SnButton :custom-style="stackGap" block variant="plain" type="danger"><text>Plain danger button</text></SnButton>

    <text class="sn-mp-btn-label">Soft (block × soft)</text>
    <SnButton :custom-style="stackGap" block variant="soft" type="primary"><text>Soft primary button</text></SnButton>
    <SnButton :custom-style="stackGap" block variant="soft" type="success"><text>Soft success button</text></SnButton>

    <text class="sn-mp-btn-label">Loading (block × loading)</text>
    <SnButton :custom-style="stackGap" block loading type="primary"><text>Saving</text></SnButton>
    <SnButton block loading type="success"><text>Submitting</text></SnButton>
