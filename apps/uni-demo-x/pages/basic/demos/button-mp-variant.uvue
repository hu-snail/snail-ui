<script setup lang="ts">
/**
 * Demo: sn-button — variant 六档 × 语义类型全矩阵。
 *
 * `variant`: 'base' | 'plain' | 'dashed' | 'soft' | 'subtle' | 'text'。
 * 每档变体都给出全部语义色：plain / dashed 保留语义描边，soft 给浅色底，
 * text 只保留语义文字色，subtle 固定淡灰底（不随类型变化）。
 */
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
type ButtonVariant = 'base' | 'plain' | 'dashed' | 'soft' | 'subtle' | 'text';
type SemanticType = 'primary' | 'success' | 'info' | 'warning' | 'danger';

/** 六档变体的分组标签（括号内为 API 枚举值）。 */
const variants: Array<{ key: ButtonVariant; label: string }> = [
  { key: 'base', label: '实心' },
  { key: 'plain', label: '朴素' },
  { key: 'dashed', label: '虚线' },
  { key: 'soft', label: '柔和' },
  { key: 'subtle', label: '淡雅' },
  { key: 'text', label: '文字' },
];

/** 每组展示的语义类型。 */
const types: Array<{ key: SemanticType; label: string }> = [
  { key: 'primary', label: '主要按钮' },
  { key: 'success', label: '成功按钮' },
  { key: 'info', label: '信息按钮' },
  { key: 'warning', label: '警告按钮' },
  { key: 'danger', label: '危险按钮' },
];
</script>
<template>
  <view class="sn-button-demo sn-button-demo--stack">
    <view v-for="variant in variants" :key="variant.key" class="sn-button-demo__group">
      <text class="sn-button-demo__label">{{ variant.label }}（{{ variant.key }}）</text>
      <view class="sn-button-demo__row">
        <SnButton
          v-for="item in types"
          :key="item.key"
          :type="item.key"
          :variant="variant.key === 'base' ? undefined : variant.key"
        ><text>
          {{ variant.key === 'text' ? '按钮' : item.label }}
        </text></SnButton>
      </view>
    </view>
  </view>
</template>
<style scoped>
.sn-button-demo--stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100%;
}
.sn-button-demo__group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.sn-button-demo__row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  align-items: center;
  flex-direction: row;
}
.sn-button-demo__label {
  color: var(--sn-mp-color-text-secondary);
  font-size: var(--sn-mp-font-size-xs);
}
</style>