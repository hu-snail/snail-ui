<!-- gen-x: source apps/uni-demo/src/pages/basic/demos/button-mp-variant.vue sha256:92570c923e0ccd06 —— 生成产物勿手改；源码改动后重跑 pnpm -F @snui/uni-demo-x gen -->
<script setup lang="ts">
/**
 * Demo: sn-button — 变体 × 语义类型全矩阵（base 即默认实心，见基础用法，不重复成组）。
 *
 * `variant`: 'plain' | 'dashed' | 'soft' | 'subtle' | 'text'。
 * plain / dashed 透明底 + 语义描边（dashed 为朴素虚线），soft 浅色填充，
 * text 只保留语义文字色，subtle 淡灰底 + 语义文字色。
 *
 * 布局说明：uni-app x 不支持 flex `gap`，间距用内联 `custom-style` margin
 * 兜底，显式 `flex-direction: row` 抵消 uni-app x 的 column 默认值。
 */
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
type ButtonVariant = 'plain' | 'dashed' | 'soft' | 'subtle' | 'text';
type SemanticType = 'primary' | 'success' | 'info' | 'warning' | 'danger';

/** 变体分组标签（括号内为 API 枚举值）。 */
const variants: Array<{ key: ButtonVariant; label: string }> = [
  { key: 'plain', label: '朴素' },
  { key: 'dashed', label: '虚线' },
  { key: 'soft', label: '柔和' },
  { key: 'subtle', label: '淡雅' },
  { key: 'text', label: '文字' },
];

/** 每组展示的语义类型。 */
const types: Array<{ key: SemanticType; label: string }> = [
  { key: 'primary', label: '主要按钮' },
  { key: 'success', label: '成功按钮' },
  { key: 'info', label: '信息按钮' },
  { key: 'warning', label: '警告按钮' },
  { key: 'danger', label: '危险按钮' },
];

/** 行内按钮间距（uni-app x 无 gap 兜底）。 */
const rowGap = { margin: '0 16rpx 16rpx 0' };
</script>
<template>
  <view class="sn-mp-btn-stack">
    <view v-for="variant in variants" :key="variant.key" class="sn-mp-btn-group">
      <text class="sn-mp-btn-label">{{ variant.label }}（{{ variant.key }}）</text>
      <view class="sn-mp-btn-row">
        <SnButton
          v-for="item in types"
          :key="item.key"
          :custom-style="rowGap"
          :type="item.key"
          :variant="variant.key"
        ><text>
          {{ variant.key === 'text' ? '按钮' : item.label }}
        </text></SnButton>
      </view>
    </view>
  </view>
</template>
<style scoped>
.sn-mp-btn-stack {
  display: flex;
  flex-direction: column;
}
.sn-mp-btn-group {
  display: flex;
  flex-direction: column;
  margin-bottom: 20rpx;
}
.sn-mp-btn-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
}
.sn-mp-btn-label {
  margin-bottom: 12rpx;
  color: var(--sn-mp-color-text-secondary);
  font-size: var(--sn-mp-font-size-xs);
}
</style>