 */
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
/** 行内按钮间距（uni-app x 无 gap 兜底）。 */
const rowGap = { margin: '0 16rpx 16rpx 0' };
</script>
<template>
  <view class="sn-mp-btn-stack">
    <view class="sn-mp-btn-row">
      <SnButton :custom-style="rowGap"><text>默认按钮</text></SnButton>
      <SnButton :custom-style="rowGap" type="primary"><text>主要按钮</text></SnButton>
      <SnButton :custom-style="rowGap" type="success"><text>成功按钮</text></SnButton>
      <SnButton :custom-style="rowGap" type="info"><text>信息按钮</text></SnButton>
      <SnButton :custom-style="rowGap" type="warning"><text>警告按钮</text></SnButton>
      <SnButton :custom-style="rowGap" type="danger"><text>危险按钮</text></SnButton>
    </view>
  </view>
</template>
