<script setup lang="ts">
/**
 * Demo: sn-button (uni-end) — disabled state (semantic hues + variant forms).
 * Loading states live in the dedicated loading module.
 * Spacing note: uni-app x has no flex `gap` support — inline `custom-style`
 * margins + explicit `flex-direction: row`.
 * Per AUI-DOCS-016: imports the real @snui/uni sn-button via easycom.
 */
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
/** In-row spacing fallback (uni-app x lacks gap). */
const rowGap = { margin: '0 16rpx 16rpx 0' };
</script>
<template>
  <view class="sn-mp-btn-stack">
    <text class="sn-mp-btn-label">Disabled (× semantic hues)</text>
    <view class="sn-mp-btn-row">
      <SnButton :custom-style="rowGap" disabled><text>Default button</text></SnButton>
      <SnButton :custom-style="rowGap" disabled type="primary"><text>Primary button</text></SnButton>
      <SnButton :custom-style="rowGap" disabled type="success"><text>Success button</text></SnButton>
      <SnButton :custom-style="rowGap" disabled type="info"><text>Info button</text></SnButton>
      <SnButton :custom-style="rowGap" disabled type="warning"><text>Warning button</text></SnButton>
      <SnButton :custom-style="rowGap" disabled type="danger"><text>Danger button</text></SnButton>
    </view>

    <text class="sn-mp-btn-label">Disabled (× variants: plain / soft / dashed / hairline)</text>
    <view class="sn-mp-btn-row">
      <SnButton :custom-style="rowGap" disabled variant="plain" type="primary"><text>Plain disabled</text></SnButton>
      <SnButton :custom-style="rowGap" disabled variant="soft" type="primary"><text>Soft disabled</text></SnButton>
      <SnButton :custom-style="rowGap" disabled variant="dashed" type="primary"><text>Dashed disabled</text></SnButton>
      <SnButton :custom-style="rowGap" disabled><text>Hairline disabled</text></SnButton>
    </view>
  </view>
</template>
