<script setup lang="ts">
/**
 * Demo: sn-circle (uni-end) — progress values and sizes.
 * Per AUI-DOCS-016: imports the real @snui/uni sn-circle from its SFC source.
 */
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
import SnCircle from '@snui/uni-x/components/sn-circle/sn-circle.uvue';
const percent = ref(30);
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <view class="sn-circle-demo__row">
      <SnCircle :model-value="0" :size="120" />
      <SnCircle :model-value="30" :size="120" />
      <SnCircle :model-value="70" :size="120" />
      <SnCircle :model-value="100" :size="120" />
    </view>

    <view class="sn-circle-demo__row">
      <SnCircle :model-value="percent" :size="80" :stroke-width="10" />
      <SnCircle :model-value="percent" :size="140" :stroke-width="22" />
      <SnCircle :model-value="percent" :size="180" text="Done" />
    </view>

    <view class="sn-circle-demo__row">
      <SnButton size="small" @click="percent = Math.max(0, percent - 10)"><text>-10</text></SnButton>
      <SnButton size="small" @click="percent = Math.min(100, percent + 10)"><text>+10</text></SnButton>
    </view>
  </view>
</template>
<style scoped>
.sn-demo--stack {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.sn-circle-demo__row {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  align-items: center;
}
</style>