<script setup lang="ts">
/**
 * Demo: sn-action-sheet (uni-end) — list rows with cancel button.
 * Per AUI-DOCS-016: imports the real @snui/uni sn-action-sheet from its SFC source.
 */
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
import SnActionSheet from '@snui/uni-x/components/sn-action-sheet/sn-action-sheet.uvue';
const open = ref(false);
const picked = ref('—');

const actions = [
  { name: '分享给朋友', description: '发送到聊天或朋友圈' },
  { name: '保存到相册' },
  { name: '删除', disabled: true },
];
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <SnButton type="primary" block @click="open = true"><text>打开动作面板</text></SnButton>
    <text class="sn-action-sheet-demo__meta">已选择：{{ picked }}</text>

    <SnActionSheet
      v-model="open"
      title="请选择操作"
      :actions="actions"
      cancel-text="取消"
      custom-class="sn-demo-contained"
      @select="picked = $event.item.name ?? ''"
    />
  </view>
</template>
<style scoped>
.sn-demo--stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
