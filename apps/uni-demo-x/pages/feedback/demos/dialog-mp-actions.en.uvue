<script setup lang="ts">
/**
 * Demo: sn-dialog (uni-end) — custom action rows and beforeConfirm guard.
 * Per AUI-DOCS-016: imports the real @snui/uni sn-dialog from its SFC source.
 */
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
import SnDialog from '@snui/uni-x/components/sn-dialog/sn-dialog.uvue';
const actionsOpen = ref(false);
const guardOpen = ref(false);
const lastAction = ref('—');

const actions = [
  { name: 'Copy link' },
  { name: 'Save offline' },
  { name: 'Delete (disabled)', disabled: true },
];

function blockConfirm(): boolean {
  return false;
}
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <SnButton type="primary" block @click="actionsOpen = true"><text>Custom action rows</text></SnButton>
    <SnButton block @click="guardOpen = true"><text>beforeConfirm veto</text></SnButton>
    <text class="sn-dialog-demo__meta">Last action: {{ lastAction }}</text>

    <SnDialog
      v-model="actionsOpen"
      title="More actions"
      msg="Custom actions replace the default confirm / cancel buttons."
      :actions="actions"
      custom-class="sn-demo-contained"
      @select="lastAction = `actions picked: ${$event.item.name}`"
    />

    <SnDialog
      v-model="guardOpen"
      type="confirm"
      title="Needs a second check"
      msg="The dialog stays open while beforeConfirm returns false."
      :before-confirm="blockConfirm"
      custom-class="sn-demo-contained"
      @confirm="lastAction = 'guard passed'"
    />
  </view>
</template>
<style scoped>
.sn-demo--stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.sn-dialog-demo__meta {
  font-size: 24rpx;
  color: var(--vp-c-text-2);
}
/* H5 / WEB only — docs preview pins the fixed layer to the phone frame.
 * uni-app x App compiles this OUT: App-side `position: absolute` lays out in
 * the direct parent's content box (css/position) and the page class still
 * reaches the component root (style-isolation) — the rule would pin the
 * fullscreen fixed layer into the demo card and clip it (App overflow
 * defaults to hidden). */
/* #ifdef H5 || WEB */
.sn-dialog.sn-demo-contained {
  position: absolute;
}
/* #endif */
</style>