<script setup lang="ts">
/**
 * Demo: sn-action-sheet (uni-end) — rows with icons (actions[].icon).
 * Per AUI-DOCS-016: imports the real @snui/uni sn-action-sheet from its SFC
 * source. Per AGENTS.md §113, icons come from the SnIcon catalog.
 */
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
import SnActionSheet from '@snui/uni-x/components/sn-action-sheet/sn-action-sheet.uvue';
const open = ref(false);
const picked = ref('—');

const actions = [
  { name: '选项一', icon: 'star' },
  { name: '选项二', icon: 'heart' },
  { name: '选项三', icon: 'wallet' },
];
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <SnButton type="primary" block @click="open = true"><text>打开带图标的面板</text></SnButton>
    <text class="sn-action-sheet-demo__meta">已选择：{{ picked }}</text>

    <SnActionSheet
      v-model="open"
      title="带图标"
      :actions="actions"
      cancel-text="取消"
      custom-class="sn-demo-contained"
      @select="picked = $event.item.name ?? ''"
    />
  </view>
</template>
<style scoped>
.sn-demo--stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.sn-action-sheet-demo__meta {
  font-size: 24rpx;
