<script setup lang="ts">
/**
 * Demo: sn-curtain (uni-end) — a promo curtain with the default inset close button.
 * Per AUI-DOCS-016: imports the real @snui/uni sn-curtain from its SFC source.
 */
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
import SnCurtain from '@snui/uni-x/components/sn-curtain/sn-curtain.uvue';
const show = ref(false);

/** Inline SVG placeholder so the demo needs no external network asset. */
const promoImage =
  'data:image/svg+xml;charset=utf-8,' +
  encodeURIComponent(
    '<svg xmlns="http://www.w3.org/2000/svg" width="600" height="800">' +
      '<rect width="600" height="800" rx="24" fill="lavender"/>' +
      '<text x="300" y="380" font-size="46" text-anchor="middle" fill="slateblue">' +
      'Limited offer</text>' +
      '<text x="300" y="440" font-size="30" text-anchor="middle" fill="mediumslateblue">' +
      'Spend $199, save $50</text>' +
      '</svg>',
  );
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <SnButton type="primary" block @click="show = true"><text>Open the curtain</text></SnButton>

    <SnCurtain
      v-model="show"
      :src="promoImage"
      :width="280"
      close-position="inset"
      custom-class="sn-demo-contained"
    />
  </view>
</template>
<style scoped>
.sn-demo--stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
/* H5 / WEB only — docs preview pins the fixed layer to the phone frame.
 * uni-app x App compiles this OUT: App-side `position: absolute` lays out in
 * the direct parent's content box (css/position) and the page class still
 * reaches the component root (style-isolation) — the rule would pin the
 * fullscreen fixed layer into the demo card and clip it (App overflow
 * defaults to hidden). */
/* #ifdef H5 || WEB */
.sn-curtain.sn-demo-contained {
  position: absolute;
}
/* #endif */
</style>