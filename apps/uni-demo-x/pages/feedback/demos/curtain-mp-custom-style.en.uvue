<script setup lang="ts">
/**
 * Demo: sn-curtain (uni-end) — English shadow of curtain-mp-custom-style.
 */
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
import SnCurtain from '@snui/uni-x/components/sn-curtain/sn-curtain.uvue';
/** Build an inline SVG poster so the demo needs no network asset. */
function poster(label: string): string {
  return (
    'data:image/svg+xml;charset=utf-8,' +
    encodeURIComponent(
      `<svg xmlns="http://www.w3.org/2000/svg" width="600" height="700">` +
        `<rect width="600" height="700" rx="24" fill="lavender"/>` +
        `<text x="300" y="360" font-size="42" text-anchor="middle" fill="slateblue">${label}</text>` +
        `</svg>`,
    )
  );
}

const open = ref(false);
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <SnButton type="primary" block @click="open = true"><text>Custom close button and root style</text></SnButton>

    <text class="sn-demo__meta">
      custom-close-style lands on the close button (extra padding + shadow); custom-style lands on
      the root node.
    </text>

    <SnCurtain
      v-model="open"
      :src="poster('custom styles')"
      :width="260"
      close-position="bottom-right"
      custom-close-style="padding: var(--sn-mp-spacing-2); box-shadow: var(--sn-mp-shadow-md);"
      custom-style="padding: var(--sn-mp-spacing-5);"
      custom-class="sn-demo-contained"
    />
  </view>
</template>
<style scoped>
.sn-demo--stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.sn-demo__meta {
  color: var(--sn-mp-color-text-tertiary);
  font-size: var(--sn-mp-font-size-xs);
  line-height: var(--sn-mp-font-line-height-normal);
}
/* Docs-preview only — keep the fixed-position curtain inside the phone screen. */
.sn-curtain.sn-demo-contained {
  position: absolute;
}
</style>