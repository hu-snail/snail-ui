<script setup lang="ts">
/**
 * Demo: sn-circle (uni-end) — English shadow of circle-mp-speed.
 */
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
import SnCircle from '@snui/uni-x/components/sn-circle/sn-circle.uvue';
const percent = ref(20);

function step(): void {
  percent.value = percent.value >= 100 ? 20 : Math.min(100, percent.value + 20);
}
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <view class="sn-demo__row">
      <SnCircle :model-value="percent" :size="120" :speed="0" text="speed=0" />
      <SnCircle :model-value="percent" :size="120" :speed="200" text="speed=200" />
      <SnCircle :model-value="percent" :size="120" :speed="10" text="speed=10" />
    </view>

    <SnButton type="primary" block @click="step"><text>+20% (watch the speed difference)</text></SnButton>

    <text class="sn-demo__meta">
      speed is "percent per second" and 0 disables the transition.
    </text>
  </view>
</template>
<style scoped>
.sn-demo--stack {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.sn-demo__row {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  align-items: center;
}
