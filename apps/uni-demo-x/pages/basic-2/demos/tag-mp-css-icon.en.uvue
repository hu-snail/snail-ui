<script setup lang="ts">
/**
 * Demo: sn-tag (uni-end) — font icons (`cssIcon`).
 *
 * `cssIcon` routes a string icon explicitly to the font-glyph path
 * (`iconPrefix` builds the prefix, a string value is the prefix itself); the
 * glyph comes from the host iconfont, so the demo paints geometric
 * placeholders on the icon node to prove the generated classes land (no
 * pseudo-elements).
 */
import SnTag from '@snui/uni-x/components/sn-tag/sn-tag.uvue';
/** Iconfont glyphs: iconPrefix + cssIcon build sn-demo-tag-icon-{name}. */
const glyphs = [{ icon: 'star' }, { icon: 'heart' }, { icon: 'check' }] as const;
</script>
<template>
  <view class="sn-demo sn-demo--stack">
    <text class="sn-demo__meta">cssIcon font glyphs (shapes stand in for host glyphs)</text>
    <view class="sn-demo__row">
      <SnTag
        v-for="glyph in glyphs"
        :key="glyph.icon"
        type="success"
        variant="light"
        :icon="glyph.icon"
        icon-prefix="sn-demo-tag-icon"
        css-icon
      ><text>
        {{ glyph.icon }}
      </text></SnTag>
      <SnTag type="warning" variant="plain" icon="diamond" css-icon="sn-demo-tag-gem"><text>
        Custom prefix
      </text></SnTag>
    </view>
  </view>
</template>
