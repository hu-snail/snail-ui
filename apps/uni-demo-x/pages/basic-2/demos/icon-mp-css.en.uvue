      <SnIcon css-icon="demo-icon-cart" :size="40" />
      <SnIcon css-icon="demo-icon-bell" :size="40" />
      <SnIcon css-icon="demo-icon-check" :size="40" />
    </view>
    <text class="sn-demo__meta">
      css-icon="demo-icon-cart" / "demo-icon-bell" / "demo-icon-check" — the class renders verbatim,
      no prefix added
    </text>

    <view class="sn-demo__row">
      <SnIcon name="search" css-icon :size="40" />
    </view>
    <text class="sn-demo__meta">
      The boolean form with name: both sn-icon-search and search are applied, covering either naming
      convention
    </text>
  </view>
</template>
