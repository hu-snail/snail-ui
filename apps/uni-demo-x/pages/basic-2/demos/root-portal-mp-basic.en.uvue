<script setup lang="ts">
/**
 * Demo: sn-root-portal — escape a clipped ancestor.
 *
 * The inner box is `overflow: hidden`, so content that overflows it would
 * normally be cut off. Wrapped in `sn-root-portal`, the badge stays visible
 * because the layer is fixed to the viewport.
 */
import SnRootPortal from '@snui/uni-x/components/sn-root-portal/sn-root-portal.uvue';
import SnButton from '@snui/uni-x/components/sn-button/sn-button.uvue';
const visible = ref(true);
</script>
<template>
  <view class="sn-demo sn-demo--column">
    <view class="sn-root-portal-demo__clipped">
      <text class="sn-root-portal-demo__note">This container is overflow: hidden</text>

      <SnRootPortal v-if="visible">
        <view class="sn-root-portal-demo__badge"><text>Content outside the clip</text></view>
      </SnRootPortal>
    </view>

    <view class="sn-root-portal-demo__actions">
      <SnButton size="small" @click="visible = !visible"><text>
        {{ visible ? 'Unmount layer' : 'Mount layer' }}
      </text></SnButton>
    </view>
  </view>
</template>
<style scoped>
.sn-root-portal-demo__clipped {
  position: relative;
  height: 72px;
  padding: 10px;
  overflow: hidden;
  border: 1px dashed var(--sn-mp-color-border-default);
  border-radius: 8px;
  background: var(--sn-mp-color-background-subtle);
}

.sn-root-portal-demo__note {
  font-size: 12px;
  color: var(--sn-mp-color-text-secondary);
}

.sn-root-portal-demo__badge {
  position: absolute;
  top: 40px;
  left: 50%;
  transform: translateX(-50%);
  padding: 6px 12px;
  border-radius: 999px;
  background: var(--sn-mp-color-action-primary);
  color: var(--sn-mp-color-text-on-primary);
  font-size: 12px;
  white-space: nowrap;
}

.sn-root-portal-demo__actions {
  display: flex;
  gap: 8px;
  flex-direction: row;
}
</style>