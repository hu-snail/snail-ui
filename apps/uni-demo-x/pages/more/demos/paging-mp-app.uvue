  align-items: center;
  gap: 10rpx;
}

.pgd__author {
  color: var(--sn-mp-color-text-secondary);
  font-size: var(--sn-mp-font-size-sm);
  line-height: var(--sn-mp-font-line-height-normal);
}

.pgd__dot {
  color: var(--sn-mp-color-text-tertiary);
  font-size: var(--sn-mp-font-size-sm);
}

.pgd__date {
  color: var(--sn-mp-color-text-tertiary);
  font-size: var(--sn-mp-font-size-sm);
  line-height: var(--sn-mp-font-line-height-normal);
}

/* 头图占位：token 渐变色块，不引外部图片资源。 */
.pgd__hero {
  height: 240rpx;
  border-radius: var(--sn-mp-radius-md);
  background: linear-gradient(135deg, var(--sn-mp-color-action-primary), var(--sn-mp-color-purple));
  opacity: 0.85;
}

.pgd__para {
  color: var(--sn-mp-color-text-secondary);
  font-size: var(--sn-mp-font-size-md);
  line-height: 1.7;
}

.pgd__ops {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 32rpx;
  padding-top: var(--sn-mp-spacing-2);
  border-top: 2rpx solid var(--sn-mp-color-border-subtle);
}

.pgd__op {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
}

.pgd__op-text {
  color: var(--snx-pgd__op-text-color, var(--sn-mp-color-text-tertiary));
  font-size: var(--sn-mp-font-size-xs);
  line-height: var(--sn-mp-font-line-height-normal);
}

.pgd__op--active {
  color: var(--sn-mp-color-action-primary);
  --snx-pgd__op-text-color: var(--sn-mp-color-action-primary);
}

.pgd__replies-head {
  padding: var(--sn-mp-spacing-2) var(--sn-mp-spacing-3);
}

.pgd__replies-title {
  color: var(--sn-mp-color-text-primary);
  font-size: var(--sn-mp-font-size-md);
  font-weight: var(--sn-mp-font-weight-medium);
  line-height: var(--sn-mp-font-line-height-normal);
}

.pgd__reply {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin: 0 var(--sn-mp-spacing-3) var(--sn-mp-spacing-2);
  padding: var(--sn-mp-spacing-3) var(--sn-mp-spacing-4);
  border-radius: var(--sn-mp-radius-lg);
  background-color: var(--sn-mp-color-background-surface);
  border: 1px solid var(--sn-mp-color-border-subtle);
}

.pgd__reply-author {
  color: var(--sn-mp-color-text-secondary);
  font-size: var(--sn-mp-font-size-sm);
  font-weight: var(--sn-mp-font-weight-medium);
