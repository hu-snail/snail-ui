<script setup lang="ts">
/**
 * Demo: sn-slider-bar — themes: `theme` repaints track, fill and knob ring at once.
 *
 * Besides the default and aurora (gradient + drifting stars), four zero-config
 * presets ship in the box: ocean, sunset, grape and mono. A theme only swaps
 * colours — geometry is untouched, so the knob diameter and track thickness stay
 * identical across all of them. Single colours can still be overridden with
 * fill-background / knob-border-color (explicit props win).
 */
import SnSliderBar from '@snui/uni-x/components/sn-slider-bar/sn-slider-bar.uvue';
const aurora = ref(64);
const ocean = ref(72);
const sunset = ref(56);
const grape = ref(40);
const mono = ref(84);
</script>
<template>
  <view class="sn-demo sn-demo--column">
    <view class="look-head">
      <text class="look-head__label">aurora · gradient + stars</text>
      <text class="look-head__value">{{ aurora }}</text>
    </view>
    <SnSliderBar v-model="aurora" theme="aurora" aria-label="Aurora" />

    <view class="look-head">
      <text class="look-head__label">ocean · cyan → blue</text>
      <text class="look-head__value">{{ ocean }}</text>
    </view>
    <SnSliderBar v-model="ocean" theme="ocean" aria-label="Ocean" />

    <view class="look-head">
      <text class="look-head__label">sunset · orange → rose</text>
      <text class="look-head__value">{{ sunset }}</text>
    </view>
    <SnSliderBar v-model="sunset" theme="sunset" aria-label="Sunset" />

    <view class="look-head">
      <text class="look-head__label">grape · violet → magenta</text>
      <text class="look-head__value">{{ grape }}</text>
    </view>
    <SnSliderBar v-model="grape" theme="grape" aria-label="Grape" />

    <view class="look-head">
      <text class="look-head__label">mono · ink grey</text>
      <text class="look-head__value">{{ mono }}</text>
    </view>
    <SnSliderBar v-model="mono" theme="mono" aria-label="Mono" />
  </view>
</template>
