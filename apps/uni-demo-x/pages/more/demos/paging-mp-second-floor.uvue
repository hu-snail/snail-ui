  border-bottom: 2rpx solid var(--sn-mp-color-border-subtle);
  background-color: var(--sn-mp-color-background-surface);
}

.paging-row__label {
  color: var(--sn-mp-color-text-primary);
  font-size: var(--sn-mp-font-size-md);
  line-height: var(--sn-mp-font-line-height-normal);
}

/* 二楼：全屏深色面板（截屏样式）——标题 + 4 列图标网格 + 底部回到首页。 */
.floor {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  min-height: 100%;
  padding: 120rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
}

.floor__title {
  color: #f1f5f9;
  font-size: var(--sn-mp-font-size-xl);
  font-weight: 600;
  line-height: var(--sn-mp-font-line-height-normal);
  text-align: center;
}

.floor__grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 72rpx;
}

.floor__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  width: 25%;
  margin-bottom: 48rpx;
}

.floor__item-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 104rpx;
  height: 104rpx;
  border-radius: 32rpx;
  flex-direction: row;
}

.floor__item-label {
  margin-top: 14rpx;
  color: rgba(241, 245, 249, 0.82);
  font-size: var(--sn-mp-font-size-sm);
  line-height: var(--sn-mp-font-line-height-normal);
}

.floor__footer {
  margin-top: auto;
  padding-top: 56rpx;
}

.floor__back {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  height: 96rpx;
  border-radius: var(--sn-mp-radius-full);
  background: rgba(148, 163, 184, 0.16);
  flex-direction: row;
}

.floor__back-text {
  color: #e2e8f0;
  font-size: var(--sn-mp-font-size-md);
