{
  "name": "@snui/uni-demo",
  "version": "0.1.0",
  "private": true,
  "description": "AUI uni-demo — standalone uni-app playground owning the uni demo sources (single source of truth). Real uni runtime: deployable H5 site (docs previews iframe it) + WeChat miniprogram build. See ADR-0005.",
  "type": "module",
  "scripts": {
    "gen:demos": "node scripts/fork-demos.mjs",
    "gen:pages": "node scripts/gen-pages.mjs",
    "dev:h5": "pnpm run gen:pages && uni",
    "dev:mp-weixin": "pnpm run gen:pages && uni -p mp-weixin",
    "build:h5": "node scripts/build-h5.mjs",
    "build:mp-weixin": "pnpm run gen:pages && uni build -p mp-weixin",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5030320261023001",
    "@dcloudio/uni-components": "3.0.0-5030320261023001",
    "@dcloudio/uni-h5": "3.0.0-5030320261023001",
    "@dcloudio/uni-mp-weixin": "3.0.0-5030320261023001",
    "@snui/templates": "workspace:*",
    "@snui/uni": "workspace:*",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.31",
    "@dcloudio/uni-cli-shared": "3.0.0-5030320261023001",
    "@dcloudio/vite-plugin-uni": "3.0.0-5030320261023001",
    "vite": "5.2.8"
  }
}
