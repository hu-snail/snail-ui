{
  "name": "@snui/echarts",
  "version": "0.1.0",
  "private": true,
  "description": "AUI ECharts — 基于 Apache ECharts 的深度集成封装层。Token 驱动的主题色 / 布局预设 / 一体化图标配置 / 深度 tooltip 定制，依赖 echarts（peer）与 @snui/vue-web。",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./styles": "./dist/styles/index.css",
    "./styles/": "./dist/styles/",
    "./src/*.ts": "./src/*.ts",
    "./src/*.vue": "./src/*.vue"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.json --emitDeclarationOnly",
    "dev": "vite build --watch",
    "lint": "eslint src --ext .ts,.vue",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@snui/vue-web": "workspace:",
    "vue": "^3.5.43"
  },
  "peerDependencies": {
    "echarts": "^5.6.0 || ^6.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "echarts": "^5.6.0",
    "eslint": "^9.17.0",
    "happy-dom": "^15.11.7",
    "typescript": "^5.7.3",
    "vite": "^6.4.3",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
