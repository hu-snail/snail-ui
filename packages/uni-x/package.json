{
  "name": "@snui/uni-x",
  "version": "0.1.0",
  "private": true,
  "description": "AUI Uni-X — npm-ready uni-app x (vapor mode) artifacts of @snui/uni: .uvue components + theme, generated by a deterministic transform pipeline (see ADR-0004).",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./components/*": "./dist/components/*",
    "./theme/index.css": "./dist/theme/index.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node src/transform/cli.ts",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo coverage"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "postcss": "^8.5.28",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
