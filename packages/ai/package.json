{
  "name": "@snui/ai",
  "version": "0.1.0",
  "private": true,
  "description": "snail-aui AI Layer — Skill file (AI behavior contract), MCP Server stub, ai-meta.json aggregator. Per AUI-AI-001~003 / ADR-0002 / Spec-03.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./skill": {
      "types": "./dist/skill/skill.d.ts",
      "import": "./dist/skill/skill.js"
    },
    "./mcp": {
      "types": "./dist/mcp/server.d.ts",
      "import": "./dist/mcp/server.js"
    },
    "./meta": {
      "types": "./dist/meta/aggregator.d.ts",
      "import": "./dist/meta/aggregator.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@snui/cli": "workspace:",
    "@snui/style-packs": "workspace:",
    "@snui/tokens": "workspace:"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "eslint": "^9.17.0"
  }
}