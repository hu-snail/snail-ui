{
  "name": "@snui/vue-web",
  "version": "0.1.0",
  "private": true,
  "description": "AUI Vue Web — Web-end UI component library for Vue 3. API style inspired by naive-ui. Consumes tokens via @snui/tokens (--sn-* aliases).",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./resolver": {
      "types": "./dist/resolver.d.ts",
      "import": "./dist/resolver.js"
    },
    "./styles": "./dist/styles/index.css",
    "./styles/": "./dist/styles/"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vue-tsc -p tsconfig.json --emitDeclarationOnly false && node ./scripts/copy-styles.mjs",
    "dev": "vue-tsc -p tsconfig.json --watch --emitDeclarationOnly false",
    "lint": "eslint src --ext .ts,.vue",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@snui/tokens": "workspace:",
    "@snui/tokens-web": "workspace:",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.17.0",
    "happy-dom": "^15.11.7",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
