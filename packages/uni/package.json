{
  "name": "@snui/uni",
  "version": "0.1.0",
  "private": true,
  "description": "AUI Uni — uni-app multi-end UI component library. API style inspired by wot-ui. Easycom auto-registration. Cross-end (H5 / WeChat MP / Alipay MP / App).",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": "./dist/styles/index.css",
    "./components/*": "./src/components/*",
    "./src/*.ts": "./src/*.ts",
    "./src/*.vue": "./src/*.vue"
  },
  "files": [
    "src/components"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.json --emitDeclarationOnly && node ./scripts/copy-styles.mjs",
    "dev": "vite build --watch",
    "lint": "eslint src --ext .ts,.vue",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@snui/tokens": "workspace:",
    "@snui/tokens-mp": "workspace:",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.17.0",
    "happy-dom": "^15.11.7",
    "typescript": "^5.7.3",
    "vite": "^6.4.3",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  },
  "sideEffects": [
    "**/*.vue",
    "**/*.css"
  ]
}
