{
  "name": "snui",
  "version": "0.1.0",
  "private": true,
  "description": "AUI — AI-Friendly Multi-End UI Component Library. Vue 3 (web) + uni-app. Token-driven themes, real component rendering, AI-friendly docs. Replaces v1.x schema-driven runtime framework (see ADR-0001).",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:vue-web": "pnpm --filter @snui/vue-web dev",
    "dev:preview": "pnpm --filter @snui/preview dev",
    "dev:docs": "pnpm --filter @snui/docs dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,yaml,yml,vue}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,yaml,yml,vue}\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "lucide-vue-next": "^0.460.0"
  }
}
